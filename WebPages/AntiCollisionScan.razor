@page "/AntiCollisionScan"
@inject ILogger<AntiCollisionScan> Logger
@inject ISnackbar Snackbar
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData

<MudUnitAndReferenceChoiceTag @ref="unitReferenceTag_"
                              HttpHost="@Api.HostNameUnitConversion"
                              HttpBasePath="@Api.HostBasePathUnitConversion"
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName"
                              DepthReferenceName="@DataUtils.UnitAndReferenceParameters.DepthReferenceName"
                              DepthReferenceNameChanged="@DataUtils.UpdateDepthReferenceName"
                              GroundMudLineDepthReferenceSource="@DataUtils.GroundMudLineDepthReferenceSource"
                              MeanSeaLevelDepthReferenceSource="@DataUtils.MeanSeaLevelDepthReferenceSource"
                              SeaWaterLevelDepthReferenceSource="@DataUtils.SeaWaterLevelDepthReferenceSource"
                              RotaryTableDepthReferenceSource="@DataUtils.RotaryTableDepthReferenceSource"
                              PositionReferenceName="@DataUtils.UnitAndReferenceParameters.PositionReferenceName"
                              PositionReferenceNameChanged="@DataUtils.UpdatePositionReferenceName"
                              WellHeadPositionReferenceSource="@DataUtils.WellHeadPositionReferenceSource"
                              CartographicGridPositionReferenceSource="@DataUtils.CartographicGridPositionReferenceSource"
                              FieldPositionReferenceSource="@DataUtils.FieldPositionReferenceSource"
                              ClusterPositionReferenceSource="@DataUtils.ClusterPositionReferenceSource"
                              AzimuthReferenceName="@DataUtils.UnitAndReferenceParameters.AzimuthReferenceName"
                              AzimuthReferenceNameChanged="@DataUtils.UpdateAzimuthReferenceName"
                              GridConvergenceSource="@DataUtils.GridConvergenceSource"
                              MagneticDeclinationSource="@DataUtils.MagneticDeclinationSource">
    <MudText Typo="Typo.h5" Class="mt-4 mb-1">Anti-collision scan</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Find trajectories whose 99.9% uncertainty envelopes overlap the reference trajectory, then calculate separation factors only over relevant measured-depth ranges.
    </MudText>

    @if (isLoading_ && !isCalculating_ && !isScanning_)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage_))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@errorMessage_</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Reference trajectory</MudText>
        <TrajectoryResourceFilter Fields="@fields_" Clusters="@clusters_" Wells="@wells_" WellBores="@wellBores_" Trajectories="@trajectories_"
                                  ResourceKind="TrajectoryResourceFilterKind.Trajectory" CompletedTrajectoriesOnly="true"
                                  FieldId="@selectedFieldId_" FieldIdChanged="OnFieldChanged"
                                  ClusterId="@selectedClusterId_" ClusterIdChanged="OnClusterChanged"
                                  WellId="@selectedWellId_" WellIdChanged="OnWellChanged"
                                  WellBoreId="@selectedWellBoreId_" WellBoreIdChanged="OnWellBoreChanged"
                                  ResourceId="@selectedReferenceTrajectoryId_" ResourceIdChanged="OnReferenceTrajectoryChanged" />
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="4">
                <RigJobSelector WellBores="@wellBores_" Rigs="@rigs_" WellBoreId="@selectedWellBoreId_"
                                ReferenceDate="@referenceTrajectoryDate_" SelectedRigJobId="@selectedRigJobId_"
                                SelectedRigJobIdChanged="OnRigJobIdChanged" SelectionChanged="OnRigJobChanged" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudAutocomplete T="Guid?" Value="@selectedPolicyAssignmentId_" ValueChanged="OnPolicyAssignmentChanged"
                                 Label="Field anti-collision policy assignment" Placeholder="No anti-collision policy"
                                 SearchFunc="SearchPolicyAssignmentsAsync" ToStringFunc="GetPolicyAssignmentName"
                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" MinCharacters="0"
                                 Disabled="@(selectedFieldId_ == null)" ShrinkLabel />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />
        <MudGrid Class="align-center">
            <MudItem xs="12" sm="4" md="3">
                <MudCheckBox T="bool" Value="@includePlanned_" ValueChanged="@OnIncludePlannedChanged" Label="Include planned" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudCheckBox T="bool" Value="@includeActual_" ValueChanged="@OnIncludeActualChanged" Label="Include actual" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudCheckBox T="bool" Value="@definitiveOnly_" ValueChanged="@OnDefinitiveOnlyChanged" Label="Definitive only" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                           OnClick="@ScanAsync" Disabled="@(!CanScan)">
                    Scan
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!includePlanned_ && !includeActual_)
        {
            <MudText Typo="Typo.caption" Color="Color.Error">Select planned, actual, or both.</MudText>
        }
        @if (isScanning_)
        {
            <MudProgressLinear Value="@(scanProgress_ * 100.0)" Color="Color.Primary" Class="mt-3 mb-1" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @scanMessage_ (@scanProgress_.ToString("P0"))
            </MudText>
        }
    </MudPaper>

    @if (hasScanned_)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudToolBar Dense="true" Class="px-0">
                <MudText Typo="Typo.h6">Overlapping trajectories (@candidateTrajectories_.Count)</MudText>
                <MudSpacer />
                <div style="width: 190px; margin-left: 12px; margin-right: 12px;">
                    <MudInputWithUnitAdornment QuantityName="ProportionStandard" QuantityLabel="Confidence factor"
                                               SIValue="@confidenceFactor_" SIValueChanged="@OnConfidenceFactorChanged"
                                               ReadOnly="@(selectedPolicyAssignmentId_ != null)" Immediate="true" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Calculate"
                           OnClick="@CalculateAsync" Disabled="@(!CanCalculate)">
                    Calculate safety factors
                </MudButton>
            </MudToolBar>

            <MudText Typo="Typo.caption" Color="@(IsConfidenceFactorValid ? Color.Secondary : Color.Error)" Class="mb-2">
                @if (selectedPolicyAssignmentId_ == null)
                {
                    <span>The confidence factor must be greater than 0 and no greater than 99.9%, the confidence used by the octree scan.</span>
                }
                else
                {
                    <span>The confidence factor is defined by the selected anti-collision policy revision and is read-only.</span>
                }
            </MudText>

            @if (isCalculating_)
            {
                <MudProgressLinear Value="@(calculationProgress_ * 100.0)" Color="Color.Primary" Class="mb-1" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    @calculationMessage_ (@calculationProgress_.ToString("P0"))
                </MudText>
            }

            @if (candidateTrajectories_.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No indexed uncertainty envelopes overlap the reference trajectory for these filters.</MudAlert>
            }
            else
            {
                <MudTable Items="@candidateTrajectories_" T="TrajectoryLight" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>
                            <MudCheckBox T="bool" Value="@AllCandidatesSelected" ValueChanged="SetAllCandidatesSelected"
                                         Color="Color.Primary" Disabled="@(candidateTrajectories_.Count == 0)"
                                         AriaLabel="Select or clear all overlapping trajectories" />
                        </MudTh>
                        <MudTh>Trajectory</MudTh>
                        <MudTh>Cluster</MudTh>
                        <MudTh>Well</MudTh>
                        <MudTh>WellBore</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Definitive</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Selected">
                            <MudCheckBox T="bool" Value="@IsCandidateSelected(context)"
                                         ValueChanged="@((bool selected) => SetCandidateSelected(context, selected))"
                                         Color="Color.Primary" />
                        </MudTd>
                        <MudTd DataLabel="Trajectory">@context.Name</MudTd>
                        <MudTd DataLabel="Cluster">@GetClusterName(context)</MudTd>
                        <MudTd DataLabel="Well">@GetWellName(context)</MudTd>
                        <MudTd DataLabel="WellBore">@GetWellBoreName(context)</MudTd>
                        <MudTd DataLabel="Type">@context.TrajectoryType</MudTd>
                        <MudTd DataLabel="Definitive">@(context.IsDefinitive ? "Yes" : "No")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }

    @if (calculationResult_ != null)
    {
        @if (calculationResult_.PolicySnapshot != null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Applied policy <b>@calculationResult_.PolicySnapshot.Name</b>, revision @calculationResult_.PolicySnapshot.RevisionNumber,
                confidence @calculationResult_.PolicySnapshot.ConfidenceFactor.ToString("P1"), evaluated at @calculationResult_.PolicyEvaluationUtc?.ToString("u").
                The stored result contains the exact policy snapshot and Field assignment UUID.
            </MudAlert>
            <MudTable Items="@PolicyEvaluations" T="SeparationFactorResult" Dense="true" Hover="true" Bordered="true" Striped="true" Class="mb-4">
                <HeaderContent><MudTh>Comparison trajectory</MudTh><MudTh>Evaluation</MudTh><MudTh>Classification</MudTh><MudTh>Alert SF</MudTh><MudTh>Alarm SF</MudTh><MudTh>Rule priority</MudTh><MudTh>Reason</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@GetTrajectoryName(context.ComparisonTrajectoryID)</MudTd>
                    <MudTd>@context.PolicyEvaluation?.State</MudTd>
                    <MudTd>@context.PolicyEvaluation?.WorstClassification</MudTd>
                    <MudTd>@context.PolicyEvaluation?.AlertThreshold?.ToString("0.###")</MudTd>
                    <MudTd>@context.PolicyEvaluation?.AlarmThreshold?.ToString("0.###")</MudTd>
                    <MudTd>@context.PolicyEvaluation?.MatchedRulePriority</MudTd>
                    <MudTd>@context.PolicyEvaluation?.Message</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                No anti-collision policy was effective for the reference trajectory's Field at calculation time. Separation factors are shown without Alert/Alarm classification.
            </MudAlert>
        }
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudToolBar Dense="true" Class="px-0">
                <MudText Typo="Typo.h6">Separation factors</MudText>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="showAllReferenceDepths_" Color="Color.Primary"
                           Label="Show every reference survey depth" />
            </MudToolBar>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                @(showAllReferenceDepths_
                    ? "All reference survey depths are shown; a dash means no separation calculation was needed for that trajectory at that depth."
                    : "Only reference depths having at least one calculated comparison are shown.")
            </MudText>
            @if (calculationResult_.PolicySnapshot != null)
            {
                <MudText Typo="Typo.caption" Class="mb-3">
                    Color convention: <span style="color:#ed6c02;font-weight:700">orange</span> values exceed the Alert level;
                    <span style="color:#d32f2f;font-weight:700">red</span> values exceed the Alarm level.
                </MudText>
            }

            @if (resultTrajectoryIds_.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">The selected candidates produced no relevant separation-factor intervals.</MudAlert>
            }
            else
            {
                <MudTable Items="@DisplayedTableRows" T="SafetyFactorTableRow" Height="420px" FixedHeader="true"
                          Virtualize="true" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Reference MD [@MeasuredDepthUnitLabel]</MudTh>
                        @foreach (Guid trajectoryId in resultTrajectoryIds_)
                        {
                            <MudTh>@GetTrajectoryName(trajectoryId)</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Reference MD">@FormatMeasuredDepth(context.ReferenceMD)</MudTd>
                        @foreach (Guid trajectoryId in resultTrajectoryIds_)
                        {
                            <MudTd DataLabel="@GetTrajectoryName(trajectoryId)">
                                <span style="@GetSafetyFactorStyle(context, trajectoryId)">@FormatSafetyFactor(context, trajectoryId)</span>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        @if (plotSeries_.Count > 0)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-6">
                <MudToolBar Dense="true" Class="px-0">
                    <MudText Typo="Typo.h6">Separation-factor profiles</MudText>
                    <MudSpacer />
                    <MudSwitch T="bool" @bind-Value="showWholeTrajectoryOnGraph_" Color="Color.Primary"
                               Label="Show whole reference trajectory" />
                </MudToolBar>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    @(showWholeTrajectoryOnGraph_
                        ? "The depth axis covers the complete reference trajectory."
                        : "The depth axis covers the union of all calculated separation intervals.")
                    Reference measured depth increases downward. Click a legend entry to show or hide every calculated interval for that trajectory.
                </MudText>
                @if (calculationResult_.PolicySnapshot != null)
                {
                    <MudText Typo="Typo.caption" Class="mb-3">
                        Profile convention:
                        <span style="display:inline-block;width:32px;border-top:2px dashed currentColor;vertical-align:middle"></span> no level exceeded;
                        <span style="display:inline-block;width:32px;border-top:2px solid currentColor;vertical-align:middle"></span> Alert level exceeded;
                        <span style="display:inline-block;width:32px;border-top:5px solid currentColor;vertical-align:middle"></span> Alarm level exceeded.
                    </MudText>
                }
                <ScatterPlot NameList="@PlotNames" ModeFlagList="@PlotModes" ColorList="@PlotColors"
                             LineDashList="@PlotLineDashes" LineWidthList="@PlotLineWidths"
                             ShowLegendList="@PlotShowLegend" LegendGroupList="@PlotLegendGroups" ToggleLegendGroups="true"
                             XValuesList="@PlotSafetyFactors" YValuesList="@PlotReferenceDepths"
                             PlotHeight="700"
                             XAxisTitle="Separation factor" YAxisTitle="Reference MD"
                             XUnit="DimensionLessStandard" YUnit="DepthDrilling"
                             YAxisMinimum="@GraphMinimumReferenceDepth" YAxisMaximum="@GraphMaximumReferenceDepth"
                             XAxisStartsAtZero="true" YAxisUsesDepthReference="true" YAxisReversed="true" />
            </MudPaper>
        }
    }
</MudUnitAndReferenceChoiceTag>

@code {
    private static readonly string[] PlotPalette =
        ["#1769aa", "#c23b22", "#4f7d20", "#7b3f98", "#bf7f00", "#00838f", "#8d5a3b", "#455a64"];
    private const double DefaultConfidenceFactor = 0.95;
    private const double MaximumConfidenceFactor = 0.999;
    private const int MdPrecision = 6;

    private MudUnitAndReferenceChoiceTag? unitReferenceTag_;
    private List<Field> fields_ = [];
    private List<Cluster> clusters_ = [];
    private List<Well> wells_ = [];
    private List<WellBore> wellBores_ = [];
    private List<Rig> rigs_ = [];
    private List<TrajectoryLight> trajectories_ = [];
    private List<SurveyRunLight> surveyRuns_ = [];
    private List<AntiCollisionPolicyRevision> policyRevisions_ = [];
    private List<FieldAntiCollisionPolicyAssignment> policyAssignments_ = [];
    private List<TrajectoryLight> candidateTrajectories_ = [];
    private readonly HashSet<Guid> selectedCandidateIds_ = [];
    private List<Guid> resultTrajectoryIds_ = [];
    private List<SafetyFactorTableRow> allTableRows_ = [];
    private List<SafetyFactorTableRow> condensedTableRows_ = [];
    private List<SafetyFactorPlotSeries> plotSeries_ = [];
    private Dictionary<Guid, AntiCollisionPolicyEvaluation?> policyEvaluationsByTrajectory_ = [];
    private Trajectory? referenceTrajectory_;
    private GlobalAntiCollision? calculationResult_;
    private IEnumerable<SeparationFactorResult> PolicyEvaluations => calculationResult_?.SeparationFactorResults ?? [];
    private Guid? selectedFieldId_;
    private Guid? selectedClusterId_;
    private Guid? selectedWellId_;
    private Guid? selectedWellBoreId_;
    private Guid? selectedReferenceTrajectoryId_;
    private Guid? selectedRigJobId_;
    private Guid? selectedPolicyAssignmentId_;
    private DateTimeOffset? referenceTrajectoryDate_;
    private bool includePlanned_ = true;
    private bool includeActual_ = true;
    private bool definitiveOnly_ = true;
    private bool showAllReferenceDepths_;
    private bool showWholeTrajectoryOnGraph_;
    private double confidenceFactor_ = DefaultConfidenceFactor;
    private double manualConfidenceFactor_ = DefaultConfidenceFactor;
    private bool isLoading_;
    private bool isScanning_;
    private bool isCalculating_;
    private bool hasScanned_;
    private double calculationProgress_;
    private string calculationMessage_ = string.Empty;
    private double scanProgress_;
    private string scanMessage_ = string.Empty;
    private string? errorMessage_;

    private bool CanScan => !isLoading_ && selectedReferenceTrajectoryId_.HasValue && (includePlanned_ || includeActual_);
    private bool IsConfidenceFactorValid => double.IsFinite(confidenceFactor_) &&
        confidenceFactor_ > 0.0 && confidenceFactor_ <= MaximumConfidenceFactor;
    private bool CanCalculate => !isLoading_ && selectedCandidateIds_.Count > 0 && IsConfidenceFactorValid;
    private IReadOnlyList<SafetyFactorTableRow> DisplayedTableRows => showAllReferenceDepths_ ? allTableRows_ : condensedTableRows_;
    private string MeasuredDepthUnitLabel => unitReferenceTag_?.GetDepthUnitLabel("DepthDrilling") ?? "m";
    private List<string> PlotNames => plotSeries_.Select(series => series.Name).ToList();
    private List<int> PlotModes => plotSeries_.Select(_ => 1).ToList();
    private List<string> PlotColors => plotSeries_.Select(series => series.Color).ToList();
    private List<string> PlotLineDashes => plotSeries_.Select(series => series.LineDash).ToList();
    private List<decimal?> PlotLineWidths => plotSeries_.Select(series => (decimal?)series.LineWidth).ToList();
    private List<bool> PlotShowLegend => plotSeries_.Select(series => series.ShowLegend).ToList();
    private List<string> PlotLegendGroups => plotSeries_.Select(series => series.TrajectoryID.ToString()).ToList();
    private List<List<object>> PlotSafetyFactors => plotSeries_.Select(series => series.Points.Select(point => (object)point.SafetyFactor).ToList()).ToList();
    private List<List<object>> PlotReferenceDepths => plotSeries_.Select(series => series.Points.Select(point => (object)point.ReferenceMD).ToList()).ToList();
    private double? GraphMinimumReferenceDepth => GetGraphReferenceDepthBound(useMinimum: true);
    private double? GraphMaximumReferenceDepth => GetGraphReferenceDepthBound(useMinimum: false);

    private double? GetGraphReferenceDepthBound(bool useMinimum)
    {
        IEnumerable<double> depths = showWholeTrajectoryOnGraph_
            ? allTableRows_.Select(row => row.ReferenceMD)
            : plotSeries_.SelectMany(series => series.Points).Select(point => point.ReferenceMD);
        List<double> finiteDepths = depths.Where(double.IsFinite).ToList();
        return finiteDepths.Count == 0
            ? null
            : useMinimum ? finiteDepths.Min() : finiteDepths.Max();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading_ = true;
        errorMessage_ = null;
        try
        {
            Task<List<TrajectoryLight>> trajectoryTask = Api.ClientTrajectory.GetAllTrajectoryLightAsync();
            Task<TrajectoryReferenceDataSnapshot> referenceDataTask = ReferenceData.GetSnapshotAsync();
            Task<List<SurveyRunLight>> surveyRunTask = Api.ClientTrajectory.GetAllSurveyRunLightAsync();
            Task<List<AntiCollisionPolicyRevision>> policyRevisionTask = Api.ClientTrajectory.GetAllAntiCollisionPolicyRevisionAsync();
            Task<List<FieldAntiCollisionPolicyAssignment>> policyAssignmentTask = Api.ClientTrajectory.GetAllFieldAntiCollisionPolicyAssignmentAsync();
            await Task.WhenAll(trajectoryTask, referenceDataTask, surveyRunTask, policyRevisionTask, policyAssignmentTask);

            TrajectoryReferenceDataSnapshot referenceData = await referenceDataTask;
            fields_ = referenceData.Fields.ToList();
            clusters_ = referenceData.Clusters.ToList();
            wells_ = referenceData.Wells.ToList();
            wellBores_ = referenceData.WellBores.ToList();
            trajectories_ = (await trajectoryTask).OrderBy(item => item.Name).ToList();
            surveyRuns_ = (await surveyRunTask).OrderBy(item => item.Name).ToList();
            policyRevisions_ = await policyRevisionTask;
            policyAssignments_ = await policyAssignmentTask;
            rigs_ = referenceData.Rigs.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load anti-collision scan context");
            errorMessage_ = "Unable to load the trajectory and contextual data required for an anti-collision scan.";
        }
        finally
        {
            isLoading_ = false;
        }
    }

    private Task OnFieldChanged(Guid? value)
    {
        selectedFieldId_ = value;
        selectedClusterId_ = null;
        selectedWellId_ = null;
        selectedWellBoreId_ = null;
        selectedReferenceTrajectoryId_ = null;
        selectedRigJobId_ = null;
        referenceTrajectoryDate_ = null;
        SelectDefaultPolicyAssignment();
        ResetScan();
        return Task.CompletedTask;
    }

    private Task OnClusterChanged(Guid? value)
    {
        selectedClusterId_ = value;
        selectedWellId_ = null;
        selectedWellBoreId_ = null;
        selectedReferenceTrajectoryId_ = null;
        selectedRigJobId_ = null;
        referenceTrajectoryDate_ = null;
        ResetScan();
        return Task.CompletedTask;
    }

    private Task OnWellChanged(Guid? value)
    {
        selectedWellId_ = value;
        selectedWellBoreId_ = null;
        selectedReferenceTrajectoryId_ = null;
        selectedRigJobId_ = null;
        referenceTrajectoryDate_ = null;
        if (value is Guid wellId && FindWell(wellId) is Well well)
        {
            selectedClusterId_ = well.IsSingleWell ? null : well.ClusterID;
            selectedFieldId_ ??= FindFieldId(well);
        }
        SelectDefaultPolicyAssignment();
        ResetScan();
        return Task.CompletedTask;
    }

    private Task OnWellBoreChanged(Guid? value)
    {
        selectedWellBoreId_ = value;
        selectedReferenceTrajectoryId_ = null;
        selectedRigJobId_ = null;
        referenceTrajectoryDate_ = null;
        ResetScan();
        return Task.CompletedTask;
    }

    private async Task OnReferenceTrajectoryChanged(Guid? value)
    {
        selectedReferenceTrajectoryId_ = value;
        referenceTrajectoryDate_ = await ResolveTrajectoryDateAsync(value);
        selectedRigJobId_ = null;
        ResetScan();
        DataUtils.ApplyTrajectoryReferenceValues(value, trajectories_, wellBores_, wells_, clusters_, rigs_, fields_,
            selectedRigJobId_, referenceTrajectoryDate_);
        await CartographicPositionReferenceUtils.ApplyForTrajectoryAsync(Api, value, trajectories_, clusters_, fields_, Logger);
        try
        {
            TrajectoryReferenceDatumUtils.Apply(
                await TrajectoryReferenceDatumUtils.ResolveForTrajectoryAsync(Api, value, trajectories_, wellBores_, wells_, clusters_));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Optional reference-datum lookup failed for anti-collision trajectory {TrajectoryId}", value);
        }
    }

    private Task OnRigJobIdChanged(Guid? id)
    {
        selectedRigJobId_ = id;
        return Task.CompletedTask;
    }

    private async Task OnRigJobChanged(RigJob? _)
    {
        DataUtils.ApplyTrajectoryReferenceValues(selectedReferenceTrajectoryId_, trajectories_, wellBores_, wells_, clusters_, rigs_, fields_,
            selectedRigJobId_, referenceTrajectoryDate_);
        await InvokeAsync(StateHasChanged);
    }

    private Task<DateTimeOffset?> ResolveTrajectoryDateAsync(Guid? trajectoryId) =>
        TrajectoryRigJobDateResolver.ResolveAsync(Api, trajectoryId, trajectories_, surveyRuns_, Logger);

    private IEnumerable<FieldAntiCollisionPolicyAssignment> AssignmentsForSelectedField => selectedFieldId_ is Guid fieldId
        ? policyAssignments_.Where(assignment => assignment.FieldID == fieldId).OrderByDescending(assignment => assignment.ValidFromUtc)
        : [];

    private Task<IEnumerable<Guid?>> SearchPolicyAssignmentsAsync(string? text, CancellationToken _)
    {
        string? term = text?.Trim();
        return Task.FromResult(AssignmentsForSelectedField
            .Where(assignment => assignment.MetaInfo != null &&
                (string.IsNullOrEmpty(term) || GetPolicyAssignmentName(assignment.MetaInfo.ID).Contains(term, StringComparison.OrdinalIgnoreCase)))
            .Select(assignment => (Guid?)assignment.MetaInfo!.ID));
    }

    private string GetPolicyAssignmentName(Guid? id)
    {
        if (id is not Guid assignmentId) return string.Empty;
        FieldAntiCollisionPolicyAssignment? assignment = policyAssignments_.FirstOrDefault(item => item.MetaInfo?.ID == assignmentId);
        AntiCollisionPolicyRevision? revision = assignment == null
            ? null
            : policyRevisions_.FirstOrDefault(item => item.MetaInfo?.ID == assignment.PolicyRevisionID);
        if (assignment == null || revision == null) return "Unavailable policy assignment";
        string validTo = assignment.ValidToUtc?.ToString("yyyy-MM-dd") ?? "open";
        return $"{revision.Name} · revision {revision.RevisionNumber} · {assignment.ValidFromUtc:yyyy-MM-dd} to {validTo}";
    }

    private void SelectDefaultPolicyAssignment()
    {
        DateTimeOffset now = DateTimeOffset.UtcNow;
        selectedPolicyAssignmentId_ = AssignmentsForSelectedField.FirstOrDefault(assignment =>
            assignment.ValidFromUtc <= now && (!assignment.ValidToUtc.HasValue || now < assignment.ValidToUtc.Value))?.MetaInfo?.ID;
        ApplySelectedPolicyConfidence();
    }

    private void OnPolicyAssignmentChanged(Guid? id)
    {
        selectedPolicyAssignmentId_ = id;
        ApplySelectedPolicyConfidence();
        ResetResults();
    }

    private void ApplySelectedPolicyConfidence()
    {
        FieldAntiCollisionPolicyAssignment? assignment = selectedPolicyAssignmentId_ is Guid assignmentId
            ? policyAssignments_.FirstOrDefault(item => item.MetaInfo?.ID == assignmentId && item.FieldID == selectedFieldId_)
            : null;
        AntiCollisionPolicyRevision? revision = assignment == null
            ? null
            : policyRevisions_.FirstOrDefault(item => item.MetaInfo?.ID == assignment.PolicyRevisionID);
        if (revision != null) confidenceFactor_ = revision.ConfidenceFactor;
        else
        {
            selectedPolicyAssignmentId_ = null;
            confidenceFactor_ = manualConfidenceFactor_;
        }
    }

    private void OnIncludePlannedChanged(bool value)
    {
        includePlanned_ = value;
        ResetScan();
    }

    private void OnIncludeActualChanged(bool value)
    {
        includeActual_ = value;
        ResetScan();
    }

    private void OnDefinitiveOnlyChanged(bool value)
    {
        definitiveOnly_ = value;
        ResetScan();
    }

    private async Task ScanAsync()
    {
        if (!CanScan || selectedReferenceTrajectoryId_ is not Guid referenceId)
        {
            return;
        }

        isLoading_ = true;
        errorMessage_ = null;
        ResetResults();
        Guid? searchJobId = null;
        bool cleanupSearchJob = false;
        try
        {
            var request = new OctreeSearchJobRequest
            {
                ReferenceTrajectoryID = referenceId,
                IncludePlanned = includePlanned_,
                IncludeActual = includeActual_,
                DefinitiveOnly = definitiveOnly_
            };
            OctreeSearchJobStatus status = await Api.ClientTrajectory.QueueOctreeSearchAsync(request);
            searchJobId = status.JobID;
            isScanning_ = true;
            UpdateScanProgress(status);

            int consecutivePollingFailures = 0;
            while (status.CalculationState is CalculationState.Queued or CalculationState.Running)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                try
                {
                    status = await Api.ClientTrajectory.GetOctreeSearchStatusAsync(searchJobId.Value);
                    consecutivePollingFailures = 0;
                    UpdateScanProgress(status);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (++consecutivePollingFailures < 5)
                {
                    Logger.LogWarning(ex,
                        "Transient failure while polling octree search {SearchJobId} ({FailureCount}/5)",
                        searchJobId, consecutivePollingFailures);
                    scanMessage_ = "Waiting for a progress update";
                    await InvokeAsync(StateHasChanged);
                }
            }

            cleanupSearchJob = true;
            if (status.CalculationState == CalculationState.Failed)
            {
                errorMessage_ = status.CalculationMessage ?? "The octree anti-collision scan failed.";
                return;
            }

            OctreeSearchJobResult result = await Api.ClientTrajectory.GetOctreeSearchResultAsync(searchJobId.Value);
            HashSet<Guid> candidates = [.. result.CandidateTrajectoryIDs];
            candidateTrajectories_ = trajectories_
                .Where(item => item.MetaInfo?.ID is Guid id && candidates.Contains(id))
                .OrderBy(item => item.Name)
                .ToList();
            selectedCandidateIds_.Clear();
            selectedCandidateIds_.UnionWith(candidateTrajectories_.Select(item => item.MetaInfo.ID));
            hasScanned_ = true;
        }
        catch (ApiException ex)
        {
            Logger.LogError(ex, "Octree scan failed for trajectory {TrajectoryId}", referenceId);
            errorMessage_ = ex.StatusCode == 409
                ? "The reference trajectory's spatial index is missing or stale. Save or recalculate the trajectory and try again."
                : "The octree anti-collision scan failed.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Octree scan failed for trajectory {TrajectoryId}", referenceId);
            errorMessage_ = "The octree anti-collision scan failed.";
        }
        finally
        {
            if (searchJobId.HasValue && cleanupSearchJob)
            {
                try
                {
                    await Api.ClientTrajectory.DeleteOctreeSearchAsync(searchJobId.Value);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Unable to remove transient octree search {SearchJobId}", searchJobId);
                }
            }
            isScanning_ = false;
            scanProgress_ = 0.0;
            scanMessage_ = string.Empty;
            isLoading_ = false;
        }
    }

    private void UpdateScanProgress(OctreeSearchJobStatus status)
    {
        scanProgress_ = Math.Clamp(status.CalculationProgress, 0.0, 1.0);
        scanMessage_ = status.CalculationMessage ?? status.CalculationState switch
        {
            CalculationState.Queued => "Octree scan queued",
            CalculationState.Running => "Searching octree indexes",
            CalculationState.Completed => "Octree scan completed",
            CalculationState.Failed => "Octree scan failed",
            _ => "Searching octree indexes"
        };
    }

    private async Task CalculateAsync()
    {
        if (!CanCalculate || selectedReferenceTrajectoryId_ is not Guid referenceId)
        {
            return;
        }

        isLoading_ = true;
        errorMessage_ = null;
        string calculationId = $"web-scan-{Guid.NewGuid():N}";
        bool created = false;
        bool cleanupCalculation = false;
        try
        {
            referenceTrajectory_ = await Api.ClientTrajectory.GetTrajectoryByIdAsync(referenceId, true);
            var request = new GlobalAntiCollision
            {
                ID = calculationId,
                ConfidenceFactor = confidenceFactor_,
                RequestedPolicyAssignmentID = selectedPolicyAssignmentId_,
                ReferenceTrajectoryID = referenceId,
                ReferenceWellPathID = Guid.Empty,
                ComparisonTrajectoryIDs = selectedCandidateIds_.OrderBy(id => id).ToList(),
                SeparationFactorResults = []
            };
            calculationResult_ = await Api.ClientTrajectory.GlobalAntiCollisionsPOSTAsync(request);
            created = true;
            isCalculating_ = true;
            UpdateCalculationProgress(calculationResult_);
            GlobalAntiCollisionCalculationStatus status = new()
            {
                ID = calculationId,
                CalculationState = calculationResult_.CalculationState,
                CalculationProgress = calculationResult_.CalculationProgress,
                CalculationMessage = calculationResult_.CalculationMessage
            };

            int consecutivePollingFailures = 0;
            while (status.CalculationState is GlobalAntiCollisionCalculationState.Queued or GlobalAntiCollisionCalculationState.Running)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                try
                {
                    status = await Api.ClientTrajectory.StatusAsync(calculationId);
                    consecutivePollingFailures = 0;
                    UpdateCalculationProgress(status);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (++consecutivePollingFailures < 5)
                {
                    Logger.LogWarning(ex,
                        "Transient failure while polling anti-collision calculation {CalculationId} ({FailureCount}/5)",
                        calculationId, consecutivePollingFailures);
                    calculationMessage_ = "Waiting for a progress update";
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (status.CalculationState == GlobalAntiCollisionCalculationState.Failed)
            {
                cleanupCalculation = true;
                errorMessage_ = status.CalculationMessage ?? "The separation-factor calculation failed.";
                calculationResult_ = null;
                return;
            }

            calculationResult_ = await Api.ClientTrajectory.GlobalAntiCollisionsGETAsync(calculationId);
            cleanupCalculation = true;
            BuildPresentationData();
            if ((calculationResult_.SeparationFactorResults?.Count ?? 0) < selectedCandidateIds_.Count)
            {
                Snackbar.Add("Some selected trajectories had no relevant separation-factor interval.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Separation-factor calculation failed for trajectory {TrajectoryId}", referenceId);
            errorMessage_ = "The separation-factor calculation failed.";
            ResetResults();
        }
        finally
        {
            if (created && cleanupCalculation)
            {
                try
                {
                    await Api.ClientTrajectory.GlobalAntiCollisionsDELETEAsync(calculationId);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Unable to remove transient anti-collision calculation {CalculationId}", calculationId);
                }
            }
            isCalculating_ = false;
            calculationProgress_ = 0.0;
            calculationMessage_ = string.Empty;
            isLoading_ = false;
        }
    }

    private void UpdateCalculationProgress(GlobalAntiCollision calculation)
    {
        calculationProgress_ = Math.Clamp(calculation.CalculationProgress, 0.0, 1.0);
        calculationMessage_ = calculation.CalculationMessage ?? calculation.CalculationState switch
        {
            GlobalAntiCollisionCalculationState.Queued => "Calculation queued",
            GlobalAntiCollisionCalculationState.Running => "Calculating separation factors",
            GlobalAntiCollisionCalculationState.Completed => "Calculation completed",
            GlobalAntiCollisionCalculationState.Failed => "Calculation failed",
            _ => "Calculating separation factors"
        };
    }

    private void UpdateCalculationProgress(GlobalAntiCollisionCalculationStatus status)
    {
        calculationProgress_ = Math.Clamp(status.CalculationProgress, 0.0, 1.0);
        calculationMessage_ = status.CalculationMessage ?? status.CalculationState switch
        {
            GlobalAntiCollisionCalculationState.Queued => "Calculation queued",
            GlobalAntiCollisionCalculationState.Running => "Calculating separation factors",
            GlobalAntiCollisionCalculationState.Completed => "Calculation completed",
            GlobalAntiCollisionCalculationState.Failed => "Calculation failed",
            _ => "Calculating separation factors"
        };
    }

    private void BuildPresentationData()
    {
        List<SeparationFactorResult> results = calculationResult_?.SeparationFactorResults ?? [];
        resultTrajectoryIds_ = results.Select(result => result.ComparisonTrajectoryID).Distinct().OrderBy(GetTrajectoryName).ToList();

        Dictionary<Guid, Dictionary<double, double>> factors = [];
        foreach (SeparationFactorResult result in results)
        {
            Dictionary<double, double> byDepth = [];
            foreach (SeparationFactorPoint point in result.SeparationFactorProfile ?? [])
            {
                // The calculation engine uses a negative comparison MD for reference samples at
                // which no comparison candidate exists. Those samples remain empty in the full
                // table and delimit independent plotted intervals.
                if (!double.IsFinite(point.ReferenceMD) || !double.IsFinite(point.ComparisonMD) ||
                    point.ComparisonMD < 0 || !double.IsFinite(point.SeparationFactor))
                {
                    continue;
                }
                double key = DepthKey(point.ReferenceMD);
                if (!byDepth.TryGetValue(key, out double current) || point.SeparationFactor < current)
                {
                    byDepth[key] = point.SeparationFactor;
                }
            }
            factors[result.ComparisonTrajectoryID] = byDepth;
        }

        List<double> allDepths = referenceTrajectory_?.SurveyStationList?
            .Where(station => station.MD.HasValue && double.IsFinite(station.MD.Value))
            .Select(station => DepthKey(station.MD!.Value))
            .Distinct().OrderBy(value => value).ToList() ?? [];
        List<double> calculatedDepths = factors.Values.SelectMany(values => values.Keys).Distinct().OrderBy(value => value).ToList();
        allTableRows_ = CreateTableRows(allDepths, factors);
        condensedTableRows_ = CreateTableRows(calculatedDepths, factors);
        policyEvaluationsByTrajectory_ = results
            .GroupBy(result => result.ComparisonTrajectoryID)
            .ToDictionary(group => group.Key, group => (AntiCollisionPolicyEvaluation?)group.First().PolicyEvaluation);
        plotSeries_ = CreatePlotSeries(factors, policyEvaluationsByTrajectory_);
    }

    private List<SafetyFactorTableRow> CreateTableRows(IEnumerable<double> depths,
        IReadOnlyDictionary<Guid, Dictionary<double, double>> factors)
    {
        return depths.Select(depth => new SafetyFactorTableRow
        {
            ReferenceMD = depth,
            Values = resultTrajectoryIds_.ToDictionary(
                id => id,
                id => factors.TryGetValue(id, out Dictionary<double, double>? values) && values.TryGetValue(depth, out double value)
                    ? (double?)value
                    : null)
        }).ToList();
    }

    private List<SafetyFactorPlotSeries> CreatePlotSeries(
        IReadOnlyDictionary<Guid, Dictionary<double, double>> factors,
        IReadOnlyDictionary<Guid, AntiCollisionPolicyEvaluation?> evaluations)
    {
        var series = new List<SafetyFactorPlotSeries>();
        for (int trajectoryIndex = 0; trajectoryIndex < resultTrajectoryIds_.Count; trajectoryIndex++)
        {
            Guid trajectoryId = resultTrajectoryIds_[trajectoryIndex];
            if (!factors.TryGetValue(trajectoryId, out Dictionary<double, double>? values) || values.Count == 0)
            {
                continue;
            }

            double splitThreshold = CalculateSplitThreshold(values.Keys.OrderBy(value => value).ToList());
            List<SafetyFactorPlotPoint> currentRun = [];
            bool showLegend = true;
            double? previousDepth = null;
            evaluations.TryGetValue(trajectoryId, out AntiCollisionPolicyEvaluation? evaluation);
            foreach ((double depth, double safetyFactor) in values.OrderBy(entry => entry.Key))
            {
                bool gap = previousDepth.HasValue && depth - previousDepth.Value > splitThreshold;
                if (gap)
                {
                    AddClassifiedRun(series, trajectoryId, trajectoryIndex, currentRun, evaluation, ref showLegend);
                    currentRun = [];
                }
                currentRun.Add(new SafetyFactorPlotPoint(depth, safetyFactor));
                previousDepth = depth;
            }
            AddClassifiedRun(series, trajectoryId, trajectoryIndex, currentRun, evaluation, ref showLegend);
        }
        return series;
    }

    private void AddClassifiedRun(List<SafetyFactorPlotSeries> target, Guid trajectoryId, int trajectoryIndex,
        List<SafetyFactorPlotPoint> run, AntiCollisionPolicyEvaluation? evaluation, ref bool showLegend)
    {
        if (run.Count == 0) return;
        if (run.Count == 1)
        {
            AddPlotSeries(target, trajectoryId, trajectoryIndex, run, Classify(run[0].SafetyFactor, evaluation), showLegend);
            showLegend = false;
            return;
        }

        List<SafetyFactorPlotPoint> current = [];
        ProfileClassification? currentClassification = null;
        for (int index = 1; index < run.Count; index++)
        {
            SafetyFactorPlotPoint left = run[index - 1];
            SafetyFactorPlotPoint right = run[index];
            List<SafetyFactorPlotPoint> interval = InterpolateThresholdCrossings(left, right, evaluation);
            for (int pointIndex = 1; pointIndex < interval.Count; pointIndex++)
            {
                SafetyFactorPlotPoint intervalStart = interval[pointIndex - 1];
                SafetyFactorPlotPoint intervalEnd = interval[pointIndex];
                ProfileClassification classification = Classify(
                    0.5 * (intervalStart.SafetyFactor + intervalEnd.SafetyFactor), evaluation);
                if (currentClassification != classification)
                {
                    if (current.Count > 1)
                    {
                        AddPlotSeries(target, trajectoryId, trajectoryIndex, current, currentClassification!.Value, showLegend);
                        showLegend = false;
                    }
                    current = [intervalStart];
                    currentClassification = classification;
                }
                if (current.Count == 0 || current[^1] != intervalEnd) current.Add(intervalEnd);
            }
        }
        if (current.Count > 0 && currentClassification.HasValue)
        {
            AddPlotSeries(target, trajectoryId, trajectoryIndex, current, currentClassification.Value, showLegend);
            showLegend = false;
        }
    }

    private static List<SafetyFactorPlotPoint> InterpolateThresholdCrossings(SafetyFactorPlotPoint left,
        SafetyFactorPlotPoint right, AntiCollisionPolicyEvaluation? evaluation)
    {
        var points = new List<(double Fraction, SafetyFactorPlotPoint Point)> { (0.0, left), (1.0, right) };
        if (evaluation?.State == AntiCollisionPolicyEvaluationState.Matched &&
            evaluation.AlertThreshold is double alert && evaluation.AlarmThreshold is double alarm)
        {
            double delta = right.SafetyFactor - left.SafetyFactor;
            if (Math.Abs(delta) > 1e-12)
            {
                foreach (double threshold in new[] { alarm, alert }.Distinct())
                {
                    double fraction = (threshold - left.SafetyFactor) / delta;
                    if (fraction > 1e-12 && fraction < 1.0 - 1e-12)
                    {
                        points.Add((fraction, new SafetyFactorPlotPoint(
                            left.ReferenceMD + fraction * (right.ReferenceMD - left.ReferenceMD), threshold)));
                    }
                }
            }
        }
        return points.OrderBy(point => point.Fraction).Select(point => point.Point).ToList();
    }

    private void AddPlotSeries(List<SafetyFactorPlotSeries> target, Guid trajectoryId, int trajectoryIndex,
        List<SafetyFactorPlotPoint> points, ProfileClassification classification, bool showLegend)
    {
        if (points.Count == 0)
        {
            return;
        }
        target.Add(new SafetyFactorPlotSeries(
            trajectoryId,
            GetTrajectoryName(trajectoryId),
            PlotPalette[trajectoryIndex % PlotPalette.Length],
            showLegend,
            classification == ProfileClassification.Normal ? "dash" : "solid",
            classification == ProfileClassification.Alarm ? 5m : 2m,
            points));
    }

    private static ProfileClassification Classify(double value, AntiCollisionPolicyEvaluation? evaluation)
    {
        if (evaluation?.State != AntiCollisionPolicyEvaluationState.Matched ||
            evaluation.AlertThreshold is not double alert || evaluation.AlarmThreshold is not double alarm)
            return ProfileClassification.Unclassified;
        if (value < alarm) return ProfileClassification.Alarm;
        if (value < alert) return ProfileClassification.Alert;
        return ProfileClassification.Normal;
    }

    private static double CalculateSplitThreshold(IReadOnlyList<double> referenceDepths)
    {
        List<double> steps = referenceDepths.Zip(referenceDepths.Skip(1), (left, right) => right - left)
            .Where(step => step > 1e-6 && double.IsFinite(step)).OrderBy(step => step).ToList();
        if (steps.Count == 0)
        {
            return double.PositiveInfinity;
        }
        return 1.5 * steps[steps.Count / 2];
    }

    private void ResetScan()
    {
        hasScanned_ = false;
        candidateTrajectories_ = [];
        selectedCandidateIds_.Clear();
        ResetResults();
    }

    private void ResetResults()
    {
        calculationResult_ = null;
        referenceTrajectory_ = null;
        resultTrajectoryIds_ = [];
        allTableRows_ = [];
        condensedTableRows_ = [];
        plotSeries_ = [];
        policyEvaluationsByTrajectory_ = [];
    }

    private bool AllCandidatesSelected => candidateTrajectories_.Count > 0 &&
        candidateTrajectories_.All(item => selectedCandidateIds_.Contains(item.MetaInfo.ID));
    private void SetAllCandidatesSelected(bool selected)
    {
        if (selected) selectedCandidateIds_.UnionWith(candidateTrajectories_.Select(item => item.MetaInfo.ID));
        else selectedCandidateIds_.Clear();
        ResetResults();
    }

    private void OnConfidenceFactorChanged(double value)
    {
        confidenceFactor_ = value;
        if (selectedPolicyAssignmentId_ == null) manualConfidenceFactor_ = value;
        ResetResults();
    }

    private bool IsCandidateSelected(TrajectoryLight trajectory) => trajectory.MetaInfo?.ID is Guid id && selectedCandidateIds_.Contains(id);
    private void SetCandidateSelected(TrajectoryLight trajectory, bool selected)
    {
        if (trajectory.MetaInfo?.ID is not Guid id)
        {
            return;
        }
        if (selected) selectedCandidateIds_.Add(id);
        else selectedCandidateIds_.Remove(id);
        ResetResults();
    }

    private bool MatchesSelectedField(Well well) => selectedFieldId_ == null ||
        (well.IsSingleWell ? well.ClusterID == selectedFieldId_ : well.ClusterID is Guid clusterId && FindCluster(clusterId)?.FieldID == selectedFieldId_);
    private bool MatchesSelectedField(TrajectoryLight trajectory) => selectedFieldId_ == null || trajectory.FieldID == selectedFieldId_ ||
        trajectory.WellID is Guid wellId && FindWell(wellId) is Well well && MatchesSelectedField(well);
    private Guid? FindFieldId(Well well) => well.IsSingleWell ? well.ClusterID : well.ClusterID is Guid clusterId ? FindCluster(clusterId)?.FieldID : null;
    private Field? FindField(Guid id) => fields_.FirstOrDefault(item => item.MetaInfo?.ID == id);
    private Cluster? FindCluster(Guid id) => clusters_.FirstOrDefault(item => item.MetaInfo?.ID == id);
    private Well? FindWell(Guid id) => wells_.FirstOrDefault(item => item.MetaInfo?.ID == id);
    private WellBore? FindWellBore(Guid id) => wellBores_.FirstOrDefault(item => item.MetaInfo?.ID == id);
    private TrajectoryLight? FindTrajectory(Guid id) => trajectories_.FirstOrDefault(item => item.MetaInfo?.ID == id);
    private string GetReferenceTrajectoryDisplayName(Guid? id) => id is Guid trajectoryId
        ? FindTrajectory(trajectoryId)?.Name ?? trajectoryId.ToString()
        : string.Empty;
    private string GetTrajectoryName(Guid id) => FindTrajectory(id)?.Name ?? id.ToString();
    private string GetClusterName(TrajectoryLight trajectory)
    {
        if (trajectory.WellID is Guid wellId && FindWell(wellId)?.IsSingleWell == true) return "Single well";
        return trajectory.ClusterID is Guid id ? FindCluster(id)?.Name ?? "-" : "-";
    }
    private string GetWellName(TrajectoryLight trajectory) => trajectory.WellID is Guid id ? FindWell(id)?.Name ?? "-" : "-";
    private string GetWellBoreName(TrajectoryLight trajectory) => FindWellBore(trajectory.WellBoreID)?.Name ?? "-";
    private static double DepthKey(double value) => Math.Round(value, MdPrecision, MidpointRounding.AwayFromZero);
    private string FormatMeasuredDepth(double value) =>
        unitReferenceTag_?.FromWGS84DepthSI(value, "DepthDrilling", false) ?? value.ToString();
    private string FormatSafetyFactor(SafetyFactorTableRow row, Guid trajectoryId) =>
        row.Values.TryGetValue(trajectoryId, out double? value) && value.HasValue
            ? unitReferenceTag_?.FromSI(value.Value, "DimensionLessStandard", false) ?? value.Value.ToString()
            : "-";
    private string? GetSafetyFactorStyle(SafetyFactorTableRow row, Guid trajectoryId)
    {
        if (!row.Values.TryGetValue(trajectoryId, out double? value) || !value.HasValue) return null;
        policyEvaluationsByTrajectory_.TryGetValue(trajectoryId, out AntiCollisionPolicyEvaluation? evaluation);
        return Classify(value.Value, evaluation) switch
        {
            ProfileClassification.Alert => "color:#ed6c02;font-weight:700",
            ProfileClassification.Alarm => "color:#d32f2f;font-weight:700",
            _ => null
        };
    }

    private sealed class SafetyFactorTableRow
    {
        public double ReferenceMD { get; init; }
        public Dictionary<Guid, double?> Values { get; init; } = [];
    }

    private sealed record SafetyFactorPlotPoint(double ReferenceMD, double SafetyFactor);
    private enum ProfileClassification { Unclassified, Normal, Alert, Alarm }
    private sealed record SafetyFactorPlotSeries(Guid TrajectoryID, string Name, string Color, bool ShowLegend,
        string LineDash, decimal LineWidth,
        List<SafetyFactorPlotPoint> Points);
}
