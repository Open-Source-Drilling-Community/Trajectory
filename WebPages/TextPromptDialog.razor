<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="Value" Label="@Label" Immediate="@true" Autofocus="@true"
                      OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(Value)" OnClick="Submit">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string? InitialValue { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "OK";
    private string? Value { get; set; }

    protected override void OnInitialized() => Value = InitialValue;

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(Value)) MudDialog.Close(DialogResult.Ok(Value.Trim()));
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Submit();
    }
}
