    private List<List<object>> VerticalSectionValuesList => CombineMany([plotVerticalSectionValuesList, .. EllipsePlotDataSets.Select(data => data.VerticalSectionValuesList)]);
    private List<List<object>> VerticalTvdValuesList => CombineMany([plotTvdValuesList, .. EllipsePlotDataSets.Select(data => data.VerticalTvdValuesList)]);

