@inject ILogger<TrajectoryExtrapolationEdit> logger
@inject ISnackbar Snackbar
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h6" Class="mt-4 mb-3">Trajectory Extrapolation</MudText>
<MudStack Row="true" Class="mb-4">
    <MudButton Color="Color.Success" OnClick="SaveAsync">Save and calculate</MudButton>
    <MudButton Color="Color.Error" OnClick="@(() => ValueChanged.InvokeAsync())">Close</MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="3"><MudTextField @bind-Value="value.Name" Label="Name" Required="true" /></MudItem>
    <MudItem xs="12" md="3"><MudTextField @bind-Value="value.Description" Label="Description" /></MudItem>
</MudGrid>

<MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Trajectory to extrapolate</MudText>
<TrajectoryResourceFilter Fields="@fields" Clusters="@clusters" Wells="@wells" WellBores="@wellBores" Trajectories="@trajectories"
                          ResourceKind="TrajectoryResourceFilterKind.Trajectory" ResourceRequired="true"
                          FieldId="@sourceFieldId" FieldIdChanged="OnSourceFieldChanged"
                          ClusterId="@sourceClusterId" ClusterIdChanged="OnSourceClusterChanged"
                          WellId="@sourceWellId" WellIdChanged="OnSourceWellChanged"
                          WellBoreId="@sourceWellBoreId" WellBoreIdChanged="OnSourceWellBoreChanged"
                          ResourceId="@SelectedSourceTrajectoryId" ResourceIdChanged="OnSourceTrajectoryChanged" />
<MudGrid Class="mt-2">
    <MudItem xs="12" md="4">
        <RigJobSelector WellBores="@wellBores" Rigs="@rigs" WellBoreId="@sourceWellBoreId"
                        ReferenceDate="@sourceReferenceDate" SelectedRigJobId="@selectedRigJobId"
                        SelectedRigJobIdChanged="OnRigJobIdChanged" SelectionChanged="OnRigJobChanged" />
    </MudItem>
</MudGrid>

<MudGrid Class="mt-2">
    <MudItem xs="12" md="3">
        <MudSelect T="TrajectoryExtrapolationMode" Value="@value.Mode" ValueChanged="ModeChanged" Label="Extrapolation mode">
            @foreach (TrajectoryExtrapolationMode mode in Enum.GetValues<TrajectoryExtrapolationMode>()) { <MudSelectItem Value="@mode">@mode</MudSelectItem> }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudInputWithUnitAdornment QuantityLabel="Interpolation interval" QuantityName="DepthDrilling"
                          SIValueNullable="@value.InterpolationInterval" SIValueNullableChanged="SetInterval" />
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Starting survey station</MudText>
    @if (isLoadingSourceLastSurveyStation)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Info" />
        <MudText Typo="Typo.caption">Loading the final calculated station of the source trajectory…</MudText>
    }
    else if (sourceLastSurveyStation is SurveyStation startingStation)
    {
        <MudTable Items="@(new[] { startingStation })" T="SurveyStation" Dense="true" Bordered="true" ReadOnly="true">
            <HeaderContent>
                <MudTh>@DepthHeader("MD")</MudTh>
                <MudTh>@InclinationHeader("Incl")</MudTh>
                <MudTh>@AzimuthHeader("Az")</MudTh>
                <MudTh>@DepthHeader("TVD")</MudTh>
                <MudTh>@PositionHeader(NorthCoordinateLabel)</MudTh>
                <MudTh>@PositionHeader(EastCoordinateLabel)</MudTh>
                <MudTh>@CurvatureHeader("DLS")</MudTh>
                <MudTh>@CurvatureHeader("BUR")</MudTh>
                <MudTh>@CurvatureHeader("TR")</MudTh>
                <MudTh>@LengthHeader("Vertical section")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="MD"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.MD" /></MudTd>
                <MudTd DataLabel="Incl"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.Inclination" /></MudTd>
                <MudTd DataLabel="Az"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValue="@context.Azimuth" /></MudTd>
                <MudTd DataLabel="TVD"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.TVD" /></MudTd>
                <MudTd DataLabel="@NorthCoordinateLabel"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.North" SIValue="@context.RiemannianNorth" /></MudTd>
                <MudTd DataLabel="@EastCoordinateLabel"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.East" SIValue="@context.RiemannianEast" /></MudTd>
                <MudTd DataLabel="DLS"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.Curvature" /></MudTd>
                <MudTd DataLabel="BUR"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.BUR" /></MudTd>
                <MudTd DataLabel="TR"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.TUR" /></MudTd>
                <MudTd DataLabel="Vertical section"><MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.VerticalSection" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(sourceLastSurveyStationError)
            ? "Select a calculated source trajectory to show its final survey station."
            : sourceLastSurveyStationError)</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    @if (value.Specification is FixedLengthExtrapolationSpecification fixedLength)
    {
        <MudGrid>
            <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityLabel="Extension length" QuantityName="DepthDrilling" SIValueNullable="@fixedLength.Length" SIValueNullableChanged="x => fixedLength.Length = x ?? 0" /></MudItem>
            <MudItem xs="12" md="5"><MudSelect T="FixedLengthExtrapolationType" @bind-Value="fixedLength.ExtensionType" Label="Continuation"><MudSelectItem Value="FixedLengthExtrapolationType.Straight">Straight</MudSelectItem><MudSelectItem Value="FixedLengthExtrapolationType.ContinueCircularArc">Continue circular arc</MudSelectItem><MudSelectItem Value="FixedLengthExtrapolationType.ContinueConstantBuildAndTurn">Continue constant build and turn</MudSelectItem><MudSelectItem Value="FixedLengthExtrapolationType.ContinueConstantCurvatureAndToolface">Continue constant curvature and toolface</MudSelectItem></MudSelect></MudItem>
        </MudGrid>
    }
    else if (value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect)
    {
        <MudGrid>
            <MudItem xs="12" md="4"><MudSelect T="Guid" @bind-Value="reconnect.ReferenceTrajectoryID" Label="Reference trajectory">@foreach (TrajectoryLight item in ReferenceTrajectories) { <MudSelectItem Value="@item.MetaInfo.ID">@item.Name</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Advance from closest reference point" QuantityName="DepthDrilling" SIValueNullable="@reconnect.ReferenceMDAdvance" SIValueNullableChanged="x => reconnect.ReferenceMDAdvance = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Lead-in continuation" QuantityName="DepthDrilling" SIValueNullable="@reconnect.LeadInLength" SIValueNullableChanged="x => reconnect.LeadInLength = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudSelect T="ExtrapolationCurveType" @bind-Value="reconnect.CurveType" Label="Double-section curve">@foreach (ExtrapolationCurveType type in Enum.GetValues<ExtrapolationCurveType>()) { <MudSelectItem Value="@type">@type</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" md="1"><MudNumericField T="int" @bind-Value="reconnect.AzimuthBranch" Label="Az branch" /></MudItem>
            @if (reconnect.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn) { <MudItem xs="12" md="2"><MudNumericField T="double" @bind-Value="reconnect.JunctionCurvatureRatio" Label="Curvature ratio" /></MudItem> }
        </MudGrid>
    }
    else if (value.Specification is GeosteeringTrajectoryExtrapolationSpecification geosteering)
    {
        <MudText Typo="Typo.body2" Class="mb-3">
            Departure is measured from the final source-trajectory station. Steering length is the combined length of the two RSS steering sections and excludes the lead-in continuation.
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Lead-in continuation" QuantityName="DepthDrilling" SIValueNullable="@geosteering.LeadInLength" SIValueNullableChanged="x => geosteering.LeadInLength = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Target TVD" QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValueNullable="@geosteering.TargetVerticalDepth" SIValueNullableChanged="x => geosteering.TargetVerticalDepth = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="End inclination" QuantityName="PlaneAngleDrilling" SIValueNullable="@geosteering.EndInclination" SIValueNullableChanged="x => geosteering.EndInclination = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="End azimuth" QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValueNullable="@geosteering.EndAzimuth" SIValueNullableChanged="x => geosteering.EndAzimuth = x ?? 0" /></MudItem>
            <MudItem xs="12" md="3"><MudSelect T="ExtrapolationCurveType" @bind-Value="geosteering.CurveType" Label="Steering-section curve">@foreach (ExtrapolationCurveType type in Enum.GetValues<ExtrapolationCurveType>()) { <MudSelectItem Value="@type">@type</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="GeosteeringExtentChoice" Value="@ExtentChoice(geosteering)" ValueChanged="x => ChangeGeosteeringExtent(geosteering, x)" Label="Overall constraint">
                    <MudSelectItem Value="GeosteeringExtentChoice.Departure">Departure and bearing</MudSelectItem>
                    <MudSelectItem Value="GeosteeringExtentChoice.SteeringLength">Steering length</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (geosteering.Extent is DepartureGeosteeringExtentConstraint departure)
            {
                <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Overall departure" QuantityName="PositionDrilling" SIValueNullable="@departure.DepartureDistance" SIValueNullableChanged="x => departure.DepartureDistance = x ?? 0" /></MudItem>
                <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Departure bearing" QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValueNullable="@departure.DepartureBearing" SIValueNullableChanged="x => departure.DepartureBearing = x ?? 0" /></MudItem>
            }
            else if (geosteering.Extent is DrilledLengthGeosteeringExtentConstraint drilled)
            {
                <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Steering length" QuantityName="DepthDrilling" SIValueNullable="@drilled.SteeringLength" SIValueNullableChanged="x => drilled.SteeringLength = x ?? 0" /></MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="double" Value="@UpstreamSteeringPercentage(drilled)"
                                     ValueChanged="percentage => SetUpstreamSteeringPercentage(drilled, percentage)"
                                     Label="Upstream steering-section length ratio" Min="0.01" Max="99.99"
                                     HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="%"
                                     HelperText="The remaining percentage is assigned to the downstream section." />
                </MudItem>
            }
        </MudGrid>
    }
    else if (value.Specification is WellPathExtrapolationSpecification wellPath)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle1">Well-path constraints</MudText>
            <MudButton Color="Color.Success" Size="Size.Small" OnClick="AddSection">Add section</MudButton>
            <MudText Typo="Typo.caption">Specify exactly 3 × sections constraints; each section needs at least one, and no prefix may have more than 3 × its section count.</MudText>
        </MudStack>
        <MudTable T="WellPathSectionSpecification" Items="@wellPath.SectionList" Dense="true" Bordered="true" Hover="true" Style="overflow-x:auto">
            <HeaderContent>
                <MudTh>Curve</MudTh>
                <MudTh>@LengthHeader("Length")</MudTh>
                <MudTh>@InclinationHeader("Incl")</MudTh>
                <MudTh>@AzimuthHeader("Az")</MudTh>
                <MudTh>@DepthHeader("Vertical depth")</MudTh>
                <MudTh>@PositionHeader(NorthCoordinateLabel)</MudTh>
                <MudTh>@PositionHeader(EastCoordinateLabel)</MudTh>
                <MudTh>@CurvatureHeader("CA curvature")</MudTh>
                <MudTh>@PlaneAngleHeader("CA start toolface")</MudTh>
                <MudTh>@CurvatureHeader("Build rate")</MudTh>
                <MudTh>@CurvatureHeader("Turn rate")</MudTh>
                <MudTh>@CurvatureHeader("Curvature")</MudTh>
                <MudTh>@PlaneAngleHeader("Toolface")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudSelect T="ExtrapolationCurveType" Value="@CurveType(context)" ValueChanged="x => ChangeCurve(context, x)" Dense="true">@foreach (ExtrapolationCurveType type in Enum.GetValues<ExtrapolationCurveType>()) { <MudSelectItem Value="@type">@type</MudSelectItem> }</MudSelect></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="Length" QuantityName="DepthDrilling" SIValueNullable="@context.Length" SIValueNullableChanged="x => context.Length = x" /></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="Incl" QuantityName="PlaneAngleDrilling" SIValueNullable="@context.EndInclination" SIValueNullableChanged="x => context.EndInclination = x" /></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="Az" QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValueNullable="@context.EndAzimuth" SIValueNullableChanged="x => context.EndAzimuth = x" /></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="TVD" QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValueNullable="@context.EndVerticalDepth" SIValueNullableChanged="x => context.EndVerticalDepth = x" /></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="North" QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.North" SIValueNullable="@context.EndNorth" SIValueNullableChanged="x => context.EndNorth = x" /></MudTd>
                <MudTd><MudInputWithUnitAdornment QuantityLabel="East" QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.East" SIValueNullable="@context.EndEast" SIValueNullableChanged="x => context.EndEast = x" /></MudTd>
                <MudTd>@if (context is CircularArcWellPathSectionSpecification ca) { <MudInputWithUnitAdornment QuantityLabel="CA curvature" QuantityName="CurvatureDrilling" SIValueNullable="@ca.Curvature" SIValueNullableChanged="x => ca.Curvature = x" /> }</MudTd>
                <MudTd>@if (context is CircularArcWellPathSectionSpecification ca) { <MudInputWithUnitAdornment QuantityLabel="Start toolface" QuantityName="PlaneAngleDrilling" SIValueNullable="@ca.StartToolface" SIValueNullableChanged="x => ca.StartToolface = x" /> }</MudTd>
                <MudTd>@if (context is ConstantBuildAndTurnWellPathSectionSpecification bt) { <MudInputWithUnitAdornment QuantityLabel="Build" QuantityName="CurvatureDrilling" SIValueNullable="@bt.BuildRate" SIValueNullableChanged="x => bt.BuildRate = x" /> }</MudTd>
                <MudTd>@if (context is ConstantBuildAndTurnWellPathSectionSpecification bt) { <MudInputWithUnitAdornment QuantityLabel="Turn" QuantityName="CurvatureDrilling" SIValueNullable="@bt.TurnRate" SIValueNullableChanged="x => bt.TurnRate = x" /> }</MudTd>
                <MudTd>@if (context is ConstantCurvatureAndToolfaceWellPathSectionSpecification ct) { <MudInputWithUnitAdornment QuantityLabel="Curvature" QuantityName="CurvatureDrilling" SIValueNullable="@ct.Curvature" SIValueNullableChanged="x => ct.Curvature = x" /> }</MudTd>
                <MudTd>@if (context is ConstantCurvatureAndToolfaceWellPathSectionSpecification ct) { <MudInputWithUnitAdornment QuantityLabel="Toolface" QuantityName="PlaneAngleDrilling" SIValueNullable="@ct.Toolface" SIValueNullableChanged="x => ct.Toolface = x" /> }</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveSection(context.SectionID))" /></MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption" Color="@(ConstraintCount == 3 * wellPath.SectionList.Count ? Color.Success : Color.Warning)">Constraints: @ConstraintCount / @(3 * wellPath.SectionList.Count)</MudText>

        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Calculated well path</MudText>
        <MudText Typo="Typo.caption" Class="mb-2">Values supplied as well-path input constraints are shown in bold.</MudText>
        @if (value.CalculationState is CalculationState.Queued or CalculationState.Running)
        {
            <MudProgressLinear Value="@(100 * value.CalculationProgress)" />
        }
        else if (WellPathSolvedSections.Count > 0)
        {
            <MudTable T="TrajectoryExtrapolationSolvedSection" Items="@WellPathSolvedSections"
                      Dense="true" Bordered="true" Hover="true" ReadOnly="true" Style="overflow-x:auto">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Curve</MudTh>
                    <MudTh>@LengthHeader("Length")</MudTh>
                    <MudTh>@DepthHeader("End MD")</MudTh>
                    <MudTh>@InclinationHeader("End incl")</MudTh>
                    <MudTh>@AzimuthHeader("End az")</MudTh>
                    <MudTh>@DepthHeader("End TVD")</MudTh>
                    <MudTh>@PositionHeader($"End {NorthCoordinateLabel}")</MudTh>
                    <MudTh>@PositionHeader($"End {EastCoordinateLabel}")</MudTh>
                    <MudTh>@CurvatureHeader("CA curvature")</MudTh>
                    <MudTh>@PlaneAngleHeader("CA start toolface")</MudTh>
                    <MudTh>@CurvatureHeader("Build rate")</MudTh>
                    <MudTh>@CurvatureHeader("Turn rate")</MudTh>
                    <MudTh>@CurvatureHeader("Curvature")</MudTh>
                    <MudTh>@PlaneAngleHeader("Toolface")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@(context.SectionIndex + 1)</MudTd>
                    <MudTd DataLabel="Curve">@context.CurveType</MudTd>
                    <MudTd DataLabel="Length"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.Length)"><MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.Length" /></span></MudTd>
                    <MudTd DataLabel="End MD"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.EndMD" /></MudTd>
                    <MudTd DataLabel="End incl"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.EndInclination)"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.End?.Inclination" /></span></MudTd>
                    <MudTd DataLabel="End az"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.EndAzimuth)"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValue="@context.End?.Azimuth" /></span></MudTd>
                    <MudTd DataLabel="End TVD"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.EndVerticalDepth)"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.End?.TVD" /></span></MudTd>
                    <MudTd DataLabel="@($"End {NorthCoordinateLabel}")"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.EndNorth)"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.North" SIValue="@context.End?.RiemannianNorth" /></span></MudTd>
                    <MudTd DataLabel="@($"End {EastCoordinateLabel}")"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.EndEast)"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.East" SIValue="@context.End?.RiemannianEast" /></span></MudTd>
                    <MudTd DataLabel="CA curvature"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.CircularArcCurvature)"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.CircularArcCurvature" /></span></MudTd>
                    <MudTd DataLabel="CA start toolface"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.CircularArcStartToolface)"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.CircularArcStartToolface" /></span></MudTd>
                    <MudTd DataLabel="Build rate"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.BuildRate)"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantBuildRate" /></span></MudTd>
                    <MudTd DataLabel="Turn rate"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.TurnRate)"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantTurnRate" /></span></MudTd>
                    <MudTd DataLabel="Curvature"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.ConstantCurvature)"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantCurvature" /></span></MudTd>
                    <MudTd DataLabel="Toolface"><span class="@WellPathInputClass(context.SectionID, WellPathResultValue.ConstantToolface)"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.ConstantToolface" /></span></MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (value.CalculationState == CalculationState.Failed)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@value.CalculationMessage</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2">Save and calculate to show the solved well-path sections.</MudText>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.subtitle1">Calculation: @value.CalculationState @value.CalculationMessage</MudText>
    @if (value.CalculationState is CalculationState.Queued or CalculationState.Running) { <MudProgressLinear Value="@(100 * value.CalculationProgress)" /> }
    @if (value.Mode != TrajectoryExtrapolationMode.WellPath && value.SolvedSectionList is { Count: > 0 })
    {
        <MudTable Items="@value.SolvedSectionList" T="TrajectoryExtrapolationSolvedSection" Dense="true" Bordered="true">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>@LengthHeader("Length")</MudTh>
                <MudTh>@DepthHeader("End MD")</MudTh>
                <MudTh>@CurvatureHeader("CA curvature")</MudTh>
                <MudTh>@PlaneAngleHeader("CA toolface")</MudTh>
                <MudTh>@CurvatureHeader("Build")</MudTh>
                <MudTh>@CurvatureHeader("Turn")</MudTh>
                <MudTh>@CurvatureHeader("Curvature")</MudTh>
                <MudTh>@PlaneAngleHeader("Toolface")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SectionIndex</MudTd>
                <MudTd>@context.Role</MudTd>
                <MudTd>@context.CurveType</MudTd>
                <MudTd><MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.Length" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.EndMD" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.CircularArcCurvature" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.CircularArcStartToolface" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantBuildRate" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantTurnRate" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.ConstantCurvature" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.ConstantToolface" /></MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption">@stationCount sampled stations available in chunked results.</MudText>
    }

    @if (value.CalculationState == CalculationState.Completed)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-2">
            <MudText Typo="Typo.subtitle1">Interpolated extrapolated trajectory</MudText>
            <MudButton Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small"
                       Disabled="@(interpolatedExtrapolationStations.Count == 0 || isSavingSurveyRun)"
                       OnClick="SaveAsSurveyRunAsync">Save as survey run</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                       Disabled="@(interpolatedExtrapolationStations.Count == 0 || isExportingSurveyStations)"
                       OnClick="ExportInterpolatedExtrapolationAsync">Export ASCII</MudButton>
            @if (isSavingSurveyRun || isExportingSurveyStations)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </MudStack>
        @if (isLoadingSurveyStations)
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.body2">@SurveyStationLoadingText</MudText>
                <MudProgressLinear Value="@SurveyStationLoadingProgressPercent" Color="Color.Info" Class="mt-2" />
            </MudPaper>
        }
        else if (interpolatedExtrapolationStations.Count > 0)
        {
            <MudTable Items="@interpolatedExtrapolationStations" T="SurveyStation" Height="400px" FixedHeader="true"
                      Virtualize="true" OverscanCount="3" ItemSize="38"
                      Elevation="1" CustomHeader="true" Hover="true" Dense="true" Bordered="true" ReadOnly="true">
                <HeaderContent>
                    <MudTHeadRow>
                        <MudTh>@DepthHeader("MD")</MudTh>
                        <MudTh>@InclinationHeader("Incl")</MudTh>
                        <MudTh>@AzimuthHeader("Az")</MudTh>
                        <MudTh>@DepthHeader("TVD")</MudTh>
                        <MudTh>@PositionHeader(NorthCoordinateLabel)</MudTh>
                        <MudTh>@PositionHeader(EastCoordinateLabel)</MudTh>
                        <MudTh>@CurvatureHeader("DLS")</MudTh>
                        <MudTh>@CurvatureHeader("BUR")</MudTh>
                        <MudTh>@CurvatureHeader("TR")</MudTh>
                        <MudTh>@LengthHeader("Vertical section")</MudTh>
                    </MudTHeadRow>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="MD"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.MD" /></MudTd>
                    <MudTd DataLabel="Incl"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.Inclination" /></MudTd>
                    <MudTd DataLabel="Az"><MudSpanWithUnit QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValue="@context.Azimuth" /></MudTd>
                    <MudTd DataLabel="TVD"><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.TVD" /></MudTd>
                    <MudTd DataLabel="@NorthCoordinateLabel"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.North" SIValue="@context.RiemannianNorth" /></MudTd>
                    <MudTd DataLabel="@EastCoordinateLabel"><MudSpanWithUnit QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.East" SIValue="@context.RiemannianEast" /></MudTd>
                    <MudTd DataLabel="DLS"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.Curvature" /></MudTd>
                    <MudTd DataLabel="BUR"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.BUR" /></MudTd>
                    <MudTd DataLabel="TR"><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.TUR" /></MudTd>
                    <MudTd DataLabel="Vertical section"><MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.VerticalSection" /></MudTd>
                </RowTemplate>
            </MudTable>
            <SurveyStationEllipseTable SurveyStationList="@interpolatedExtrapolationStations"
                                       CalculationName="@($"{value.Name} extrapolated trajectory uncertainty ellipses")" />
        }
        else
        {
            <MudText>No interpolated extrapolated trajectory is available.</MudText>
        }
    }
</MudPaper>

@code {
    [CascadingParameter] private MudUnitAndReferenceChoiceTag? Parent { get; set; }
    [Parameter] public Guid? CaseId { get; set; }
    [Parameter] public EventCallback ValueChanged { get; set; }
    private TrajectoryExtrapolationCase value = NewCase();
    private List<Field> fields = [];
    private List<Cluster> clusters = [];
    private List<Well> wells = [];
    private List<WellBore> wellBores = [];
    private List<Rig> rigs = [];
    private List<SurveyRunLight> surveyRuns = [];
    private List<TrajectoryLight> trajectories = [];
    private Guid? sourceFieldId;
    private Guid? sourceClusterId;
    private Guid? sourceWellId;
    private Guid? sourceWellBoreId;
    private Guid? selectedRigJobId;
    private DateTimeOffset? sourceReferenceDate;
    private SurveyStation? sourceLastSurveyStation;
    private bool isLoadingSourceLastSurveyStation;
    private string? sourceLastSurveyStationError;
    private int sourceLastSurveyStationLoadVersion;
    private int stationCount;
    private readonly List<SurveyStation> interpolatedExtrapolationStations = [];
    private bool isLoadingSurveyStations;
    private bool isSavingSurveyRun;
    private bool isExportingSurveyStations;
    private int loadedSurveyStationChunkCount;
    private int totalSurveyStationChunkCount;
    private enum GeosteeringExtentChoice { Departure, SteeringLength }
    private enum WellPathResultValue
    {
        Length,
        EndInclination,
        EndAzimuth,
        EndVerticalDepth,
        EndNorth,
        EndEast,
        CircularArcCurvature,
        CircularArcStartToolface,
        BuildRate,
        TurnRate,
        ConstantCurvature,
        ConstantToolface
    }

    private double SurveyStationLoadingProgressPercent => totalSurveyStationChunkCount == 0
        ? 0
        : 100.0 * loadedSurveyStationChunkCount / totalSurveyStationChunkCount;
    private string SurveyStationLoadingText => totalSurveyStationChunkCount == 0
        ? "Loading interpolated extrapolated trajectory…"
        : $"Loading interpolated extrapolated trajectory chunk {loadedSurveyStationChunkCount} of {totalSurveyStationChunkCount}…";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Task<TrajectoryReferenceDataSnapshot> referenceDataTask = ReferenceData.GetSnapshotAsync();
            Task<List<TrajectoryLight>> trajectoryTask = Api.ClientTrajectory.GetAllTrajectoryLightAsync();
            Task<List<SurveyRunLight>> surveyRunTask = Api.ClientTrajectory.GetAllSurveyRunLightAsync();
            await Task.WhenAll(referenceDataTask, trajectoryTask, surveyRunTask);

            TrajectoryReferenceDataSnapshot referenceData = await referenceDataTask;
            fields = referenceData.Fields.ToList();
            clusters = referenceData.Clusters.ToList();
            wells = referenceData.Wells.ToList();
            wellBores = referenceData.WellBores.ToList();
            rigs = referenceData.Rigs.ToList();
            trajectories = (await trajectoryTask).OrderBy(x => x.Name).ToList();
            surveyRuns = (await surveyRunTask).OrderBy(x => x.Name).ToList();
            if (CaseId is Guid id)
            {
                value = await Api.ClientTrajectory.GetTrajectoryExtrapolationCaseByIdAsync(id, false);
                InitializeSourceHierarchy();
                sourceReferenceDate = await ResolveSourceTrajectoryDateAsync(SelectedSourceTrajectoryId);
                await UpdateSourceReferenceValuesAsync();
                await LoadSourceLastSurveyStationAsync(SelectedSourceTrajectoryId);
                if (value.CalculationState is CalculationState.Queued or CalculationState.Running) _ = PollAsync();
                else await LoadSurveyStationsAsync();
            }
        }
        catch (Exception ex) { logger.LogError(ex, "Unable to load trajectory extrapolation editor"); Snackbar.Add("Unable to load the extrapolation.", Severity.Error); }
    }

    private static TrajectoryExtrapolationCase NewCase() => new() { MetaInfo = PseudoConstructors.ConstructMetaInfo(), Name = "New extrapolation", InterpolationInterval = 30, Mode = TrajectoryExtrapolationMode.FixedLength, CalculationState = CalculationState.NotCalculated, Specification = new FixedLengthExtrapolationSpecification { Length = 30, ExtensionType = FixedLengthExtrapolationType.Straight }, SolvedSectionList = [], SurveyStationList = [] };
    private Guid? SelectedSourceTrajectoryId => value.SourceTrajectoryID == Guid.Empty ? null : value.SourceTrajectoryID;

    private void InitializeSourceHierarchy()
    {
        TrajectoryLight? source = trajectories.FirstOrDefault(item => item.MetaInfo?.ID == value.SourceTrajectoryID);
        sourceFieldId = source?.FieldID;
        Cluster? sourceCluster = source?.ClusterID is Guid clusterId
            ? clusters.FirstOrDefault(item => item.MetaInfo?.ID == clusterId)
            : null;
        sourceClusterId = sourceCluster?.IsSingleWell == false ? sourceCluster.MetaInfo.ID : null;
        sourceWellId = source?.WellID;
        sourceWellBoreId = source?.WellBoreID == Guid.Empty ? null : source?.WellBoreID;
    }

    private async Task OnSourceFieldChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceFieldId = id;
        sourceClusterId = null;
        sourceWellId = null;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceClusterChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceClusterId = id;
        sourceWellId = null;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceWellChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceWellId = id;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceWellBoreChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceWellBoreId = id;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceTrajectoryChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        value.SourceTrajectoryID = id ?? Guid.Empty;
        sourceReferenceDate = await ResolveSourceTrajectoryDateAsync(SelectedSourceTrajectoryId);
        selectedRigJobId = null;
        Task startingStationTask = LoadSourceLastSurveyStationAsync(SelectedSourceTrajectoryId);
        await UpdateSourceReferenceValuesAsync();
        await startingStationTask;
    }

    private void ClearSourceLastSurveyStation()
    {
        sourceLastSurveyStationLoadVersion++;
        sourceLastSurveyStation = null;
        sourceLastSurveyStationError = null;
        isLoadingSourceLastSurveyStation = false;
    }

    private async Task LoadSourceLastSurveyStationAsync(Guid? trajectoryId)
    {
        int loadVersion = ++sourceLastSurveyStationLoadVersion;
        sourceLastSurveyStation = null;
        sourceLastSurveyStationError = null;
        isLoadingSourceLastSurveyStation = trajectoryId is Guid id && id != Guid.Empty;
        await InvokeAsync(StateHasChanged);

        if (trajectoryId is not Guid sourceTrajectoryId || sourceTrajectoryId == Guid.Empty)
        {
            return;
        }

        try
        {
            int chunkCount = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkCountAsync(sourceTrajectoryId);
            for (int chunkIndex = chunkCount - 1; chunkIndex >= 0; chunkIndex--)
            {
                SurveyStationChunk chunk = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkAsync(sourceTrajectoryId, chunkIndex);
                SurveyStation? lastStation = chunk.SurveyStationList?
                    .Where(station => station != null)
                    .OrderBy(station => station.MD)
                    .LastOrDefault();
                if (lastStation != null)
                {
                    if (loadVersion == sourceLastSurveyStationLoadVersion && SelectedSourceTrajectoryId == sourceTrajectoryId)
                    {
                        sourceLastSurveyStation = lastStation;
                    }
                    return;
                }
            }

            if (loadVersion == sourceLastSurveyStationLoadVersion)
            {
                sourceLastSurveyStationError = "The selected trajectory has no calculated survey stations.";
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to load the final calculated station of source trajectory {TrajectoryId}", sourceTrajectoryId);
            if (loadVersion == sourceLastSurveyStationLoadVersion)
            {
                sourceLastSurveyStationError = "The starting survey station could not be loaded.";
            }
        }
        finally
        {
            if (loadVersion == sourceLastSurveyStationLoadVersion)
            {
                isLoadingSourceLastSurveyStation = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task UpdateSourceReferenceValuesAsync()
    {
        Guid? trajectoryId = SelectedSourceTrajectoryId;
        DataUtils.ApplyTrajectoryReferenceValues(trajectoryId, trajectories, wellBores, wells, clusters, rigs, fields,
            selectedRigJobId, sourceReferenceDate);
        await CartographicPositionReferenceUtils.ApplyForTrajectoryAsync(Api, trajectoryId, trajectories, clusters, fields, logger);
        try
        {
            TrajectoryReferenceDatumUtils.Apply(
                await TrajectoryReferenceDatumUtils.ResolveForTrajectoryAsync(Api, trajectoryId, trajectories, wellBores, wells, clusters));
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to resolve optional depth and azimuth references for source trajectory {TrajectoryId}", trajectoryId);
            TrajectoryReferenceDatumUtils.Apply(new TrajectoryReferenceDatumValues(null, null, null));
        }
    }

    private Task OnRigJobIdChanged(Guid? id)
    {
        selectedRigJobId = id;
        return Task.CompletedTask;
    }

    private async Task OnRigJobChanged(RigJob? _)
    {
        await UpdateSourceReferenceValuesAsync();
    }

    private Task<DateTimeOffset?> ResolveSourceTrajectoryDateAsync(Guid? trajectoryId) =>
        TrajectoryRigJobDateResolver.ResolveAsync(Api, trajectoryId, trajectories, surveyRuns, logger);

    private string NorthCoordinateLabel => GetCoordinateLabel(PositionDirectionType.North);
    private string EastCoordinateLabel => GetCoordinateLabel(PositionDirectionType.East);
    private string GetCoordinateLabel(PositionDirectionType direction)
    {
        string? reference = Parent?.PositionReferenceName ?? DataUtils.UnitAndReferenceParameters.PositionReferenceName;
        if (string.Equals(reference, "WGS84", StringComparison.OrdinalIgnoreCase))
            return direction == PositionDirectionType.North ? "Riemann North" : "Riemann East";
        if (string.Equals(reference, "Cartographic", StringComparison.OrdinalIgnoreCase))
            return direction == PositionDirectionType.North ? "Northing" : "Easting";
        return direction == PositionDirectionType.North ? "North" : "East";
    }

    private string LengthHeader(string name) => $"{name} [{Parent?.GetUnitLabel("DepthDrilling")}]";
    private string DepthHeader(string name) => $"{name} [{Parent?.GetDepthUnitLabel("DepthDrilling")}]";
    private string InclinationHeader(string name) => $"{name} [{Parent?.GetUnitLabel("PlaneAngleDrilling")}]";
    private string AzimuthHeader(string name) => $"{name} [{Parent?.GetAzimuthUnitLabel("PlaneAngleDrilling")}]";
    private string PositionHeader(string name) => $"{name} [{Parent?.GetPositionUnitLabel("PositionDrilling")}]";
    private string CurvatureHeader(string name) => $"{name} [{Parent?.GetUnitLabel("CurvatureDrilling")}]";
    private string PlaneAngleHeader(string name) => $"{name} [{Parent?.GetUnitLabel("PlaneAngleDrilling")}]";

    private static double UpstreamSteeringPercentage(DrilledLengthGeosteeringExtentConstraint drilled)
    {
        double ratio = drilled.SteeringLengthRatio;
        return double.IsFinite(ratio) && ratio > 0.0
            ? 100.0 * ratio / (1.0 + ratio)
            : 50.0;
    }

    private static void SetUpstreamSteeringPercentage(
        DrilledLengthGeosteeringExtentConstraint drilled, double percentage)
    {
        double boundedPercentage = Math.Clamp(percentage, 0.01, 99.99);
        drilled.SteeringLengthRatio = boundedPercentage / (100.0 - boundedPercentage);
    }

    private IEnumerable<TrajectoryLight> ReferenceTrajectories => trajectories.Where(x => x.MetaInfo.ID != value.SourceTrajectoryID);
    private List<TrajectoryExtrapolationSolvedSection> WellPathSolvedSections => value.SolvedSectionList?
        .Where(section => section.Role == TrajectoryExtrapolationSectionRole.WellPathSection)
        .OrderBy(section => section.SectionIndex)
        .ToList() ?? [];

    private string WellPathInputClass(Guid sectionId, WellPathResultValue resultValue)
    {
        if (value.Specification is not WellPathExtrapolationSpecification wellPath)
        {
            return "well-path-result-value";
        }

        WellPathSectionSpecification? input = wellPath.SectionList.FirstOrDefault(section => section.SectionID == sectionId);
        if (input == null)
        {
            return "well-path-result-value";
        }
        bool wasInput = resultValue switch
        {
            WellPathResultValue.Length => input.Length.HasValue,
            WellPathResultValue.EndInclination => input.EndInclination.HasValue,
            WellPathResultValue.EndAzimuth => input.EndAzimuth.HasValue,
            WellPathResultValue.EndVerticalDepth => input.EndVerticalDepth.HasValue,
            WellPathResultValue.EndNorth => input.EndNorth.HasValue,
            WellPathResultValue.EndEast => input.EndEast.HasValue,
            WellPathResultValue.CircularArcCurvature =>
                input is CircularArcWellPathSectionSpecification circularArc && circularArc.Curvature.HasValue,
            WellPathResultValue.CircularArcStartToolface =>
                input is CircularArcWellPathSectionSpecification circularArc && circularArc.StartToolface.HasValue,
            WellPathResultValue.BuildRate =>
                input is ConstantBuildAndTurnWellPathSectionSpecification buildAndTurn && buildAndTurn.BuildRate.HasValue,
            WellPathResultValue.TurnRate =>
                input is ConstantBuildAndTurnWellPathSectionSpecification buildAndTurn && buildAndTurn.TurnRate.HasValue,
            WellPathResultValue.ConstantCurvature =>
                input is ConstantCurvatureAndToolfaceWellPathSectionSpecification curvatureAndToolface && curvatureAndToolface.Curvature.HasValue,
            WellPathResultValue.ConstantToolface =>
                input is ConstantCurvatureAndToolfaceWellPathSectionSpecification curvatureAndToolface && curvatureAndToolface.Toolface.HasValue,
            _ => false
        };
        return wasInput ? "well-path-result-value well-path-input-value" : "well-path-result-value";
    }

    private void SetInterval(double? interval) => value.InterpolationInterval = interval ?? 0;
    private void ModeChanged(TrajectoryExtrapolationMode mode)
    {
        value.Mode = mode;
        value.Specification = mode switch
        {
            TrajectoryExtrapolationMode.FixedLength => new FixedLengthExtrapolationSpecification { Length = 30 },
            TrajectoryExtrapolationMode.ReconnectToTrajectory => new ReconnectTrajectoryExtrapolationSpecification { ReferenceMDAdvance = 30, JunctionCurvatureRatio = 1 },
            TrajectoryExtrapolationMode.Geosteering => new GeosteeringTrajectoryExtrapolationSpecification
            {
                CurveType = ExtrapolationCurveType.ConstantCurvatureAndToolface,
                Extent = new DrilledLengthGeosteeringExtentConstraint { SteeringLength = 60, SteeringLengthRatio = 1 }
            },
            _ => new WellPathExtrapolationSpecification { SectionList = [] }
        };
    }

    private static GeosteeringExtentChoice ExtentChoice(GeosteeringTrajectoryExtrapolationSpecification specification) =>
        specification.Extent is DepartureGeosteeringExtentConstraint
            ? GeosteeringExtentChoice.Departure
            : GeosteeringExtentChoice.SteeringLength;

    private static void ChangeGeosteeringExtent(GeosteeringTrajectoryExtrapolationSpecification specification,
        GeosteeringExtentChoice choice)
    {
        specification.Extent = choice == GeosteeringExtentChoice.Departure
            ? new DepartureGeosteeringExtentConstraint { DepartureDistance = 30 }
            : new DrilledLengthGeosteeringExtentConstraint { SteeringLength = 60, SteeringLengthRatio = 1 };
    }

    private async Task SaveAsSurveyRunAsync()
    {
        if (interpolatedExtrapolationStations.Count < 2 || value.SourceTrajectoryID == Guid.Empty)
        {
            Snackbar.Add("A completed extrapolation with at least two stations is required", Severity.Warning);
            return;
        }

        string? name = await PromptAsync(
            "Save extrapolation as survey run",
            "Survey run name",
            string.IsNullOrWhiteSpace(value.Name) ? "Planned extrapolation" : value.Name + " survey run",
            "Save");
        if (name == null) return;

        isSavingSurveyRun = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            Trajectory source = await Api.ClientTrajectory.GetTrajectoryByIdAsync(value.SourceTrajectoryID, false);
            SurveyRun? parentSurveyRun = await ResolveLastSourceSurveyRunAsync(source);
            if (parentSurveyRun?.MetaInfo?.ID is not Guid parentSurveyRunId ||
                parentSurveyRunId == Guid.Empty || parentSurveyRun.SurveyInstrumentID == Guid.Empty)
            {
                Snackbar.Add("The source trajectory has no usable survey run from which to inherit the survey instrument", Severity.Error);
                return;
            }

            List<SurveyMeasurement> measurements = interpolatedExtrapolationStations
                .Where(station => (station.MD ?? station.Abscissa).HasValue && station.Inclination.HasValue && station.Azimuth.HasValue)
                .OrderBy(station => station.MD ?? station.Abscissa)
                .GroupBy(station => station.MD ?? station.Abscissa)
                .Select(group => CreatePlannedMeasurement(group.Last()))
                .ToList();
            if (measurements.Count < 2)
            {
                Snackbar.Add("The extrapolation does not contain two complete, distinct stations", Severity.Error);
                return;
            }

            Guid surveyRunId = Guid.NewGuid();
            SurveyRun surveyRun = new()
            {
                MetaInfo = new MetaInfo { ID = surveyRunId },
                Name = name,
                Description = $"Planned survey run created from trajectory extrapolation '{value.Name}'.",
                FieldID = source.FieldID,
                ClusterID = source.ClusterID,
                WellID = source.WellID,
                WellBoreID = source.WellBoreID,
                SurveyInstrumentID = parentSurveyRun.SurveyInstrumentID,
                SurveyRunType = SurveyRunType.Planned,
                CalculationType = source.CalculationType,
                DefaultInclinationReference = SurveyInclinationReference.GeodeticVertical,
                DefaultAzimuthReference = SurveyAzimuthReference.TrueNorth,
                GeomagneticModel = SurveyGeomagneticModel.Automatic,
                ParentSurveyRunID = parentSurveyRunId,
                SurveyRunIdentityAssignments = [],
                SurveyRunFeatureAssignments = [],
                SurveyMeasurementList = measurements,
                SurveyStationList = null
            };

            await Api.ClientTrajectory.PostSurveyRunAsync(surveyRun);
            Snackbar.Add($"Planned survey run '{name}' was created", Severity.Success);
        }
        catch (ApiException ex)
        {
            logger.LogError(ex, "Unable to save extrapolation as a planned survey run");
            Snackbar.Add(ex.Response ?? ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to save extrapolation as a planned survey run");
            Snackbar.Add("Unable to save the planned survey run: " + ex.Message, Severity.Error);
        }
        finally
        {
            isSavingSurveyRun = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<SurveyRun?> ResolveLastSourceSurveyRunAsync(Trajectory source)
    {
        foreach (TrajectorySurveyRunSection? section in source.SurveyRunSectionList?.AsEnumerable().Reverse() ?? [])
        {
            if (section?.SurveyRunID is not Guid surveyRunId || surveyRunId == Guid.Empty) continue;
            try
            {
                SurveyRun run = await Api.ClientTrajectory.GetSurveyRunByIdAsync(surveyRunId, false, false);
                if (run.SurveyInstrumentID != Guid.Empty) return run;
            }
            catch (ApiException ex) when (ex.StatusCode == 404)
            {
                logger.LogWarning("Source trajectory references missing survey run {SurveyRunId}", surveyRunId);
            }
        }
        return null;
    }

    private static SurveyMeasurement CreatePlannedMeasurement(SurveyStation station) => new()
    {
        MeasurementID = Guid.NewGuid(),
        Origin = SurveyMeasurementOrigin.Measured,
        MD = station.MD ?? station.Abscissa,
        Inclination = station.Inclination,
        Azimuth = station.Azimuth,
        ObservedInclination = station.Inclination,
        ObservedAzimuth = station.Azimuth,
        InclinationReference = SurveyInclinationReference.InheritRun,
        AzimuthReference = SurveyAzimuthReference.InheritRun,
        Correction = SurveyMeasurement.CreatePendingCorrection(),
        Annotation = "Planned trajectory extrapolation"
    };

    private async Task ExportInterpolatedExtrapolationAsync()
    {
        if (Parent == null || interpolatedExtrapolationStations.Count == 0) return;
        string defaultName = string.IsNullOrWhiteSpace(value.Name) ? "trajectory-extrapolation.tsv" : value.Name + ".tsv";

        isExportingSurveyStations = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            string content = SurveyStationAsciiExport.BuildTabSeparated(Parent, interpolatedExtrapolationStations);
            string fileName = SurveyStationAsciiExport.EnsureTsvFileName(defaultName, "trajectory-extrapolation.tsv");
            string base64Content = Convert.ToBase64String(Encoding.ASCII.GetBytes(content));
            bool saved = await JSRuntime.InvokeAsync<bool>(
                "trajectoryDownloads.saveTextFileFromBase64",
                fileName,
                base64Content,
                "text/tab-separated-values;charset=us-ascii");
            if (saved) Snackbar.Add($"Exported '{fileName}'", Severity.Success);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to export interpolated trajectory extrapolation");
            Snackbar.Add("Unable to export the extrapolation: " + ex.Message, Severity.Error);
        }
        finally
        {
            isExportingSurveyStations = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string?> PromptAsync(string title, string label, string initialValue, string confirmText)
    {
        DialogParameters parameters = new()
        {
            { nameof(TextPromptDialog.Label), label },
            { nameof(TextPromptDialog.InitialValue), initialValue },
            { nameof(TextPromptDialog.ConfirmText), confirmText }
        };
        IDialogReference dialog = await DialogService.ShowAsync<TextPromptDialog>(
            title, parameters, TrajectoryDialogOptions.Compact);
        DialogResult? result = await dialog.Result;
        return result is { Canceled: false, Data: string text } && !string.IsNullOrWhiteSpace(text)
            ? text.Trim()
            : null;
    }

    private async Task SaveAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value.Name) || value.SourceTrajectoryID == Guid.Empty) { Snackbar.Add("Name and source trajectory are required.", Severity.Warning); return; }
            if (value.Specification is GeosteeringTrajectoryExtrapolationSpecification geosteering)
            {
                // The editor intentionally uses the minimum-rotation solution. Retain the serialized
                // property for compatibility with existing cases and API clients, but never preserve a
                // previously stored non-zero advanced branch when saving from this simplified editor.
                geosteering.AzimuthBranch = 0;
            }
            DateTimeOffset? expected = value.LastModificationDate;
            if (CaseId is Guid id) value = await Api.ClientTrajectory.PutTrajectoryExtrapolationCaseByIdAsync(id, ConcurrencyToken.Require(expected), value);
            else { value.MetaInfo.ID = value.MetaInfo.ID == Guid.Empty ? Guid.NewGuid() : value.MetaInfo.ID; value = await Api.ClientTrajectory.PostTrajectoryExtrapolationCaseAsync(value); CaseId = value.MetaInfo.ID; }
            Snackbar.Add("Extrapolation queued.", Severity.Success);
            _ = PollAsync();
        }
        catch (ApiException ex) { logger.LogError(ex, "Unable to save trajectory extrapolation"); Snackbar.Add(ex.Response ?? ex.Message, Severity.Error); }
    }

    private async Task PollAsync()
    {
        if (CaseId is not Guid persistedCaseId) return;
        for (int i = 0; i < 120; i++)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            value = await Api.ClientTrajectory.GetTrajectoryExtrapolationCaseByIdAsync(persistedCaseId, false);
            await InvokeAsync(StateHasChanged);
            if (value.CalculationState is not (CalculationState.Queued or CalculationState.Running)) { await LoadSurveyStationsAsync(); return; }
        }
    }

    private async Task LoadSurveyStationsAsync()
    {
        stationCount = 0;
        interpolatedExtrapolationStations.Clear();
        loadedSurveyStationChunkCount = 0;
        totalSurveyStationChunkCount = 0;
        if (CaseId is not Guid persistedCaseId || value.CalculationState != CalculationState.Completed) return;
        isLoadingSurveyStations = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            totalSurveyStationChunkCount = await Api.ClientTrajectory.GetTrajectoryExtrapolationSurveyStationChunkCountAsync(persistedCaseId);
            for (int i = 0; i < totalSurveyStationChunkCount; i++)
            {
                SurveyStationChunk chunk = await Api.ClientTrajectory.GetTrajectoryExtrapolationSurveyStationChunkAsync(persistedCaseId, i);
                if (chunk.SurveyStationList is { Count: > 0 })
                {
                    interpolatedExtrapolationStations.AddRange(chunk.SurveyStationList);
                }
                stationCount += chunk.StationCount;
                loadedSurveyStationChunkCount = i + 1;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            isLoadingSurveyStations = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AddSection() { if (value.Specification is WellPathExtrapolationSpecification p) p.SectionList.Add(new CircularArcWellPathSectionSpecification { SectionID = Guid.NewGuid(), Length = 30, Curvature = 0, StartToolface = 0 }); }
    private void RemoveSection(Guid id) { if (value.Specification is WellPathExtrapolationSpecification p) p.SectionList.RemoveAll(x => x.SectionID == id); }
    private static ExtrapolationCurveType CurveType(WellPathSectionSpecification section) => section switch { CircularArcWellPathSectionSpecification => ExtrapolationCurveType.CircularArc, ConstantBuildAndTurnWellPathSectionSpecification => ExtrapolationCurveType.ConstantBuildAndTurn, _ => ExtrapolationCurveType.ConstantCurvatureAndToolface };
    private void ChangeCurve(WellPathSectionSpecification old, ExtrapolationCurveType type)
    {
        if (value.Specification is not WellPathExtrapolationSpecification path) return;
        WellPathSectionSpecification replacement = type switch { ExtrapolationCurveType.CircularArc => new CircularArcWellPathSectionSpecification(), ExtrapolationCurveType.ConstantBuildAndTurn => new ConstantBuildAndTurnWellPathSectionSpecification(), _ => new ConstantCurvatureAndToolfaceWellPathSectionSpecification() };
        replacement.SectionID = old.SectionID; replacement.Length = old.Length; replacement.EndInclination = old.EndInclination; replacement.EndAzimuth = old.EndAzimuth; replacement.EndVerticalDepth = old.EndVerticalDepth; replacement.EndNorth = old.EndNorth; replacement.EndEast = old.EndEast;
        path.SectionList[path.SectionList.IndexOf(old)] = replacement;
    }
    private int ConstraintCount => value.Specification is not WellPathExtrapolationSpecification p ? 0 : p.SectionList.Sum(Count);
    private static int Count(WellPathSectionSpecification s) => new double?[] { s.Length, s.EndInclination, s.EndAzimuth, s.EndVerticalDepth, s.EndNorth, s.EndEast }.Count(x => x.HasValue) + s switch { CircularArcWellPathSectionSpecification x => (x.Curvature.HasValue ? 1 : 0) + (x.StartToolface.HasValue ? 1 : 0), ConstantBuildAndTurnWellPathSectionSpecification x => (x.BuildRate.HasValue ? 1 : 0) + (x.TurnRate.HasValue ? 1 : 0), ConstantCurvatureAndToolfaceWellPathSectionSpecification x => (x.Curvature.HasValue ? 1 : 0) + (x.Toolface.HasValue ? 1 : 0), _ => 0 };
}
