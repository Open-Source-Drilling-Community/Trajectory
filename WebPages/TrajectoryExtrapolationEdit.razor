    private void ApplySourceUncertaintyContextToLegacyResult()
    {
        if (interpolatedExtrapolationStations.Count == 0)
        {
            return;
        }

        foreach (SurveyStation station in interpolatedExtrapolationStations)
        {
            station.SurveyTool ??= sourceLastDefinedSurveyTool;
        }

        SurveyStation first = interpolatedExtrapolationStations
            .OrderBy(station => station.MD ?? station.Abscissa ?? double.MaxValue)
            .First();
        double? firstMd = first.MD ?? first.Abscissa;
        double? sourceMd = sourceLastSurveyStation?.MD ?? sourceLastSurveyStation?.Abscissa;
        if (first.Covariance == null && sourceLastSurveyStation?.Covariance != null &&
            firstMd.HasValue && sourceMd.HasValue &&
            Math.Abs(firstMd.Value - sourceMd.Value) <= 1e-8 * Math.Max(1.0, Math.Abs(sourceMd.Value)))
        {
            first.Covariance = sourceLastSurveyStation.Covariance;
            first.Bias = sourceLastSurveyStation.Bias;
            first.EigenValues = sourceLastSurveyStation.EigenValues;
            first.EigenVectors = sourceLastSurveyStation.EigenVectors;
        }
    }

