    private async Task LoadReconnectReferenceTrajectoryAsync(Guid trajectoryId)
    {
        reconnectReferenceStations.Clear();
        reconnectEllipseResults = [];
        reconnectEllipseCalculation = null;
        reconnectEllipsePlotData.Clear();
        relatedEllipseCalculationVersion++;
        UpdatePlots();
        if (trajectoryId == Guid.Empty)
        {
            return;
        }

        try
        {
            int chunkCount = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkCountAsync(trajectoryId);
            for (int chunkIndex = 0; chunkIndex < chunkCount; chunkIndex++)
            {
                SurveyStationChunk chunk = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkAsync(trajectoryId, chunkIndex);
                if (chunk.SurveyStationList is { Count: > 0 })
                {
                    reconnectReferenceStations.AddRange(chunk.SurveyStationList);
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to load reconnect trajectory {TrajectoryId} for plotting", trajectoryId);
            Snackbar.Add("The reconnect trajectory could not be loaded for plotting.", Severity.Warning);
        }

        UpdatePlots();
        await InvokeAsync(StateHasChanged);
    }

