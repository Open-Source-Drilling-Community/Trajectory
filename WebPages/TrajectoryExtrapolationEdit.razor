    private List<int> ThreeDModeFlagList => CombineMany([plotModeFlagList, .. EllipsePlotDataSets.Select(data => data.PerpendicularModeFlagList)]);
    private List<string> ThreeDColorList => CombineMany([plotColorList, .. EllipsePlotDataSets.Select(data => data.PerpendicularColorList)]);
    private List<int?> ThreeDMarkerSizeList => CombineMany([Enumerable.Repeat<int?>(null, plotNameList.Count), .. EllipsePlotDataSets.Select(data => data.PerpendicularMarkerSizeList)]);
    private List<bool> ThreeDShowLegendList => CombineMany([Enumerable.Repeat(true, plotNameList.Count), .. EllipsePlotDataSets.Select(data => data.PerpendicularShowLegendList)]);
    private List<List<object>> ThreeDNorthValuesList => CombineMany([plotNorthValuesList, .. EllipsePlotDataSets.Select(data => data.PerpendicularNorthValuesList)]);
    private List<List<object>> ThreeDEastValuesList => CombineMany([plotEastValuesList, .. EllipsePlotDataSets.Select(data => data.PerpendicularEastValuesList)]);
    private List<List<object>> ThreeDTvdValuesList => CombineMany([plotTvdValuesList, .. EllipsePlotDataSets.Select(data => data.PerpendicularTvdValuesList)]);

    private static List<T> CombineMany<T>(IEnumerable<IEnumerable<T>> sequences) => sequences.SelectMany(sequence => sequence).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Task<TrajectoryReferenceDataSnapshot> referenceDataTask = ReferenceData.GetSnapshotAsync();
            Task<List<TrajectoryLight>> trajectoryTask = Api.ClientTrajectory.GetAllTrajectoryLightAsync();
            Task<List<SurveyRunLight>> surveyRunTask = Api.ClientTrajectory.GetAllSurveyRunLightAsync();
            await Task.WhenAll(referenceDataTask, trajectoryTask, surveyRunTask);

            TrajectoryReferenceDataSnapshot referenceData = await referenceDataTask;
            fields = referenceData.Fields.ToList();
            clusters = referenceData.Clusters.ToList();
            wells = referenceData.Wells.ToList();
            wellBores = referenceData.WellBores.ToList();
            rigs = referenceData.Rigs.ToList();
            trajectories = (await trajectoryTask).OrderBy(x => x.Name).ToList();
            surveyRuns = (await surveyRunTask).OrderBy(x => x.Name).ToList();
            if (CaseId is Guid id)
            {
                value = await Api.ClientTrajectory.GetTrajectoryExtrapolationCaseByIdAsync(id, false);
                InitializeSourceHierarchy();
                sourceReferenceDate = await ResolveSourceTrajectoryDateAsync(SelectedSourceTrajectoryId);
                await UpdateSourceReferenceValuesAsync();
                await LoadSourceLastSurveyStationAsync(SelectedSourceTrajectoryId);
                if (value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect)
                {
                    InitializeReconnectHierarchy();
                    await LoadReconnectReferenceTrajectoryAsync(reconnect.ReferenceTrajectoryID);
                }
                if (value.CalculationState is CalculationState.Queued or CalculationState.Running) _ = PollAsync();
                else await LoadSurveyStationsAsync();
            }
        }
        catch (Exception ex) { logger.LogError(ex, "Unable to load trajectory extrapolation editor"); Snackbar.Add("Unable to load the extrapolation.", Severity.Error); }
    }

    private static TrajectoryExtrapolationCase NewCase() => new() { MetaInfo = PseudoConstructors.ConstructMetaInfo(), Name = "New extrapolation", InterpolationInterval = 10.0, Mode = TrajectoryExtrapolationMode.FixedLength, CalculationState = CalculationState.NotCalculated, Specification = new FixedLengthExtrapolationSpecification { Length = 30, ExtensionType = FixedLengthExtrapolationType.Straight }, SolvedSectionList = [], SurveyStationList = [] };
    private Guid? SelectedSourceTrajectoryId => value.SourceTrajectoryID == Guid.Empty ? null : value.SourceTrajectoryID;
    private Guid? SelectedReconnectTrajectoryId => value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect &&
        reconnect.ReferenceTrajectoryID != Guid.Empty
            ? reconnect.ReferenceTrajectoryID
            : null;
    private string SourceTrajectoryName => trajectories.FirstOrDefault(item => item.MetaInfo.ID == value.SourceTrajectoryID)?.Name ?? "Source trajectory";
    private string ReconnectTrajectoryName => value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect
        ? trajectories.FirstOrDefault(item => item.MetaInfo.ID == reconnect.ReferenceTrajectoryID)?.Name ?? "Reconnect trajectory"
        : "Reconnect trajectory";

    private void InitializeSourceHierarchy()
    {
        TrajectoryLight? source = trajectories.FirstOrDefault(item => item.MetaInfo?.ID == value.SourceTrajectoryID);
        sourceFieldId = source?.FieldID;
        Cluster? sourceCluster = source?.ClusterID is Guid clusterId
            ? clusters.FirstOrDefault(item => item.MetaInfo?.ID == clusterId)
            : null;
        sourceClusterId = sourceCluster?.IsSingleWell == false ? sourceCluster.MetaInfo.ID : null;
        sourceWellId = source?.WellID;
        sourceWellBoreId = source?.WellBoreID == Guid.Empty ? null : source?.WellBoreID;
    }

    private void InitializeReconnectHierarchy()
    {
        TrajectoryLight? reference = trajectories.FirstOrDefault(item => item.MetaInfo?.ID == SelectedReconnectTrajectoryId);
        reconnectFieldId = reference?.FieldID;
        Cluster? referenceCluster = reference?.ClusterID is Guid clusterId
            ? clusters.FirstOrDefault(item => item.MetaInfo?.ID == clusterId)
            : null;
        reconnectClusterId = referenceCluster?.IsSingleWell == false ? referenceCluster.MetaInfo.ID : null;
        reconnectWellId = reference?.WellID;
        reconnectWellBoreId = reference?.WellBoreID == Guid.Empty ? null : reference?.WellBoreID;
    }

    private async Task OnSourceFieldChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceFieldId = id;
        sourceClusterId = null;
        sourceWellId = null;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceClusterChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceClusterId = id;
        sourceWellId = null;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
        value.SourceTrajectoryID = Guid.Empty;
        await UpdateSourceReferenceValuesAsync();
    }

    private async Task OnSourceWellChanged(Guid? id)
    {
        ClearSourceLastSurveyStation();
        sourceWellId = id;
        sourceWellBoreId = null;
        selectedRigJobId = null;
        sourceReferenceDate = null;
