    private async Task SaveAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value.Name) || value.SourceTrajectoryID == Guid.Empty) { Snackbar.Add("Name and source trajectory are required.", Severity.Warning); return; }
            if (value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnectSelection &&
                (reconnectSelection.ReferenceTrajectoryID == Guid.Empty || reconnectSelection.ReferenceTrajectoryID == value.SourceTrajectoryID))
            {
                Snackbar.Add("Select a different calculated trajectory to reconnect to.", Severity.Warning);
                return;
            }
            if (value.Specification is GeosteeringTrajectoryExtrapolationSpecification geosteering)
            {
                // The editor intentionally uses the minimum-rotation solution. Retain the serialized
                // property for compatibility with existing cases and API clients, but never preserve a
                // previously stored non-zero advanced branch when saving from this simplified editor.
                geosteering.AzimuthBranch = 0;
            }
            if (value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect)
            {
                // The standard editor exposes the minimum-rotation solution. Preserve the property
                // in the wire contract for existing advanced clients while normalizing UI saves.
                reconnect.AzimuthBranch = 0;
            }
            DateTimeOffset? expected = value.LastModificationDate;
            if (CaseId is Guid id) value = await Api.ClientTrajectory.PutTrajectoryExtrapolationCaseByIdAsync(id, ConcurrencyToken.Require(expected), value);
            else { value.MetaInfo.ID = value.MetaInfo.ID == Guid.Empty ? Guid.NewGuid() : value.MetaInfo.ID; value = await Api.ClientTrajectory.PostTrajectoryExtrapolationCaseAsync(value); CaseId = value.MetaInfo.ID; }
            Snackbar.Add("Extrapolation queued.", Severity.Success);
            _ = PollAsync();
        }
        catch (ApiException ex) { logger.LogError(ex, "Unable to save trajectory extrapolation"); Snackbar.Add(ex.Response ?? ex.Message, Severity.Error); }
    }

    private async Task PollAsync()
    {
        if (CaseId is not Guid persistedCaseId) return;
        for (int i = 0; i < 120; i++)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            value = await Api.ClientTrajectory.GetTrajectoryExtrapolationCaseByIdAsync(persistedCaseId, false);
            await InvokeAsync(StateHasChanged);
            if (value.CalculationState is not (CalculationState.Queued or CalculationState.Running)) { await LoadSurveyStationsAsync(); return; }
        }
    }

    private async Task LoadSurveyStationsAsync()
    {
        stationCount = 0;
        interpolatedExtrapolationStations.Clear();
        extrapolationEllipseResults = [];
        extrapolationEllipseCalculation = null;
        extrapolationEllipsePlotData.Clear();
        sourceEllipseResults = [];
        sourceEllipseCalculation = null;
        sourceEllipsePlotData.Clear();
        reconnectEllipseResults = [];
        reconnectEllipseCalculation = null;
        reconnectEllipsePlotData.Clear();
        relatedEllipseCalculationVersion++;
        UpdatePlots();
        loadedSurveyStationChunkCount = 0;
        totalSurveyStationChunkCount = 0;
        if (CaseId is not Guid persistedCaseId || value.CalculationState != CalculationState.Completed) return;
        isLoadingSurveyStations = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            totalSurveyStationChunkCount = await Api.ClientTrajectory.GetTrajectoryExtrapolationSurveyStationChunkCountAsync(persistedCaseId);
            for (int i = 0; i < totalSurveyStationChunkCount; i++)
            {
                SurveyStationChunk chunk = await Api.ClientTrajectory.GetTrajectoryExtrapolationSurveyStationChunkAsync(persistedCaseId, i);
                if (chunk.SurveyStationList is { Count: > 0 })
                {
                    interpolatedExtrapolationStations.AddRange(chunk.SurveyStationList);
                }
                stationCount += chunk.StationCount;
                loadedSurveyStationChunkCount = i + 1;
                await InvokeAsync(StateHasChanged);
            }
            ApplySourceUncertaintyContextToLegacyResult();
            UpdatePlots();
        }
        finally
        {
            isLoadingSurveyStations = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdatePlots()
    {
        VerticalSectionCurtain? curtain = ResolveVerticalSectionCurtain();
        List<Trajectory> plottedTrajectories = [];
        if (sourceUncertaintyHistory.Count > 1)
        {
            plottedTrajectories.Add(new Trajectory
            {
                Name = $"{SourceTrajectoryName} (source)",
                SurveyStationList = ProjectOntoVerticalSectionCurtain(sourceUncertaintyHistory, curtain)
            });
        }
        if (interpolatedExtrapolationStations.Count > 1)
        {
            plottedTrajectories.Add(new Trajectory
            {
                Name = $"{value.Name} (extrapolated)",
                SurveyStationList = ProjectOntoVerticalSectionCurtain(interpolatedExtrapolationStations, curtain)
            });
        }
        if (value.Specification is ReconnectTrajectoryExtrapolationSpecification && reconnectReferenceStations.Count > 1)
        {
            plottedTrajectories.Add(new Trajectory
            {
                Name = $"{ReconnectTrajectoryName} (reconnect target)",
                SurveyStationList = ProjectOntoVerticalSectionCurtain(reconnectReferenceStations, curtain)
            });
        }

        DataUtils.UpdatePlots(
            plotNameList,
            plotModeFlagList,
            plotColorList,
            plotNorthValuesList,
            plotEastValuesList,
            plotTvdValuesList,
            plotVerticalSectionValuesList,
            plottedTrajectories);
        for (int index = 0; index < plotNameList.Count; index++)
        {
            plotColorList[index] = plotNameList[index].EndsWith("(source)", StringComparison.Ordinal)
                ? "blue"
                : plotNameList[index].EndsWith("(extrapolated)", StringComparison.Ordinal)
                    ? "red"
                    : "green";
        }

        UpdatePlotBounds();
        UpdateAllUncertaintyPlotData();
    }

    private VerticalSectionCurtain? ResolveVerticalSectionCurtain()
    {
        List<SurveyStation> definingStations = sourceUncertaintyHistory
            .Concat(interpolatedExtrapolationStations)
            .Where(station => (station.X ?? station.RiemannianNorth).HasValue &&
                              (station.Y ?? station.RiemannianEast).HasValue)
            .ToList();
        if (definingStations.Count == 0)
        {
            return null;
        }

        SurveyStation origin = definingStations[0];
        SurveyStation end = definingStations[^1];
        double originNorth = (origin.X ?? origin.RiemannianNorth)!.Value;
        double originEast = (origin.Y ?? origin.RiemannianEast)!.Value;
        double deltaNorth = (end.X ?? end.RiemannianNorth)!.Value - originNorth;
        double deltaEast = (end.Y ?? end.RiemannianEast)!.Value - originEast;
        double horizontalLength = Math.Sqrt(deltaNorth * deltaNorth + deltaEast * deltaEast);
        double directionNorth;
        double directionEast;
        if (horizontalLength > 1e-9)
        {
            directionNorth = deltaNorth / horizontalLength;
            directionEast = deltaEast / horizontalLength;
        }
        else
        {
            double azimuth = end.Azimuth ?? origin.Azimuth ?? 0.0;
            directionNorth = Math.Cos(azimuth);
            directionEast = Math.Sin(azimuth);
        }

        double originVerticalSection = origin.VerticalSection ?? 0.0;
        if (end.VerticalSection is double endVerticalSection && endVerticalSection < originVerticalSection)
        {
            directionNorth = -directionNorth;
            directionEast = -directionEast;
        }
        return new VerticalSectionCurtain(
            originNorth, originEast, originVerticalSection, directionNorth, directionEast);
    }

    private static List<SurveyStation> ProjectOntoVerticalSectionCurtain(
        IEnumerable<SurveyStation> stations,
        VerticalSectionCurtain? curtain)
    {
        if (curtain == null)
        {
            return stations.ToList();
        }

        return stations.Select(station =>
        {
            double? north = station.X ?? station.RiemannianNorth;
            double? east = station.Y ?? station.RiemannianEast;
            return new SurveyStation
            {
                MD = station.MD,
                Abscissa = station.Abscissa,
                Inclination = station.Inclination,
                Azimuth = station.Azimuth,
                TVD = station.TVD ?? station.Z,
                Z = station.Z ?? station.TVD,
                RiemannianNorth = north,
                RiemannianEast = east,
                X = north,
                Y = east,
                Curvature = station.Curvature,
                Toolface = station.Toolface,
                BUR = station.BUR,
                TUR = station.TUR,
                VerticalSection = north.HasValue && east.HasValue
                    ? curtain.Value.Project(north.Value, east.Value)
                    : station.VerticalSection,
                Annotation = station.Annotation,
                BoreholeRadius = station.BoreholeRadius
            };
        }).ToList();
    }

    private async Task OnExtrapolationEllipseResultsChanged(ICollection<SurveyStationEllipseResult> results)
    {
        extrapolationEllipseResults = results?.ToList() ?? [];
        extrapolationEllipseCalculation = null;
        UpdateAllUncertaintyPlotData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnExtrapolationEllipseCalculationChanged(SurveyStationEllipseCalculation? calculation)
    {
        extrapolationEllipseCalculation = calculation;
        if (calculation == null)
        {
            relatedEllipseCalculationVersion++;
            sourceEllipseResults = [];
            sourceEllipseCalculation = null;
            reconnectEllipseResults = [];
            reconnectEllipseCalculation = null;
        }
        else
        {
            await CalculateRelatedTrajectoryEllipsesAsync(calculation.ConfidenceFactor);
        }
        UpdateAllUncertaintyPlotData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CalculateRelatedTrajectoryEllipsesAsync(double confidenceFactor)
    {
        int calculationVersion = ++relatedEllipseCalculationVersion;
        Task<SurveyStationEllipseCalculation?> sourceTask = RequestTrajectoryEllipseCalculationAsync(
            value.SourceTrajectoryID,
            sourceUncertaintyHistory,
            confidenceFactor,
            $"{SourceTrajectoryName} uncertainty ellipses",
            "source");

        Guid reconnectTrajectoryId = value.Specification is ReconnectTrajectoryExtrapolationSpecification reconnect
            ? reconnect.ReferenceTrajectoryID
            : Guid.Empty;
        Task<SurveyStationEllipseCalculation?> reconnectTask = RequestTrajectoryEllipseCalculationAsync(
            reconnectTrajectoryId,
            reconnectReferenceStations,
            confidenceFactor,
            $"{ReconnectTrajectoryName} uncertainty ellipses",
            "reconnect-target");

        await Task.WhenAll(sourceTask, reconnectTask);
        if (calculationVersion != relatedEllipseCalculationVersion)
        {
            return;
        }

        sourceEllipseCalculation = await sourceTask;
        sourceEllipseResults = sourceEllipseCalculation?.SurveyStationEllipseResultList?.ToList() ?? [];
        reconnectEllipseCalculation = await reconnectTask;
        reconnectEllipseResults = reconnectEllipseCalculation?.SurveyStationEllipseResultList?.ToList() ?? [];
    }

    private async Task<SurveyStationEllipseCalculation?> RequestTrajectoryEllipseCalculationAsync(
        Guid trajectoryId,
        ICollection<SurveyStation> stations,
        double confidenceFactor,
        string calculationName,
        string trajectoryRole)
    {
        if (trajectoryId == Guid.Empty || stations.Count == 0)
        {
            return null;
        }

        try
        {
            SurveyStationEllipseCalculation request = new()
            {
                MetaInfo = PseudoConstructors.ConstructMetaInfo(),
                Name = calculationName,
                Description = string.Empty,
                CreationDate = DateTimeOffset.UtcNow,
                LastModificationDate = DateTimeOffset.UtcNow,
                ConfidenceFactor = confidenceFactor,
                SurveyStationList = stations.ToList()
            };
            return await Api.ClientTrajectory.PostTrajectorySurveyStationEllipseCalculationAsync(trajectoryId, request);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to calculate {TrajectoryRole} uncertainty ellipses for trajectory {TrajectoryId}",
                trajectoryRole, trajectoryId);
            Snackbar.Add($"Unable to calculate the {trajectoryRole} uncertainty ellipses.", Severity.Warning);
            return null;
        }
    }

    private void UpdateAllUncertaintyPlotData()
    {
        VerticalSectionCurtain? curtain = ResolveVerticalSectionCurtain();
        UpdateUncertaintyPlotData(ProjectOntoVerticalSectionCurtain(sourceUncertaintyHistory, curtain), sourceEllipseResults, sourceEllipseCalculation,
            sourceEllipsePlotData, "Source", "blue", curtain);
        UpdateUncertaintyPlotData(ProjectOntoVerticalSectionCurtain(interpolatedExtrapolationStations, curtain), extrapolationEllipseResults,
            extrapolationEllipseCalculation, extrapolationEllipsePlotData, "Extrapolated", "red",
            curtain, restrictExtremePathsToStationInterval: true);
        UpdateUncertaintyPlotData(ProjectOntoVerticalSectionCurtain(reconnectReferenceStations, curtain), reconnectEllipseResults, reconnectEllipseCalculation,
            reconnectEllipsePlotData, "Reconnect target", "green", curtain);
    }

    private void UpdateUncertaintyPlotData(
        ICollection<SurveyStation> stations,
        ICollection<SurveyStationEllipseResult> results,
        SurveyStationEllipseCalculation? calculation,
        EllipsePlotData plotData,
        string label,
        string color,
        VerticalSectionCurtain? curtain,
        bool restrictExtremePathsToStationInterval = false)
    {
        DataUtils.UpdateEllipsePlots(stations.ToList(), results.ToList(), plotData, maxDisplayedUncertaintiesInPlots);
        double? minimumAbscissa = restrictExtremePathsToStationInterval
            ? stations.Select(station => station.MD ?? station.Abscissa).Where(value => value.HasValue).Min()
            : null;
        double? maximumAbscissa = restrictExtremePathsToStationInterval
            ? stations.Select(station => station.MD ?? station.Abscissa).Where(value => value.HasValue).Max()
            : null;
        DataUtils.AddExtremeTvdPathPlots(calculation, plotData, minimumAbscissa, maximumAbscissa);
        ProjectExtremeTvdPathsOntoCurtain(plotData, curtain);
        StyleEllipsePlotData(plotData, label, color);
    }

    private static void ProjectExtremeTvdPathsOntoCurtain(EllipsePlotData plotData, VerticalSectionCurtain? curtain)
    {
        if (curtain == null)
        {
            return;
        }

        for (int index = 0; index < plotData.VerticalNameList.Count; index++)
        {
            string name = plotData.VerticalNameList[index];
            if (name is not ("Highest TVD path" or "Lowest TVD path"))
            {
                continue;
            }

            int horizontalIndex = plotData.HorizontalNameList.FindIndex(horizontalName => horizontalName == name);
            if (horizontalIndex < 0 || horizontalIndex >= plotData.HorizontalNorthValuesList.Count ||
                horizontalIndex >= plotData.HorizontalEastValuesList.Count)
            {
                continue;
            }
            List<object> northValues = plotData.HorizontalNorthValuesList[horizontalIndex];
            List<object> eastValues = plotData.HorizontalEastValuesList[horizontalIndex];
            if (northValues.Count != eastValues.Count)
            {
                continue;
            }
            plotData.VerticalSectionValuesList[index] = northValues.Zip(eastValues, (north, east) =>
                north is double northValue && east is double eastValue
                    ? (object)curtain.Value.Project(northValue, eastValue)
                    : null!).ToList();
        }
    }

    private static void StyleEllipsePlotData(EllipsePlotData plotData, string label, string color)
    {
        Style(plotData.HorizontalNameList, plotData.HorizontalColorList, label, color);
        Style(plotData.VerticalNameList, plotData.VerticalColorList, label, color);
        Style(plotData.PerpendicularNameList, plotData.PerpendicularColorList, label, color);

        static void Style(List<string> names, List<string> colors, string traceLabel, string traceColor)
        {
            for (int index = 0; index < names.Count; index++)
            {
                names[index] = names[index] switch
                {
                    "Highest TVD path" => $"{traceLabel} highest TVD path",
                    "Lowest TVD path" => $"{traceLabel} lowest TVD path",
                    _ => $"{traceLabel} uncertainty"
                };
                colors[index] = traceColor;
            }
        }
    }

    private void UpdatePlotBounds()
    {
        List<SurveyStation> stations = ProjectOntoVerticalSectionCurtain(
            interpolatedExtrapolationStations, ResolveVerticalSectionCurtain());
        double fallbackSpan = Math.Max(1.0, new[]
        {
            CoordinateSpan(stations, station => station.X ?? station.RiemannianNorth),
            CoordinateSpan(stations, station => station.Y ?? station.RiemannianEast),
            CoordinateSpan(stations, station => station.Z ?? station.TVD),
            CoordinateSpan(stations, station => station.VerticalSection ?? station.Abscissa ?? station.MD)
        }.Max());
        northPlotBounds = CalculatePlotBounds(stations, station => station.X ?? station.RiemannianNorth, fallbackSpan);
        eastPlotBounds = CalculatePlotBounds(stations, station => station.Y ?? station.RiemannianEast, fallbackSpan);
        tvdPlotBounds = CalculatePlotBounds(stations, station => station.Z ?? station.TVD, fallbackSpan);
        verticalSectionPlotBounds = CalculatePlotBounds(stations,
            station => station.VerticalSection ?? station.Abscissa ?? station.MD, fallbackSpan);
    }

    private static double CoordinateSpan(IEnumerable<SurveyStation> stations, Func<SurveyStation, double?> selector)
    {
        List<double> values = stations.Select(selector).Where(value => value.HasValue).Select(value => value!.Value).ToList();
        return values.Count == 0 ? 0.0 : values.Max() - values.Min();
    }

    private static PlotAxisBounds CalculatePlotBounds(
        IEnumerable<SurveyStation> stations,
        Func<SurveyStation, double?> selector,
        double fallbackSpan)
    {
        List<double> values = stations.Select(selector).Where(value => value.HasValue).Select(value => value!.Value).ToList();
        if (values.Count == 0)
        {
            return PlotAxisBounds.Empty;
        }

        double minimum = values.Min();
        double maximum = values.Max();
        double padding = maximum > minimum ? 0.05 * (maximum - minimum) : 0.05 * fallbackSpan;
        return new PlotAxisBounds(minimum - padding, maximum + padding);
    }

    private Task OnMaxDisplayedUncertaintiesInPlotsChanged(int value)
    {
        maxDisplayedUncertaintiesInPlots = Math.Max(1, value);
        UpdateAllUncertaintyPlotData();
        return InvokeAsync(StateHasChanged);
    }

    private Task OnFocusPlotsOnExtrapolationChanged(bool value)
    {
        focusPlotsOnExtrapolation = value;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnPlotExpandedChanged(bool expanded)
    {
        if (!expanded) return;
        await Task.Delay(50);
        await InvokeAsync(StateHasChanged);
    }

    private void AddSection() { if (value.Specification is WellPathExtrapolationSpecification p) p.SectionList.Add(new CircularArcWellPathSectionSpecification { SectionID = Guid.NewGuid(), Length = 30, Curvature = 0, StartToolface = 0 }); }
    private void RemoveSection(Guid id) { if (value.Specification is WellPathExtrapolationSpecification p) p.SectionList.RemoveAll(x => x.SectionID == id); }
    private static ExtrapolationCurveType CurveType(WellPathSectionSpecification section) => section switch { CircularArcWellPathSectionSpecification => ExtrapolationCurveType.CircularArc, ConstantBuildAndTurnWellPathSectionSpecification => ExtrapolationCurveType.ConstantBuildAndTurn, _ => ExtrapolationCurveType.ConstantCurvatureAndToolface };
    private void ChangeCurve(WellPathSectionSpecification old, ExtrapolationCurveType type)
    {
        if (value.Specification is not WellPathExtrapolationSpecification path) return;
        WellPathSectionSpecification replacement = type switch { ExtrapolationCurveType.CircularArc => new CircularArcWellPathSectionSpecification(), ExtrapolationCurveType.ConstantBuildAndTurn => new ConstantBuildAndTurnWellPathSectionSpecification(), _ => new ConstantCurvatureAndToolfaceWellPathSectionSpecification() };
        replacement.SectionID = old.SectionID; replacement.Length = old.Length; replacement.EndInclination = old.EndInclination; replacement.EndAzimuth = old.EndAzimuth; replacement.EndVerticalDepth = old.EndVerticalDepth; replacement.EndNorth = old.EndNorth; replacement.EndEast = old.EndEast;
        path.SectionList[path.SectionList.IndexOf(old)] = replacement;
    }
    private int ConstraintCount => value.Specification is not WellPathExtrapolationSpecification p ? 0 : p.SectionList.Sum(Count);
    private static int Count(WellPathSectionSpecification s) => new double?[] { s.Length, s.EndInclination, s.EndAzimuth, s.EndVerticalDepth, s.EndNorth, s.EndEast }.Count(x => x.HasValue) + s switch { CircularArcWellPathSectionSpecification x => (x.Curvature.HasValue ? 1 : 0) + (x.StartToolface.HasValue ? 1 : 0), ConstantBuildAndTurnWellPathSectionSpecification x => (x.BuildRate.HasValue ? 1 : 0) + (x.TurnRate.HasValue ? 1 : 0), ConstantCurvatureAndToolfaceWellPathSectionSpecification x => (x.Curvature.HasValue ? 1 : 0) + (x.Toolface.HasValue ? 1 : 0), _ => 0 };
    private readonly record struct PlotAxisBounds(double? Minimum, double? Maximum)
    {
        public static PlotAxisBounds Empty => new(null, null);
    }
    private readonly record struct VerticalSectionCurtain(
        double OriginNorth,
        double OriginEast,
        double OriginVerticalSection,
        double DirectionNorth,
        double DirectionEast)
    {
        public double Project(double north, double east) => OriginVerticalSection +
            (north - OriginNorth) * DirectionNorth +
            (east - OriginEast) * DirectionEast;
    }
}
