@inject ILogger<TargetLandingEdit> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData
@implements IDisposable

<MudText Typo="Typo.h6" Class="mt-4 mb-3">Target Landing</MudText>
<MudStack Row="true" Class="mb-4">
    <MudButton Color="Color.Success" OnClick="SaveAsync" Disabled="@(saving || IsCalculationActive)">@(saving || IsCalculationActive ? "Calculating..." : "Save and calculate")</MudButton>
    @if (value.CreationDate != null)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="SaveAsAsync" Disabled="@(saving || IsCalculationActive)">Save as</MudButton>
    }
    <MudButton Color="Color.Error" OnClick="CloseAsync">Close</MudButton>
</MudStack>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Info" /> }
@if (loadingResult) { <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-2" /><MudText Typo="Typo.caption">Loading calculated boundary paths…</MudText> }
@if (value.CalculationState is CalculationState.Queued or CalculationState.Running)
{
    <MudPaper Class="pa-3 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle2">@value.CalculationState: @value.CalculationMessage</MudText>
        <MudProgressLinear Class="mt-2" Value="@(100 * value.CalculationProgress)" Color="Color.Info" />
        <MudText Typo="Typo.caption">@($"{100 * value.CalculationProgress:F0}% complete — calculation continues on the server if this page is closed.")</MudText>
    </MudPaper>
}

<MudGrid>
    <MudItem xs="12" md="3"><MudTextField @bind-Value="value.Name" Label="Name" Required="true" /></MudItem>
    <MudItem xs="12" md="5"><MudTextField @bind-Value="value.Description" Label="Description" /></MudItem>
</MudGrid>

<MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Source trajectory</MudText>
<TrajectoryResourceFilter Fields="@fields" Clusters="@clusters" Wells="@wells" WellBores="@wellBores" Trajectories="@trajectories"
                          ResourceKind="TrajectoryResourceFilterKind.Trajectory" ResourceRequired="true" CompletedTrajectoriesOnly="true"
                          FieldId="@fieldId" FieldIdChanged="SetField" ClusterId="@clusterId" ClusterIdChanged="SetCluster"
                          WellId="@wellId" WellIdChanged="SetWell" WellBoreId="@wellBoreId" WellBoreIdChanged="SetWellBore"
                          ResourceId="@SourceTrajectoryId" ResourceIdChanged="SetTrajectory" />
<MudGrid Class="mt-2">
    <MudItem xs="12" md="4">
        <RigJobSelector WellBores="@wellBores" Rigs="@rigs" WellBoreId="@wellBoreId"
                        ReferenceDate="@sourceReferenceDate" SelectedRigJobId="@selectedRigJobId"
                        SelectedRigJobIdChanged="OnRigJobIdChanged" SelectionChanged="OnRigJobChanged" />
    </MudItem>
</MudGrid>

<MudGrid Class="mt-3">
    <MudItem xs="12" md="3"><MudSelect T="TargetLandingTargetType" @bind-Value="value.TargetType" Label="Target type">@foreach (var item in Enum.GetValues<TargetLandingTargetType>()) { <MudSelectItem Value="item">@item</MudSelectItem> }</MudSelect></MudItem>
    <MudItem xs="12" md="3"><MudSelect T="ExtrapolationCurveType" @bind-Value="value.CurveType" Label="Landing curve">@foreach (var item in Enum.GetValues<ExtrapolationCurveType>()) { <MudSelectItem Value="item">@item</MudSelectItem> }</MudSelect></MudItem>
    <MudItem xs="12" md="3"><MudSelect T="TargetLandingAttitudeMode" @bind-Value="value.AttitudeMode" Label="Landing attitude">@foreach (var item in Enum.GetValues<TargetLandingAttitudeMode>()) { <MudSelectItem Value="item">@(item == TargetLandingAttitudeMode.PerpendicularToTargetPlane ? "Land perpendicular to target plane" : "Free landing attitude")</MudSelectItem> }</MudSelect></MudItem>
</MudGrid>
<MudGrid>
    <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Lead length" QuantityName="DepthDrilling" SIValue="@value.LeadLength" SIValueChanged="x => value.LeadLength = x" /></MudItem>
    <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Confidence factor" QuantityName="ProportionStandard" SIValue="@value.ConfidenceFactor" SIValueChanged="x => value.ConfidenceFactor = Math.Clamp(x, 0.000001, 0.999)" /></MudItem>
    <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Maximum Landing Curvature" QuantityName="CurvatureDrilling" SIValueNullable="@value.MaximumLandingCurvature" SIValueNullableChanged="x => value.MaximumLandingCurvature = x" /></MudItem>
</MudGrid>

@if (referenceValuesReady)
{
<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.subtitle1">Target plane origin and forward normal</MudText>
    <MudGrid>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="North" QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.North" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.RiemannianNorth" SIValueNullableChanged="SetNorth" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="East" QuantityName="PositionDrilling" DrillingSignalReference="DrillingSignalReferenceType.Position" PositionDirection="PositionDirectionType.East" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.RiemannianEast" SIValueNullableChanged="SetEast" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Latitude" QuantityName="PlaneAngleGeodesic" DrillingSignalReference="DrillingSignalReferenceType.Geodetic" PositionDirection="PositionDirectionType.North" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.Latitude" SIValueNullableChanged="SetLatitude" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Longitude" QuantityName="PlaneAngleGeodesic" DrillingSignalReference="DrillingSignalReferenceType.Geodetic" PositionDirection="PositionDirectionType.East" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.Longitude" SIValueNullableChanged="SetLongitude" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Target TVD" QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.TVD" SIValueNullableChanged="SetTargetTvd" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Normal inclination" QuantityName="PlaneAngleDrilling" SIValueNullable="@Plane.Inclination" SIValueNullableChanged="x => Plane.Inclination = x" /></MudItem>
        <MudItem xs="12" md="3"><StableMudInputWithUnitAdornment QuantityLabel="Normal azimuth" QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" ReferenceSourceVersion="@referenceSourceVersion" SIValueNullable="@Plane.Azimuth" SIValueNullableChanged="x => Plane.Azimuth = x" /></MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center"><MudText Typo="Typo.subtitle1">Convex target polygon</MudText><MudButton Color="Color.Success" OnClick="AddVertex">Add vertex</MudButton></MudStack>
    <MudText Typo="Typo.body2" Class="mb-2">Plane Y is the projection of vertical upward into the target plane; Plane X is perpendicular to Plane Y and the forward plane normal. For a horizontal target plane, Plane X is North and Plane Y is East. The angle follows the toolface convention: zero along positive Plane Y and positive toward positive Plane X.</MudText>
    <MudTable T="TargetPlanePoint" Items="@Polygon" Dense="true" Bordered="true">
        <HeaderContent><MudTh>#</MudTh><MudTh>Plane X [@LengthUnitLabel]</MudTh><MudTh>Plane Y [@LengthUnitLabel]</MudTh><MudTh>Radial distance [@LengthUnitLabel]</MudTh><MudTh>Angle [@AngleUnitLabel]</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate><MudTd>@Polygon.IndexOf(context)</MudTd>
            <MudTd><MudInputWithUnit QuantityName="LengthStandard" SIValue="@context.X" SIValueChanged="x => SetX(context, x)" /></MudTd>
            <MudTd><MudInputWithUnit QuantityName="LengthStandard" SIValue="@context.Y" SIValueChanged="x => SetY(context, x)" /></MudTd>
            <MudTd><MudInputWithUnit QuantityName="LengthStandard" SIValue="@Radius(context)" SIValueChanged="x => SetRadius(context, x)" /></MudTd>
            <MudTd><MudInputWithUnit QuantityName="PlaneAngleDrilling" SIValue="@Angle(context)" SIValueChanged="x => SetAngle(context, x)" /></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => Polygon.Remove(context))" /></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
}

@if (value.IsStale) { <MudAlert Severity="Severity.Warning" Class="mt-4">The source trajectory has changed. Saving this case will recalculate it.</MudAlert> }
@if (referenceValuesReady && value.SampleList is { Count: > 0 })
{
    <MudText Typo="Typo.h6" Class="mt-4">Landing result</MudText>
    <MudText Typo="Typo.body2">Black: specified target. Blue: uncertainty-safe driller target. Green fill: reachable within Maximum Landing Curvature. Orange nested contours delimit samples excluded by the stored landing-solution curvature test.</MudText>
    <ScatterPlot NameList="@PlanePlotNames" ModeFlagList="@PlanePlotModes" ColorList="@PlanePlotColors"
                 FillToSelfList="@PlanePlotFill" FillColorList="@PlanePlotFillColors"
                 XValuesList="@PlanePlotX" YValuesList="@PlanePlotY" XUnit="LengthStandard" YUnit="LengthStandard"
                 XAxisTitle="Plane X" YAxisTitle="Plane Y (up)" AspectRatio="1" />
    <MudText Typo="Typo.body2" Class="mt-3">The translucent cylinder has normalized radius 1. Toolface is measured around the cylinder (zero on +Y, positive toward +X); curvature is its height. Each faint line follows the exact curve-specific controls calculated by the model from the central axis to a target-boundary solution. Circular-arc toolface is the varying local toolface, not its start/reference value. Paths contain a gap within 3° of vertical because toolface is undefined there; the valid Cartesian path is not rejected. Color identifies a continuous solution family; endpoint lines deliberately stop where the shortest valid solution switches to another branch.</MudText>
    CylinderPlotData cylinderPlot = BuildCylinderPlot();
    @if (cylinderPlot.Names.Count > 0)
    {
        <Scatter3DPlot NameList="@cylinderPlot.Names" ModeFlagList="@cylinderPlot.Modes" ColorList="@cylinderPlot.Colors" LineWidthList="@cylinderPlot.LineWidths" ShowLegendList="@cylinderPlot.ShowLegend"
                       XValuesList="@cylinderPlot.X" YValuesList="@cylinderPlot.Y" ZValuesList="@cylinderPlot.Z"
                       XUnit="Dimensionless" YUnit="Dimensionless" ZUnit="CurvatureDrilling"
                       ZAxisTitle="Curvature" XAxisMinimum="-1.1" XAxisMaximum="1.1" YAxisMinimum="-1.1" YAxisMaximum="1.1"
                       ShowUnitCylinder="true" CentralCurvatureMarker="@(value.SourceEndStation?.Curvature)" />
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">This saved result predates inclination-aware normalized curve controls. Run Save and calculate against the current Trajectory service to display the cylindrical and build/turn graphs.</MudAlert>
    }

    BuildTurnPlotData buildTurnPlot = BuildBuildTurnPlot();
    @if (buildTurnPlot.Names.Count>0)
    {
        <MudText Typo="Typo.h6" Class="mt-4">Build and turn landing controls</MudText>
        <MudText Typo="Typo.body2">Normalized length runs from the lead point at 0 to the reachable target boundary at 1. The model calculates signed build and turn directly from each solved curve; no survey-station reconstruction is used. For every perpendicular-attitude landing, the trace stops and restarts at the junction between the two sections so different section commands are not joined by a false vertical line. Paths also contain a gap within 3° of vertical, where turn rate is singular although the Cartesian path remains valid. Color identifies a continuous mapped boundary segment. A complete contour is closed; partial segments stop where the selected shortest solution switches branch, because joining or merging those segments would invent controls that were not calculated.</MudText>
        <Scatter3DPlot NameList="@buildTurnPlot.Names" ModeFlagList="@buildTurnPlot.Modes" ColorList="@buildTurnPlot.Colors" LineWidthList="@buildTurnPlot.LineWidths" ShowLegendList="@buildTurnPlot.ShowLegend"
                       XValuesList="@buildTurnPlot.X" YValuesList="@buildTurnPlot.Y" ZValuesList="@buildTurnPlot.Z"
                       XUnit="CurvatureDrilling" YUnit="Dimensionless" ZUnit="CurvatureDrilling"
                       XAxisTitle="Turn rate" YAxisTitle="Normalized length" ZAxisTitle="Build rate"
                       XAxisMinimum="@buildTurnPlot.TurnMinimum" XAxisMaximum="@buildTurnPlot.TurnMaximum"
                       YAxisMinimum="0" YAxisMaximum="1" ZAxisMinimum="@buildTurnPlot.BuildMinimum" ZAxisMaximum="@buildTurnPlot.BuildMaximum"
                       UseCubeAspect="true" />
    }

    CartesianPlotData cartesianPlot = BuildCartesianPlot();
    <MudText Typo="Typo.h6" Class="mt-4">Cartesian landing geometry</MudText>
    <MudText Typo="Typo.body2">The source trajectory is blue, the specified target boundary is black, the reachable boundary is solid green, and the lead from the final source survey to the steering start is orange. Landing-path colors identify continuous solution families, making distinct shortest-solution branches visible in NED space. Reference and lead uncertainties are perpendicular to their local well path; landing-path uncertainties are shown only at their endpoints, projected in the target plane.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-2">
        <MudSwitch T="bool" Value="@showReferencePerpendicularEllipses" ValueChanged="SetShowReferencePerpendicularEllipsesAsync" Color="Color.Primary" Label="Reference perpendicular ellipses" />
        <MudSwitch T="bool" Value="@showLeadPerpendicularEllipses" ValueChanged="SetShowLeadPerpendicularEllipsesAsync" Color="Color.Warning" Label="Lead perpendicular ellipses" />
        <MudSwitch T="bool" @bind-Value="showLandingTargetPlaneEllipses" Color="Color.Success" Label="Landing ellipses in target plane" />
    </MudStack>
    @if (loadingUncertaintyDisplay) { <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-2" /><MudText Typo="Typo.caption">Loading perpendicular uncertainty ellipses…</MudText> }
    @if (loadingCartesianSource) { <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-2" /> }
    @if (cartesianPlot.Names.Count>0)
    {
        <Scatter3DPlot ReferenceSourceVersion="@referenceSourceVersion" NameList="@cartesianPlot.Names" ModeFlagList="@cartesianPlot.Modes" ColorList="@cartesianPlot.Colors" LineWidthList="@cartesianPlot.LineWidths" ShowLegendList="@cartesianPlot.ShowLegend"
                       XValuesList="@cartesianPlot.X" YValuesList="@cartesianPlot.Y" ZValuesList="@cartesianPlot.Z"
                       XUnit="PositionDrilling" YUnit="PositionDrilling" ZUnit="DepthDrilling"
                       XAxisUsesPositionReference="true" YAxisUsesPositionReference="true" ZAxisUsesDepthReference="true"
                       XAxisPositionDirection="PositionDirectionType.North" YAxisPositionDirection="PositionDirectionType.East"
                       XAxisTitle="North" YAxisTitle="East" ZAxisTitle="TVD" ZAxisReversed="true" />
    }

    <MudText Typo="Typo.h6" Class="mt-4">Reachable target boundary commands</MudText>
    <MudTable T="BoundarySolutionRow" Items="@BoundarySolutions" Dense="true" Bordered="true" Hover="true" Style="max-height:500px;overflow:auto">
        <HeaderContent>
            <MudTh>Contour</MudTh><MudTh>Family</MudTh><MudTh>Point</MudTh>
            <MudTh>Plane X [@LengthUnitLabel]</MudTh><MudTh>Plane Y [@LengthUnitLabel]</MudTh>
            <MudTh>Landing length [@LengthUnitLabel]</MudTh><MudTh>Peak curvature [@CurvatureUnitLabel]</MudTh>
            <MudTh>@BoundaryFirstCommandLabel S1 [@BoundaryFirstCommandUnitLabel]</MudTh>
            <MudTh>@BoundarySecondCommandLabel S1 [@BoundarySecondCommandUnitLabel]</MudTh>
            @if (ShowsSecondBoundarySection)
            {
                <MudTh>@BoundaryFirstCommandLabel S2 [@BoundaryFirstCommandUnitLabel]</MudTh>
                <MudTh>@BoundarySecondCommandLabel S2 [@BoundarySecondCommandUnitLabel]</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ContourNumber</MudTd><MudTd>@context.FamilyNumber</MudTd><MudTd>@context.PointNumber</MudTd>
            <MudTd><MudSpanWithUnit QuantityName="LengthStandard" SIValue="@context.Point.X" /></MudTd>
            <MudTd><MudSpanWithUnit QuantityName="LengthStandard" SIValue="@context.Point.Y" /></MudTd>
            <MudTd><MudSpanWithUnit QuantityName="LengthStandard" SIValue="@context.Sample.TotalLandingLength" /></MudTd>
            <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@context.Sample.PeakLandingCurvature" /></MudTd>
            <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@BoundaryFirstCommand(context.Sample, 0)" /></MudTd>
            <MudTd><MudSpanWithUnit QuantityName="@BoundarySecondCommandQuantity" SIValue="@BoundarySecondCommand(context.Sample, 0)" /></MudTd>
            @if (ShowsSecondBoundarySection)
            {
                <MudTd><MudSpanWithUnit QuantityName="CurvatureDrilling" SIValue="@BoundaryFirstCommand(context.Sample, 1)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@BoundarySecondCommandQuantity" SIValue="@BoundarySecondCommand(context.Sample, 1)" /></MudTd>
            }
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter] private MudUnitAndReferenceChoiceTag? Parent { get; set; }
    [Parameter] public Guid? CaseId { get; set; }
    [Parameter] public EventCallback<TargetLandingCaseLight?> ValueChanged { get; set; }
    private TargetLandingCase value = NewCase();
    private List<Field> fields = []; private List<Cluster> clusters = []; private List<Well> wells = []; private List<WellBore> wellBores = []; private List<Rig> rigs = []; private List<TrajectoryLight> trajectories = []; private List<SurveyRunLight> surveyRuns = [];
    private List<SurveyStation> sourceTrajectoryStations = [];
    private Guid? loadedSourceTrajectoryId;
    private Guid? fieldId, clusterId, wellId, wellBoreId, selectedRigJobId; private DateTimeOffset? sourceReferenceDate; private bool loading, saving;
    private bool loadingCartesianSource, loadingResult, loadingUncertaintyDisplay, referenceValuesReady;
    private bool showReferencePerpendicularEllipses, showLeadPerpendicularEllipses, showLandingTargetPlaneEllipses;
    private SurveyStationEllipseCalculation? uncertaintyDisplay;
    private long referenceSourceVersion;
    private string? loadedEditableFingerprint;
    private TargetLandingCaseLight? persistedLight;
    private readonly CancellationTokenSource calculationPolling = new();
    private CurvilinearPoint3D Plane => value.Target.Plane;
    private string LengthUnitLabel => Parent?.GetUnitLabel("LengthStandard") ?? string.Empty;
    private string AngleUnitLabel => Parent?.GetUnitLabel("PlaneAngleDrilling") ?? string.Empty;
    private string CurvatureUnitLabel => Parent?.GetUnitLabel("CurvatureDrilling") ?? string.Empty;
    private bool BoundaryUsesBuildAndTurn => value.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn;
    private bool ShowsSecondBoundarySection => value.AttitudeMode == TargetLandingAttitudeMode.PerpendicularToTargetPlane;
    private string BoundaryFirstCommandLabel => BoundaryUsesBuildAndTurn ? "Build rate" : "Curvature";
    private string BoundarySecondCommandLabel => BoundaryUsesBuildAndTurn ? "Turn rate" : "Toolface";
    private string BoundaryFirstCommandUnitLabel => CurvatureUnitLabel;
    private string BoundarySecondCommandUnitLabel => BoundaryUsesBuildAndTurn ? CurvatureUnitLabel : AngleUnitLabel;
    private string BoundarySecondCommandQuantity => BoundaryUsesBuildAndTurn ? "CurvatureDrilling" : "PlaneAngleDrilling";
    private List<TargetPlanePoint> Polygon => value.Target.Polygon;
    private Guid? SourceTrajectoryId => value.SourceTrajectoryID == Guid.Empty ? null : value.SourceTrajectoryID;
    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            Task<TrajectoryReferenceDataSnapshot> refs = ReferenceData.GetSnapshotAsync();
            Task<TargetLandingCase>? caseTask = CaseId.HasValue ? Api.ClientTrajectory.GetTargetLandingCaseEditDataAsync(CaseId.Value) : null;
            if (caseTask != null)
            {
                value = await caseTask;
                persistedLight = ToLight(value);
                loadedEditableFingerprint = EditableFingerprint(value);
                loading = false;
                loadingResult = !IsCalculationActive;
                await InvokeAsync(StateHasChanged);
                if (IsCalculationActive) _ = MonitorExistingCalculationAsync(value.MetaInfo.ID);
                else _ = LoadDisplayDataAsync(value.MetaInfo.ID, calculationPolling.Token);
            }
            TrajectoryReferenceDataSnapshot snapshot = await refs; fields = snapshot.Fields.ToList(); clusters = snapshot.Clusters.ToList(); wells = snapshot.Wells.ToList(); wellBores = snapshot.WellBores.ToList(); rigs = snapshot.Rigs.ToList(); trajectories = snapshot.Trajectories.ToList(); surveyRuns = snapshot.SurveyRuns.ToList();
            InitializeHierarchy();
            sourceReferenceDate = await ResolveSourceTrajectoryDateAsync(SourceTrajectoryId);
            await UpdateSourceReferenceValuesAsync();
            CompleteOriginCoordinates();
        }
        catch (Exception ex) { logger.LogError(ex, "Unable to initialize target landing editor"); Snackbar.Add("Unable to load the target landing case.", Severity.Error); }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (saving) return;
        if (string.IsNullOrWhiteSpace(value.Name) || value.SourceTrajectoryID == Guid.Empty) { Snackbar.Add("Name and source trajectory are required.", Severity.Warning); return; }
        saving = true;
        try
        {
            TargetLandingCase savePayload = CreateSavePayload(value);
            TargetLandingCase? persisted = value.CreationDate == null
                ? await Api.ClientTrajectory.PostTargetLandingCaseAsync(savePayload)
                : await PutWithSafeCalculationRetryAsync(value.MetaInfo.ID, savePayload);
            if (persisted == null) return;
            value = persisted;
            persistedLight = ToLight(value);
            loadedEditableFingerprint = EditableFingerprint(value);
            Snackbar.Add("Target landing calculation queued.", Severity.Success);
            await RefreshAfterCalculationAsync(value.MetaInfo.ID, calculationPolling.Token);
        }
        catch (OperationCanceledException) when (calculationPolling.IsCancellationRequested) { }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            logger.LogWarning(ex, "Target landing case {CaseId} changed again while saving", value.MetaInfo.ID);
            Snackbar.Add("The case changed again while it was being saved. Review the latest case and retry.", Severity.Warning);
        }
        catch (Exception ex) { logger.LogError(ex, "Unable to save target landing case"); Snackbar.Add("Unable to save the target landing case.", Severity.Error); }
        finally { saving = false; }
    }
    private async Task SaveAsAsync()
    {
        if (saving || IsCalculationActive) return;
        if (value.SourceTrajectoryID == Guid.Empty) { Snackbar.Add("A source trajectory is required.", Severity.Warning); return; }
        string initialName = string.IsNullOrWhiteSpace(value.Name) ? "Target landing copy" : $"{value.Name} copy";
        string? copyName = await PromptAsync("Save target landing case as", "New case name", initialName, "Create copy");
        if (copyName == null) return;

        saving = true;
        try
        {
            TargetLandingCase copy = CreateSavePayload(value);
            copy.MetaInfo = new MetaInfo { ID = Guid.NewGuid() };
            copy.Name = copyName;
            value = await Api.ClientTrajectory.PostTargetLandingCaseAsync(copy, calculationPolling.Token);
            persistedLight = ToLight(value);
            loadedEditableFingerprint = EditableFingerprint(value);
            Snackbar.Add($"Created '{copyName}' and queued its calculation.", Severity.Success);
            await RefreshAfterCalculationAsync(value.MetaInfo.ID, calculationPolling.Token);
        }
        catch (OperationCanceledException) when (calculationPolling.IsCancellationRequested) { }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to create a copy of target landing case {CaseId}", value.MetaInfo.ID);
            Snackbar.Add("Unable to create the target landing case copy.", Severity.Error);
        }
        finally { saving = false; }
    }
    private async Task<string?> PromptAsync(string title, string label, string initialValue, string confirmText)
    {
        DialogParameters parameters = new()
        {
            { nameof(TextPromptDialog.Label), label },
            { nameof(TextPromptDialog.InitialValue), initialValue },
            { nameof(TextPromptDialog.ConfirmText), confirmText }
        };
        IDialogReference dialog = await DialogService.ShowAsync<TextPromptDialog>(
            title, parameters, TrajectoryDialogOptions.Compact);
        DialogResult? result = await dialog.Result;
        return result is { Canceled: false, Data: string text } && !string.IsNullOrWhiteSpace(text)
            ? text.Trim()
            : null;
    }
    private async Task<TargetLandingCase?> PutWithSafeCalculationRetryAsync(Guid caseId, TargetLandingCase savePayload)
    {
        try
        {
            return await Api.ClientTrajectory.PutTargetLandingCaseByIdAsync(caseId, ConcurrencyToken.Require(value.LastModificationDate), savePayload);
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            TargetLandingCase latest = await Api.ClientTrajectory.GetTargetLandingCaseEditDataAsync(caseId, calculationPolling.Token);
            bool onlyCalculationStateChanged = latest.CalculationState is CalculationState.Completed or CalculationState.Failed
                && loadedEditableFingerprint != null
                && string.Equals(EditableFingerprint(latest), loadedEditableFingerprint, StringComparison.Ordinal);
            if (!onlyCalculationStateChanged)
            {
                logger.LogWarning(ex, "Target landing case {CaseId} configuration changed after it was loaded", caseId);
                Snackbar.Add("This case was changed elsewhere. Reopen it to review the latest inputs before saving.", Severity.Warning);
                return null;
            }

            // A background calculation updates the revision when it reaches a terminal state. The editable
            // configuration is unchanged, so preserve this draft and retry once with the freshly read token.
            loadedEditableFingerprint = EditableFingerprint(latest);
            return await Api.ClientTrajectory.PutTargetLandingCaseByIdAsync(caseId, ConcurrencyToken.Require(latest.LastModificationDate), savePayload);
        }
    }
    private async Task RefreshAfterCalculationAsync(Guid caseId, CancellationToken cancellationToken)
    {
        TargetLandingCaseLight status;
        do
        {
            status = await Api.ClientTrajectory.GetTargetLandingCaseStatusAsync(caseId, cancellationToken);
            value.CalculationState = status.CalculationState;
            value.CalculationProgress = status.CalculationProgress;
            value.CalculationMessage = status.CalculationMessage;
            value.IsStale = status.IsStale;
            persistedLight = status;
            await InvokeAsync(StateHasChanged);
            if (status.CalculationState is CalculationState.Queued or CalculationState.Running)
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
        }
        while (status.CalculationState is CalculationState.Queued or CalculationState.Running);

        value = await Api.ClientTrajectory.GetTargetLandingCaseEditDataAsync(caseId, cancellationToken);
        persistedLight = ToLight(value);
        loadedEditableFingerprint = EditableFingerprint(value);
        CompleteOriginCoordinates();
        await InvokeAsync(StateHasChanged);
        if (value.CalculationState == CalculationState.Completed)
            await LoadDisplayDataAsync(caseId, cancellationToken, true);
        if (value.CalculationState == CalculationState.Completed)
            Snackbar.Add("Target landing calculation completed.", Severity.Success);
        else if (value.CalculationState == CalculationState.Failed)
            Snackbar.Add(value.CalculationMessage ?? "Target landing calculation failed.", Severity.Error);
    }
    private async Task MonitorExistingCalculationAsync(Guid caseId)
    {
        try { await RefreshAfterCalculationAsync(caseId, calculationPolling.Token); }
        catch (OperationCanceledException) when (calculationPolling.IsCancellationRequested) { }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to monitor target landing calculation");
            Snackbar.Add("Unable to refresh the target landing calculation progress.", Severity.Error);
        }
    }
    private async Task LoadDisplayDataAsync(Guid caseId, CancellationToken cancellationToken, bool forceSourceReload=false)
    {
        loadingResult = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            TargetLandingCase display = await Api.ClientTrajectory.GetTargetLandingCaseDisplayDataAsync(caseId, cancellationToken);
            if (value.MetaInfo.ID != caseId) return;
            ApplyDisplayData(display);
            _ = LoadSourceTrajectoryStationsForPlotAsync(value.SourceTrajectoryID, forceSourceReload);
            if (showReferencePerpendicularEllipses||showLeadPerpendicularEllipses)
                await EnsureUncertaintyDisplayAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to load target landing display data for {CaseId}", caseId);
            Snackbar.Add("The case inputs are available, but calculated paths could not be loaded.", Severity.Warning);
        }
        finally
        {
            loadingResult = false;
            await InvokeAsync(StateHasChanged);
        }
    }
