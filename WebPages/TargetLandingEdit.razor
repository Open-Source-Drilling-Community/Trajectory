    private List<PlaneContour> PlaneContours
    {
        get
        {
            List<PlaneContour> result=[new("Specified target","#212121",value.GeologicalTargetBoundary??[],false,null,false)];
            int index=0;
            foreach (List<TargetPlanePoint> contour in value.DrillerTargetContourList??[])
                result.Add(new(index++==0?"Driller target":"Driller target contour","#1976d2",contour,false,null,false));
            List<List<TargetPlanePoint>> reachable=value.ReachableTargetContourList??[];
            int reachableIndex=0;
            for (int contourIndex=0;contourIndex<reachable.Count;contourIndex++)
            {
                List<TargetPlanePoint> contour=reachable[contourIndex];
                TargetPlanePoint? probe=FinitePoints(contour).FirstOrDefault();
                int nestingDepth=probe==null?0:reachable.Where((other,index)=>index!=contourIndex&&PointInPolygon(probe,other)).Count();
                bool isHole=nestingDepth%2==1;
                result.Add(isHole
                    ? new PlaneContour($"Curvature-excluded island {contourIndex+1}","#e65100",contour,true,"rgba(230,81,0,0.20)",true)
                    : new PlaneContour(reachableIndex++==0?"Reachable target":"Reachable target region","#1b5e20",contour,true,"rgba(46,125,50,0.24)",false));
            }
            return result;
        }
    }
    private List<string> PlanePlotNames => PlaneContours.Select(x=>x.Name).ToList();
    private List<int> PlanePlotModes => PlaneContours.Select(_=>1).ToList();
    private List<string> PlanePlotColors => PlaneContours.Select(x=>x.Color).ToList();
    private List<bool> PlanePlotFill => PlaneContours.Select(x=>x.Fill).ToList();
    private List<string?> PlanePlotFillColors => PlaneContours.Select(x=>x.FillColor).ToList();
    private List<List<object>> PlanePlotX => PlaneContours.Select(x=>ClosedX(x.Points)).ToList();
    private List<List<object>> PlanePlotY => PlaneContours.Select(x=>ClosedY(x.Points)).ToList();
    private static List<TargetPlanePoint> FinitePoints(List<TargetPlanePoint>? points) => points?.Where(point=>Finite(point.X) && Finite(point.Y)).ToList() ?? [];
    private static List<object> ClosedX(List<TargetPlanePoint>? points) { List<TargetPlanePoint> finite=FinitePoints(points); return finite.Count>0 ? finite.Concat([finite[0]]).Select(x=>(object)x.X).ToList() : []; }
    private static List<object> ClosedY(List<TargetPlanePoint>? points) { List<TargetPlanePoint> finite=FinitePoints(points); return finite.Count>0 ? finite.Concat([finite[0]]).Select(x=>(object)x.Y).ToList() : []; }
    private CartesianPlotData BuildCartesianPlot()
    {
        List<CartesianTrace> traces=[];
        AddStationTrace("Source trajectory","#1976d2",4,true,sourceTrajectoryStations);
        AddPointTrace("Specified target boundary","#212121",5,true,TargetBoundaryPoints(value.GeologicalTargetBoundary??value.Target.Polygon));
        foreach (PlaneContour contour in PlaneContours.Where(contour=>contour.Fill))
            AddPointTrace(contour.IsHole?"Curvature-excluded island boundary":"Reachable target boundary",contour.Color,5,true,TargetBoundaryPoints(contour.Points));
        foreach (BoundarySolutionFamily family in BoundarySolutionFamilies)
        {
            FamilyStyle style=SolutionFamilyStyle(family.ColorIndex);
            bool firstPath=true;
            foreach (TargetLandingSample sample in family.Rows.Select(row=>row.Sample).DistinctBy(sample=>sample.SampleID))
            {
                AddStationTrace($"Contour {family.ContourNumber}, solution family {family.FamilyNumber}",style.Translucent,3,firstPath,sample.SurveyStationList??[]);
                firstPath=false;
            }
            if (showLandingTargetPlaneEllipses)
            {
                bool firstEllipse=true;
                foreach (TargetLandingSample sample in family.Rows.Select(row=>row.Sample).DistinctBy(sample=>sample.SampleID))
                {
                    List<CartesianPoint> points=TargetPlaneEllipsePoints(sample);
                    AddPointTrace($"Contour {family.ContourNumber}, solution family {family.FamilyNumber} landing uncertainty",style.Solid,2,firstEllipse,points);
                    if (points.Count>1) firstEllipse=false;
                }
            }
        }
        if (showReferencePerpendicularEllipses)
            AddPerpendicularEllipseTraces("Reference perpendicular uncertainty","#6a1b9a",sourceTrajectoryStations,60);
        if (showLeadPerpendicularEllipses)
            AddPerpendicularEllipseTraces("Lead perpendicular uncertainty","#ef6c00",LeadStationsForPlot(),40);
        AddStationTrace("Lead path","#ff6f00",8,true,LeadStationsForPlot());

        return new CartesianPlotData(
            traces.Select(trace=>trace.Name).ToList(),
            traces.Select(_=>1).ToList(),
            traces.Select(trace=>trace.Color).ToList(),
            traces.Select(trace=>(int?)trace.LineWidth).ToList(),
            traces.Select(trace=>trace.ShowLegend).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.North).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.East).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.TVD).ToList()).ToList());

        void AddStationTrace(string name,string color,int lineWidth,bool showLegend,IEnumerable<SurveyStation> stations)
        {
            List<CartesianPoint> points=stations.Select(StationPoint).Where(point=>point.HasValue).Select(point=>point!.Value).ToList();
            if (points.Count>1) traces.Add(new CartesianTrace(name,color,lineWidth,showLegend,points));
        }
        void AddPointTrace(string name,string color,int lineWidth,bool showLegend,List<CartesianPoint> points)
        {
            if (points.Count>1) traces.Add(new CartesianTrace(name,color,lineWidth,showLegend,points));
        }
        void AddPerpendicularEllipseTraces(string name,string color,IReadOnlyList<SurveyStation> stations,int maximumCount)
        {
            Dictionary<double,SurveyStationEllipse> ellipses=(uncertaintyDisplay?.SurveyStationEllipseResultList??[])
                .Where(result=>result.MD.HasValue&&result.PerpendicularEllipse!=null)
                .GroupBy(result=>result.MD!.Value)
                .ToDictionary(group=>group.Key,group=>group.First().PerpendicularEllipse);
            List<(SurveyStation Station,SurveyStationEllipse Ellipse)> candidates=stations
                .Where(station=>(station.MD??station.Abscissa).HasValue)
                .Select(station=>(Station:station,Md:(station.MD??station.Abscissa)!.Value))
                .Where(item=>ellipses.ContainsKey(item.Md))
                .Select(item=>(item.Station,ellipses[item.Md]))
                .ToList();
            foreach ((SurveyStation station,SurveyStationEllipse ellipse) in SelectEvenlySpaced(candidates,maximumCount))
                AddPointTrace(name,color,2,traces.All(trace=>trace.Name!=name),PerpendicularEllipsePoints(station,ellipse));
        }
    }

    private static List<(SurveyStation Station,SurveyStationEllipse Ellipse)> SelectEvenlySpaced(
        List<(SurveyStation Station,SurveyStationEllipse Ellipse)> candidates,int maximumCount)
    {
        if (candidates.Count<=maximumCount) return candidates;
        List<(SurveyStation Station,SurveyStationEllipse Ellipse)> result=[];
        for (int index=0;index<maximumCount;index++)
        {
            int selected=(int)Math.Round(index*(candidates.Count-1.0)/(maximumCount-1.0));
            result.Add(candidates[selected]);
        }
        return result;
    }

    private static List<CartesianPoint> PerpendicularEllipsePoints(SurveyStation station,SurveyStationEllipse ellipse)
    {
        if (StationPoint(station) is not CartesianPoint center||station.Inclination is not double inclination||
            station.Azimuth is not double azimuth||ellipse.SemiMajorAxis is not double major||
            ellipse.SemiMinorAxis is not double minor||ellipse.OrientationAngle is not double orientation||
            !Finite(major)||!Finite(minor)||!Finite(orientation)) return [];
        double cosA=Math.Cos(azimuth),sinA=Math.Sin(azimuth),cosI=Math.Cos(inclination),sinI=Math.Sin(inclination);
        double cosO=Math.Cos(orientation),sinO=Math.Sin(orientation);
        List<CartesianPoint> points=[];
        for (int index=0;index<=EllipseDisplayPointCount;index++)
        {
            double parameter=2.0*Math.PI*index/EllipseDisplayPointCount;
            double initialMajor=major*Math.Cos(parameter),initialMinor=minor*Math.Sin(parameter);
            double localX=initialMajor*cosO-initialMinor*sinO,localY=initialMajor*sinO+initialMinor*cosO;
            points.Add(new CartesianPoint(
                center.North+cosA*cosI*localX-sinA*localY,
                center.East+sinA*cosI*localX+cosA*localY,
                center.TVD-sinI*localX));
        }
        return points;
    }

    private List<CartesianPoint> TargetPlaneEllipsePoints(TargetLandingSample sample)
    {
        SurveyStationEllipse? ellipse=sample.LandingEllipseInTargetPlane;
        if (ellipse?.SemiMajorAxis is not double major||ellipse.SemiMinorAxis is not double minor||
            ellipse.OrientationAngle is not double orientation||!Finite(major)||!Finite(minor)||!Finite(orientation)) return [];
        double cos=Math.Cos(orientation),sin=Math.Sin(orientation);
        List<CartesianPoint> points=[];
        for (int index=0;index<=EllipseDisplayPointCount;index++)
        {
            double parameter=2.0*Math.PI*index/EllipseDisplayPointCount;
            double x=major*Math.Cos(parameter),y=minor*Math.Sin(parameter);
            TargetPlanePoint point=new() { X=sample.PlaneX+x*cos-y*sin,Y=sample.PlaneY+x*sin+y*cos };
            if (TargetPointToCartesian(point) is CartesianPoint converted) points.Add(converted);
        }
        return points;
    }
    private const int EllipseDisplayPointCount=48;
    private List<SurveyStation> LeadStationsForPlot()
    {
        List<SurveyStation> sampled=value.LeadSurveyStationList?.Where(station=>StationPoint(station)!=null).ToList()??[];
        if (sampled.Count>1) return sampled;
        SurveyStation? sourceEnd=value.SourceEndStation??sourceTrajectoryStations.LastOrDefault(station=>StationPoint(station)!=null);
        return sourceEnd!=null && value.SteeringStartStation!=null ? [sourceEnd,value.SteeringStartStation] : [];
    }
    private List<CartesianPoint> TargetBoundaryPoints(List<TargetPlanePoint>? boundary)
    {
        List<CartesianPoint> points=[];
        foreach (TargetPlanePoint point in FinitePoints(boundary))
            if (TargetPointToCartesian(point) is CartesianPoint converted) points.Add(converted);
        if (points.Count>0) points.Add(points[0]);
        return points;
    }
    private CartesianPoint? TargetPointToCartesian(TargetPlanePoint point)
    {
        double? north=Plane.RiemannianNorth??Plane.X,east=Plane.RiemannianEast??Plane.Y,tvd=Plane.TVD??Plane.Z;
        if (north is not double originNorth || east is not double originEast || tvd is not double originTvd ||
            Plane.Inclination is not double inclination || Plane.Azimuth is not double azimuth ||
            !Finite(originNorth) || !Finite(originEast) || !Finite(originTvd) || !Finite(inclination) || !Finite(azimuth)) return null;
        CartesianVector normal=new(Math.Sin(inclination)*Math.Cos(azimuth),Math.Sin(inclination)*Math.Sin(azimuth),Math.Cos(inclination));
        CartesianVector up=new(0.0,0.0,-1.0);
        CartesianVector projectedUp=up-normal*Dot(up,normal);
        CartesianVector xAxis,yAxis;
        if (Norm(projectedUp)<=1e-8) { xAxis=new(1.0,0.0,0.0);yAxis=new(0.0,1.0,0.0); }
        else { yAxis=Normalize(projectedUp);xAxis=Normalize(Cross(normal,yAxis)); }
        CartesianVector result=new CartesianVector(originNorth,originEast,originTvd)+xAxis*point.X+yAxis*point.Y;
        return new CartesianPoint(result.North,result.East,result.TVD);
    }
    private static CartesianPoint? StationPoint(SurveyStation station)
    {
        double? north=station.RiemannianNorth??station.X,east=station.RiemannianEast??station.Y,tvd=station.TVD??station.Z;
        return north is double n && east is double e && tvd is double d && Finite(n) && Finite(e) && Finite(d) ? new CartesianPoint(n,e,d) : null;
    }
    private static double Dot(CartesianVector first,CartesianVector second)=>first.North*second.North+first.East*second.East+first.TVD*second.TVD;
    private static double Norm(CartesianVector value)=>Math.Sqrt(Dot(value,value));
    private static CartesianVector Normalize(CartesianVector value)=>value*(1.0/Norm(value));
    private static CartesianVector Cross(CartesianVector first,CartesianVector second)=>new(first.East*second.TVD-first.TVD*second.East,first.TVD*second.North-first.North*second.TVD,first.North*second.East-first.East*second.North);
    private List<List<BoundarySolutionRow>> BoundarySolutionContours
    {
        get
        {
            List<TargetLandingSample> reachable = value.SampleList?.Where(sample => sample.State == TargetLandingSampleState.Reachable && sample.SolvedSectionList is { Count: > 0 }).ToList() ?? [];
            if (reachable.Count == 0) return [];
            List<List<BoundarySolutionRow>> result = [];
            int contourNumber = 0;
            foreach (List<TargetPlanePoint> contour in value.ReachableTargetContourList ?? [])
            {
                contourNumber++;
                List<BoundarySolutionRow> rows = [];
                for (int pointIndex = 0; pointIndex < contour.Count; pointIndex++)
                {
                    TargetPlanePoint point = contour[pointIndex];
                    TargetLandingSample sample = reachable.MinBy(candidate => SquaredDistance(point, candidate))!;
                    rows.Add(new BoundarySolutionRow(contourNumber, 0, pointIndex + 1, point, sample));
                }
                if (rows.Count > 0) result.Add(rows);
            }
            return result;
        }
    }
    private List<BoundarySolutionFamily> BoundarySolutionFamilies
    {
        get
        {
            List<BoundarySolutionFamily> result=[];
            int colorIndex=0;
            foreach (List<BoundarySolutionRow> contour in BoundarySolutionContours)
            {
                int familyNumber=0;
                foreach (SolutionSegment segment in SplitSolutionFamilies(contour))
                {
                    familyNumber++;
                    List<BoundarySolutionRow> rows=segment.Rows.Select(row=>row with { FamilyNumber=familyNumber }).ToList();
                    result.Add(new BoundarySolutionFamily(rows[0].ContourNumber,familyNumber,colorIndex++,segment.IsClosed,rows));
                }
            }
            return result;
        }
    }
    private List<BoundarySolutionRow> BoundarySolutions => BoundarySolutionFamilies.SelectMany(family=>family.Rows).ToList();
    private List<TargetLandingSample> BoundarySamples => BoundarySolutions.Select(row=>row.Sample).DistinctBy(sample=>sample.SampleID).Take(250).ToList();
    private BuildTurnPlotData BuildBuildTurnPlot()
    {
        Dictionary<Guid,List<List<BuildTurnControlPoint>>> paths=BoundarySamples
            .Select(sample=>(sample.SampleID,Segments:BuildTurnPathSegments(sample)))
            .Where(item=>item.Segments.Any(segment=>segment.Count>1))
            .ToDictionary(item=>item.SampleID,item=>item.Segments);
        List<BuildTurnTrace> traces=[];
        foreach (BoundarySolutionFamily family in BoundarySolutionFamilies)
        {
            FamilyStyle style=SolutionFamilyStyle(family.ColorIndex);
            int pathIndex=0;
            foreach (TargetLandingSample sample in family.Rows.Select(row=>row.Sample).DistinctBy(sample=>sample.SampleID))
                if (paths.TryGetValue(sample.SampleID,out List<List<BuildTurnControlPoint>>? segments))
                    foreach (List<BuildTurnControlPoint> segment in segments.Where(segment=>segment.Count>1))
                        traces.Add(new BuildTurnTrace($"Contour {family.ContourNumber}, family {family.FamilyNumber}, path {++pathIndex}",style.Translucent,3,false,segment));
            IEnumerable<BuildTurnControlPoint> terminalPoints=family.Rows
                .Select(row=>TerminalBuildTurnPoint(row.Sample))
                .Where(point=>point.HasValue)
                .Select(point=>point!.Value with { NormalizedLength=1.0 });
            List<BuildTurnControlPoint> target=family.IsClosed ? CloseTrace(terminalPoints) : terminalPoints.ToList();
            if (target.Count>1)
                traces.Add(new BuildTurnTrace($"Contour {family.ContourNumber}, solution family {family.FamilyNumber}",style.Solid,5,true,target));
        }
        List<double> turns=traces.SelectMany(trace=>trace.Points).Select(point=>point.Turn).ToList();
        List<double> builds=traces.SelectMany(trace=>trace.Points).Select(point=>point.Build).ToList();
        (double turnMinimum,double turnMaximum)=ExpandedControlBounds(turns);
        (double buildMinimum,double buildMaximum)=ExpandedControlBounds(builds);
        return new BuildTurnPlotData(
            traces.Select(trace=>trace.Name).ToList(),traces.Select(_=>1).ToList(),traces.Select(trace=>trace.Color).ToList(),
            traces.Select(trace=>(int?)trace.LineWidth).ToList(),traces.Select(trace=>trace.ShowLegend).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.Turn).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.NormalizedLength).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.Build).ToList()).ToList(),
            turnMinimum,turnMaximum,buildMinimum,buildMaximum);
    }
    private static List<List<BuildTurnControlPoint>> BuildTurnPathSegments(TargetLandingSample sample) =>
        SplitControlPath(sample,SplitAtSectionJunction(sample)).Select(segment=>segment
            .Select(point=>new BuildTurnControlPoint(point.TurnRate,point.NormalizedLength,point.BuildRate)).ToList()).ToList();
    private static BuildTurnControlPoint? TerminalBuildTurnPoint(TargetLandingSample sample)
    {
        TargetLandingControlPoint? point=sample.ControlPointList?.LastOrDefault();
        return point!=null&&ControlPointIsRenderable(point)
            ?new BuildTurnControlPoint(point.TurnRate,point.NormalizedLength,point.BuildRate):null;
    }
    private static (double Minimum,double Maximum) ExpandedControlBounds(List<double> values)
    {
        const double minimumPadding=0.5*Math.PI/(180.0*30.0);
        if (values.Count==0) return (-minimumPadding,minimumPadding);
        double minimum=values.Min(),maximum=values.Max();
        double padding=Math.Max(0.2*(maximum-minimum),minimumPadding);
        return (minimum-padding,maximum+padding);
    }
    private CylinderPlotData BuildCylinderPlot()
    {
        List<CylinderTrace> traces=[];
        foreach (BoundarySolutionFamily family in BoundarySolutionFamilies)
        {
            FamilyStyle style=SolutionFamilyStyle(family.ColorIndex);
            IEnumerable<BoundarySolutionRow> terminalRows=family.Rows.Where(row=>TerminalCylinderPoint(row.Sample) != null);
            List<BoundarySolutionRow> boundary=family.IsClosed ? CloseTrace(terminalRows) : terminalRows.ToList();
            if (boundary.Count>1)
            {
                traces.Add(new CylinderTrace($"Contour {family.ContourNumber}, solution family {family.FamilyNumber}",style.Solid,5,true,
                    boundary.Select(row=>
                    {
                        CylinderControlPoint terminal=TerminalCylinderPoint(row.Sample)!.Value;
                        return new CylinderCartesianPoint(Math.Sin(terminal.Toolface),Math.Cos(terminal.Toolface),terminal.Curvature);
                    }).ToList()));
            }
            int pathIndex=0;
            foreach (TargetLandingSample sample in family.Rows.Select(row=>row.Sample).DistinctBy(sample=>sample.SampleID))
            {
                foreach (List<CylinderControlPoint> segment in CylinderPathSegments(sample).Where(segment=>segment.Count>1))
                    traces.Add(new CylinderTrace($"Contour {family.ContourNumber}, family {family.FamilyNumber}, path {++pathIndex}",style.Translucent,3,false,
                        segment.Select(point=>new CylinderCartesianPoint(point.Radius*Math.Sin(point.Toolface),point.Radius*Math.Cos(point.Toolface),point.Curvature)).ToList()));
            }
        }
        return new CylinderPlotData(
            traces.Select(trace=>trace.Name).ToList(),traces.Select(_=>1).ToList(),traces.Select(trace=>trace.Color).ToList(),
            traces.Select(trace=>(int?)trace.LineWidth).ToList(),traces.Select(trace=>trace.ShowLegend).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.X).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.Y).ToList()).ToList(),
            traces.Select(trace=>trace.Points.Select(point=>(object)point.Z).ToList()).ToList());
    }
    private static CylinderControlPoint? TerminalCylinderPoint(TargetLandingSample sample)
    {
        TargetLandingControlPoint? point=sample.ControlPointList?.LastOrDefault();
        return point!=null&&ControlPointIsRenderable(point)
            ?new CylinderControlPoint(point.NormalizedLength,point.Curvature,NormalizeAngle(point.Toolface)):null;
    }
    private static List<List<CylinderControlPoint>> CylinderPathSegments(TargetLandingSample sample) =>
        SplitControlPath(sample,false).Select(segment=>segment
            .Select(point=>new CylinderControlPoint(point.NormalizedLength,point.Curvature,NormalizeAngle(point.Toolface))).ToList()).ToList();
    private static bool SplitAtSectionJunction(TargetLandingSample sample) =>
        sample.SolvedSectionList is { Count: > 1 };
    private static List<List<TargetLandingControlPoint>> SplitControlPath(TargetLandingSample sample,bool splitAtSectionJunction)
    {
        List<List<TargetLandingControlPoint>> result=[];
        List<TargetLandingControlPoint> current=[];
        foreach (TargetLandingControlPoint point in sample.ControlPointList??[])
        {
            if (!ControlPointIsRenderable(point))
            {
                if (current.Count>0) result.Add(current);
                current=[];
                continue;
            }
            if (splitAtSectionJunction&&current.Count>0&&
                Math.Abs(current[^1].NormalizedLength-point.NormalizedLength)<=NormalizedLengthComparisonTolerance)
            {
                result.Add(current);
                current=[];
            }
            current.Add(point);
        }
        if (current.Count>0) result.Add(current);
        return result;
    }
    private const double NormalizedLengthComparisonTolerance=1e-12;
    private const double VerticalControlDisplayInclination=3.0*Math.PI/180.0;
    private static bool ControlPointIsRenderable(TargetLandingControlPoint point) =>
        point.Inclination.HasValue&&ControlPointIsFinite(point)&&!ControlPointIsNearVertical(point);
    private static bool ControlPointIsNearVertical(TargetLandingControlPoint point) => point.Inclination is double inclination&&
        (inclination<VerticalControlDisplayInclination||inclination>Math.PI-VerticalControlDisplayInclination);
    private static bool ControlPointIsFinite(TargetLandingControlPoint point) =>
        Finite(point.NormalizedLength)&&(!point.Inclination.HasValue||Finite(point.Inclination.Value))&&
        Finite(point.Curvature)&&Finite(point.Toolface)&&Finite(point.BuildRate)&&Finite(point.TurnRate);
    private static TrajectoryExtrapolationSolvedSection? BoundarySection(TargetLandingSample sample, int sectionIndex) =>
        sample.SolvedSectionList?.FirstOrDefault(section => section.SectionIndex == sectionIndex);
    private static double? BoundaryFirstCommand(TargetLandingSample sample, int sectionIndex)
    {
        TrajectoryExtrapolationSolvedSection? section = BoundarySection(sample, sectionIndex);
        return section?.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn
            ? section.ConstantBuildRate
            : section == null ? null : SectionCurvature(section);
    }
    private static double? BoundarySecondCommand(TargetLandingSample sample, int sectionIndex)
    {
        TrajectoryExtrapolationSolvedSection? section = BoundarySection(sample, sectionIndex);
        return section?.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn
            ? section.ConstantTurnRate
            : section == null ? null : SectionToolface(section);
    }
    private static double? SectionCurvature(TrajectoryExtrapolationSolvedSection section) => section.CurveType == ExtrapolationCurveType.ConstantCurvatureAndToolface ? section.ConstantCurvature : section.CircularArcCurvature;
    private static double? SectionToolface(TrajectoryExtrapolationSolvedSection section) => section.CurveType == ExtrapolationCurveType.ConstantCurvatureAndToolface ? section.ConstantToolface : section.CircularArcStartToolface;
    private static double NormalizeAngle(double value) { double result=value%(2*Math.PI); return result<0?result+2*Math.PI:result; }
    private static List<T> CloseTrace<T>(IEnumerable<T> points)
    {
        List<T> result=points.ToList();
        if (result.Count>1) result.Add(result[0]);
        return result;
    }
    private static List<SolutionSegment> SplitSolutionFamilies(List<BoundarySolutionRow> rows)
    {
        if (rows.Count<2) return rows.Count==0?[]:[new SolutionSegment(rows,true)];
        bool[] breakBefore=new bool[rows.Count];
        for (int index=0;index<rows.Count;index++)
            breakBefore[index]=IsSolutionDiscontinuity(rows[(index-1+rows.Count)%rows.Count],rows[index]);
        int firstBreak=Array.FindIndex(breakBefore,value=>value);
        if (firstBreak<0) return [new SolutionSegment(rows,true)];

        List<SolutionSegment> result=[];
        List<BoundarySolutionRow> current=[];
        for (int offset=0;offset<rows.Count;offset++)
        {
            int index=(firstBreak+offset)%rows.Count;
            if (offset>0&&breakBefore[index]&&current.Count>0)
            {
                result.Add(new SolutionSegment(current,false));
                current=[];
            }
            current.Add(rows[index]);
        }
        if (current.Count>0) result.Add(new SolutionSegment(current,false));
        return result;
    }
    private static bool IsSolutionDiscontinuity(BoundarySolutionRow first,BoundarySolutionRow second)
    {
        if (first.Sample.SampleID==second.Sample.SampleID) return false;
        CartesianPoint? firstMidpoint=NormalizedPathMidpoint(first.Sample);
        CartesianPoint? secondMidpoint=NormalizedPathMidpoint(second.Sample);
        if (firstMidpoint is not CartesianPoint a||secondMidpoint is not CartesianPoint b) return false;
        double dn=a.North-b.North,de=a.East-b.East,dd=a.TVD-b.TVD;
        double midpointSeparation=Math.Sqrt(dn*dn+de*de+dd*dd);
        double planeStep=Math.Sqrt(SquaredDistance(first.Point,second.Point));
        return midpointSeparation>Math.Max(25.0,8.0*Math.Max(planeStep,PositionComparisonTolerance));
    }
    private static CartesianPoint? NormalizedPathMidpoint(TargetLandingSample sample)
    {
        List<SurveyStation> stations=sample.SurveyStationList?.Where(station=>StationPoint(station)!=null).ToList()??[];
        if (stations.Count==0) return null;
        double? start=stations[0].MD??stations[0].Abscissa,end=stations[^1].MD??stations[^1].Abscissa;
        if (start is not double firstMd||end is not double lastMd) return StationPoint(stations[stations.Count/2]);
        double midpoint=0.5*(firstMd+lastMd);
        SurveyStation nearest=stations.MinBy(station=>Math.Abs((station.MD??station.Abscissa??midpoint)-midpoint))!;
        return StationPoint(nearest);
    }
    private const double PositionComparisonTolerance=0.25;
    private static FamilyStyle SolutionFamilyStyle(int index)=>(index%6) switch
    {
        0=>new("#1b5e20","rgba(27,94,32,0.62)"),
        1=>new("#00695c","rgba(0,105,92,0.62)"),
        2=>new("#1565c0","rgba(21,101,192,0.62)"),
        3=>new("#6a1b9a","rgba(106,27,154,0.62)"),
        4=>new("#006064","rgba(0,96,100,0.62)"),
        _=>new("#4e342e","rgba(78,52,46,0.62)")
    };
    private static bool PointInPolygon(TargetPlanePoint point,IReadOnlyList<TargetPlanePoint> polygon)
    {
        bool inside=false;
        for (int index=0,previous=polygon.Count-1;index<polygon.Count;previous=index++)
        {
            TargetPlanePoint current=polygon[index],prior=polygon[previous];
            if ((current.Y>point.Y)!=(prior.Y>point.Y)&&
                point.X<(prior.X-current.X)*(point.Y-current.Y)/(prior.Y-current.Y)+current.X) inside=!inside;
        }
        return inside;
    }
    private static double SquaredDistance(TargetPlanePoint point, TargetLandingSample sample) { double dx=point.X-sample.PlaneX,dy=point.Y-sample.PlaneY;return dx*dx+dy*dy; }
    private static double SquaredDistance(TargetPlanePoint first,TargetPlanePoint second) { double dx=first.X-second.X,dy=first.Y-second.Y;return dx*dx+dy*dy; }
    private readonly record struct CylinderControlPoint(double Radius,double Curvature,double Toolface);
    private readonly record struct CylinderCartesianPoint(double X,double Y,double Z);
    private readonly record struct BuildTurnControlPoint(double Turn,double NormalizedLength,double Build);
    private readonly record struct CartesianPoint(double North,double East,double TVD);
    private readonly record struct CartesianVector(double North,double East,double TVD)
    {
        public static CartesianVector operator +(CartesianVector first,CartesianVector second)=>new(first.North+second.North,first.East+second.East,first.TVD+second.TVD);
        public static CartesianVector operator -(CartesianVector first,CartesianVector second)=>new(first.North-second.North,first.East-second.East,first.TVD-second.TVD);
        public static CartesianVector operator *(CartesianVector value,double scale)=>new(value.North*scale,value.East*scale,value.TVD*scale);
    }
    private sealed record CartesianTrace(string Name,string Color,int LineWidth,bool ShowLegend,List<CartesianPoint> Points);
    private sealed record CartesianPlotData(List<string> Names,List<int> Modes,List<string> Colors,List<int?> LineWidths,List<bool> ShowLegend,List<List<object>> X,List<List<object>> Y,List<List<object>> Z);
    private sealed record BuildTurnTrace(string Name,string Color,int LineWidth,bool ShowLegend,List<BuildTurnControlPoint> Points);
    private sealed record BuildTurnPlotData(List<string> Names,List<int> Modes,List<string> Colors,List<int?> LineWidths,List<bool> ShowLegend,List<List<object>> X,List<List<object>> Y,List<List<object>> Z,double TurnMinimum,double TurnMaximum,double BuildMinimum,double BuildMaximum);
    private sealed record CylinderTrace(string Name,string Color,int LineWidth,bool ShowLegend,List<CylinderCartesianPoint> Points);
    private sealed record CylinderPlotData(List<string> Names,List<int> Modes,List<string> Colors,List<int?> LineWidths,List<bool> ShowLegend,List<List<object>> X,List<List<object>> Y,List<List<object>> Z);
    private sealed record PlaneContour(string Name,string Color,List<TargetPlanePoint> Points,bool Fill,string? FillColor,bool IsHole);
    private sealed record BoundarySolutionRow(int ContourNumber,int FamilyNumber,int PointNumber,TargetPlanePoint Point,TargetLandingSample Sample);
    private sealed record BoundarySolutionFamily(int ContourNumber,int FamilyNumber,int ColorIndex,bool IsClosed,List<BoundarySolutionRow> Rows);
    private sealed record SolutionSegment(List<BoundarySolutionRow> Rows,bool IsClosed);
    private readonly record struct FamilyStyle(string Solid,string Translucent);
    private static bool Finite(double value) => !double.IsNaN(value) && !double.IsInfinity(value);
    public void Dispose()
    {
        calculationPolling.Cancel();
        calculationPolling.Dispose();
    }
}
