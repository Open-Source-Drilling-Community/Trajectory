    private async Task EnsureUncertaintyDisplayAsync()
    {
        if (uncertaintyDisplay!=null||loadingUncertaintyDisplay||value.MetaInfo?.ID is not Guid id||id==Guid.Empty) return;
        loadingUncertaintyDisplay=true;
        try
        {
            uncertaintyDisplay=await Api.ClientTrajectory.GetTargetLandingCaseUncertaintyDisplayDataAsync(id,calculationPolling.Token);
            if (uncertaintyDisplay.SurveyStationEllipseResultList is not { Count:>0 })
            {
                Snackbar.Add(uncertaintyDisplay.CalculationMessage??"No perpendicular uncertainty ellipses are available for this case.",Severity.Warning);
                showReferencePerpendicularEllipses=showLeadPerpendicularEllipses=false;
            }
        }
        catch (OperationCanceledException) when (calculationPolling.IsCancellationRequested) { }
        catch (Exception ex)
        {
            logger.LogWarning(ex,"Unable to load target landing uncertainty display data for {CaseId}",id);
            Snackbar.Add("The landing geometry is available, but perpendicular uncertainty ellipses could not be loaded.",Severity.Warning);
            showReferencePerpendicularEllipses=showLeadPerpendicularEllipses=false;
        }
        finally
        {
            loadingUncertaintyDisplay=false;
            if (!calculationPolling.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }
