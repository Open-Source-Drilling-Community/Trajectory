@page "/DirectionalControlEvaluation"
@implements IDisposable
@inject ILogger<DirectionalControlEvaluationMain> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData

<MudUnitAndReferenceChoiceTag HttpHost="@Api.HostNameUnitConversion"
                              HttpBasePath="@Api.HostBasePathUnitConversion"
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName"
                              EnableDateTimeReference="true"
                              DateReferenceName="@DataUtils.UnitAndReferenceParameters.DateReferenceName"
                              DateReferenceNameChanged="@((string value) => DataUtils.UpdateDateReferenceName(value))"
                              DepthReferenceName="@DataUtils.UnitAndReferenceParameters.DepthReferenceName"
                              DepthReferenceNameChanged="@DataUtils.UpdateDepthReferenceName"
                              GroundMudLineDepthReferenceSource="@DataUtils.GroundMudLineDepthReferenceSource"
                              MeanSeaLevelDepthReferenceSource="@DataUtils.MeanSeaLevelDepthReferenceSource"
                              SeaWaterLevelDepthReferenceSource="@DataUtils.SeaWaterLevelDepthReferenceSource"
                              RotaryTableDepthReferenceSource="@DataUtils.RotaryTableDepthReferenceSource"
                              PositionReferenceName="@DataUtils.UnitAndReferenceParameters.PositionReferenceName"
                              PositionReferenceNameChanged="@DataUtils.UpdatePositionReferenceName"
                              WellHeadPositionReferenceSource="@DataUtils.WellHeadPositionReferenceSource"
                              CartographicGridPositionReferenceSource="@DataUtils.CartographicGridPositionReferenceSource"
                              FieldPositionReferenceSource="@DataUtils.FieldPositionReferenceSource"
                              ClusterPositionReferenceSource="@DataUtils.ClusterPositionReferenceSource"
                              AzimuthReferenceName="@DataUtils.UnitAndReferenceParameters.AzimuthReferenceName"
                              AzimuthReferenceNameChanged="@DataUtils.UpdateAzimuthReferenceName"
                              GridConvergenceSource="@DataUtils.GridConvergenceSource"
                              MagneticDeclinationSource="@DataUtils.MagneticDeclinationSource">
    @if (editing)
    {
        <DirectionalControlEvaluationEdit CaseId="@caseId" ValueChanged="CloseEditorAsync" />
    }
    else
    {
        <MudDataGrid T="DirectionalControlEvaluationCaseLight" Items="@cases" Hover="true" RowClick="OpenRow"
                     ReadOnly="true" SortMode="SortMode.Multiple" QuickFilter="Filter" Elevation="0">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Directional Control Evaluation</MudText>
                <MudButton Color="Color.Success" OnClick="Add">Add</MudButton>
                <MudSpacer />
                <MudTextField @bind-Value="search" Placeholder="Search" Immediate="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Case" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => TrajectoryName(x.ReferenceTrajectoryID)" Title="Reference trajectory" />
                <PropertyColumn Property="x => TrajectoryName(x.ActualTrajectoryID)" Title="Actual trajectory" />
                <PropertyColumn Property="x => x.CurveType" Title="Curve family" />
                <TemplateColumn Title="Calculation"><CellTemplate>@Status(context.Item)</CellTemplate></TemplateColumn>
                <TemplateColumn><CellTemplate><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context.Item))" /></CellTemplate></TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="DirectionalControlEvaluationCaseLight" /></PagerContent>
        </MudDataGrid>
    }
</MudUnitAndReferenceChoiceTag>

@code {
    private List<DirectionalControlEvaluationCaseLight> cases = [];
    private List<TrajectoryLight> trajectories = [];
    private Guid? caseId;
    private bool editing;
    private string? search;
    private CancellationTokenSource? polling;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        polling?.Cancel();
        try
        {
            Task<List<DirectionalControlEvaluationCaseLight>> caseTask = Api.ClientTrajectory.GetAllDirectionalControlEvaluationCaseLightAsync();
            Task<TrajectoryReferenceDataSnapshot> referenceTask = ReferenceData.GetSnapshotAsync();
            await Task.WhenAll(caseTask, referenceTask);
            cases = (await caseTask).OrderBy(value => value.Name).ToList();
            trajectories = (await referenceTask).Trajectories.ToList();
            StartPolling();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to load directional-control evaluation cases");
            Snackbar.Add("Unable to load directional-control evaluation cases.", Severity.Error);
        }
    }

    private void Add() { polling?.Cancel(); caseId = null; editing = true; }
    private Task OpenRow(DataGridRowClickEventArgs<DirectionalControlEvaluationCaseLight> args) { polling?.Cancel(); caseId = args.Item.MetaInfo.ID; editing = true; return Task.CompletedTask; }
    private async Task CloseEditorAsync() { editing = false; caseId = null; await LoadAsync(); }
    private string TrajectoryName(Guid id) => trajectories.FirstOrDefault(value => value.MetaInfo?.ID == id)?.Name ?? "Unknown trajectory";
    private Func<DirectionalControlEvaluationCaseLight, bool> Filter => value => string.IsNullOrWhiteSpace(search) ||
        $"{value.Name} {value.Description} {TrajectoryName(value.ReferenceTrajectoryID)} {TrajectoryName(value.ActualTrajectoryID)} {value.CurveType}".Contains(search, StringComparison.OrdinalIgnoreCase);

    private RenderFragment Status(DirectionalControlEvaluationCaseLight value) => @<div style="min-width:160px">
        <MudText Typo="Typo.caption" Color="@(value.CalculationState == CalculationState.Failed ? Color.Error : value.IsStale ? Color.Warning : Color.Default)">
            @(value.IsStale ? "Inputs changed" : value.CalculationState.ToString()) @value.CalculationMessage
        </MudText>
        @if (Active(value)) { <MudProgressLinear Value="@(100 * value.CalculationProgress)" Size="Size.Small" /> }
    </div>;

    private static bool Active(DirectionalControlEvaluationCaseLight value) => value.CalculationState is CalculationState.Queued or CalculationState.Running;
    private void StartPolling()
    {
        if (!cases.Any(Active)) return;
        polling = new CancellationTokenSource();
        _ = PollAsync(polling.Token);
    }
    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && cases.Any(Active))
            {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                cases = (await Api.ClientTrajectory.GetAllDirectionalControlEvaluationCaseLightAsync(token)).OrderBy(value => value.Name).ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task DeleteAsync(DirectionalControlEvaluationCaseLight value)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync("Delete evaluation", $"Delete '{value.Name}'?",
            yesText: "Delete", cancelText: "Cancel", options: TrajectoryDialogOptions.Compact);
        if (confirmed != true) return;
        try
        {
            await Api.ClientTrajectory.DeleteDirectionalControlEvaluationCaseByIdAsync(value.MetaInfo.ID, ConcurrencyToken.Require(value.LastModificationDate));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to delete directional-control evaluation case");
            Snackbar.Add("Unable to delete the evaluation case.", Severity.Error);
        }
    }

    public void Dispose() { polling?.Cancel(); polling?.Dispose(); }
}
