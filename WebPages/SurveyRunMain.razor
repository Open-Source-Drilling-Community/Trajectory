@page "/SurveyRun"
@inject ILogger<SurveyRunMain> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using OSDC.UnitConversion.Conversion.DrillingEngineering

<MudUnitAndReferenceChoiceTag @ref="unitReferenceTag_"
                              HttpHost=@Api.HostNameUnitConversion
                              HttpBasePath=@Api.HostBasePathUnitConversion
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@OnUnitSystemNameChanged"
                              DepthReferenceName="@DataUtils.UnitAndReferenceParameters.DepthReferenceName"
                              DepthReferenceNameChanged="@OnDepthReferenceNameChanged"
                              GroundMudLineDepthReferenceSource="@DataUtils.GroundMudLineDepthReferenceSource"
                              MeanSeaLevelDepthReferenceSource="@DataUtils.MeanSeaLevelDepthReferenceSource"
                              SeaWaterLevelDepthReferenceSource="@DataUtils.SeaWaterLevelDepthReferenceSource"
                              RotaryTableDepthReferenceSource="@DataUtils.RotaryTableDepthReferenceSource"
                              PositionReferenceName="@DataUtils.UnitAndReferenceParameters.PositionReferenceName"
                              PositionReferenceNameChanged="@OnPositionReferenceNameChanged"
                              WellHeadPositionReferenceSource="@DataUtils.WellHeadPositionReferenceSource"
                              CartographicGridPositionReferenceSource="@DataUtils.CartographicGridPositionReferenceSource"
                              FieldPositionReferenceSource="@DataUtils.FieldPositionReferenceSource"
                              ClusterPositionReferenceSource="@DataUtils.ClusterPositionReferenceSource"
                              AzimuthReferenceName="@DataUtils.UnitAndReferenceParameters.AzimuthReferenceName"
                              AzimuthReferenceNameChanged="@DataUtils.UpdateAzimuthReferenceName"
                              GridConvergenceSource="@DataUtils.GridConvergenceSource"
                              MagneticDeclinationSource="@DataUtils.MagneticDeclinationSource">
    <NavigationLock ConfirmExternalNavigation="@HasUnsavedSurveyRunChanges()"
                    OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />
    @if (isEditing_)
    {
        <MudText Class="mt-4 mb-4" Typo="Typo.h6">Edit Survey Run</MudText>
        <MudContainer Class="d-flex flex-row mt-4 mb-4">
            <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Success" OnClick="SaveSurveyRunAsync">Save</MudButton>
            <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Error" OnClick="CloseEditorAsync">Close</MudButton>
        </MudContainer>
        @if (currentSurveyRun_ is { CalculationState: CalculationState.Running or CalculationState.Queued })
        {
            <MudProgressLinear Value="@(100.0 * currentSurveyRun_.CalculationProgress)" Color="Color.Info" Class="mb-3" />
        }

        @if (currentSurveyRun_ is { } surveyRun)
        {
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="surveyRun.Name" Label="Name" Required="true" ShrinkLabel />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="surveyRun.Description" Label="Description" ShrinkLabel />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@FormatDate(surveyRun.CreationDate)" Label="Created" ReadOnly="true" ShrinkLabel />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@FormatDate(surveyRun.LastModificationDate)" Label="Last modified" ReadOnly="true" ShrinkLabel />
                </MudItem>
            </MudGrid>

            <TrajectoryResourceFilter Class="mt-2" Fields="@(fieldList_ ?? [])" Clusters="@(clusterList_ ?? [])"
                                      Wells="@(wellList_ ?? [])" WellBores="@(wellBoreList_ ?? [])"
                                      FieldId="@selectedFieldId_" FieldIdChanged="OnEditorFieldChanged"
                                      ClusterId="@selectedClusterId_" ClusterIdChanged="OnEditorClusterChanged"
                                      WellId="@selectedWellId_" WellIdChanged="OnEditorWellChanged"
                                      WellBoreId="@selectedWellBoreId_" WellBoreIdChanged="OnEditorWellBoreChanged"
                                      Disabled="@(!referenceDataAvailable_)" />
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="3">
                    <RigJobSelector WellBores="@(wellBoreList_ ?? [])" Rigs="@(rigList_ ?? [])" WellBoreId="@selectedWellBoreId_"
                                    ReferenceDate="@CurrentSurveyRunReferenceDate" SelectedRigJobId="@selectedRigJobId_"
                                    SelectedRigJobIdChanged="OnRigJobIdChanged" SelectionChanged="OnRigJobChanged" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect Label="Survey instrument" T="Guid?" Value="@selectedSurveyInstrumentId_" ValueChanged="OnEditorSurveyInstrumentChanged" ShrinkLabel Required="true">
                        @foreach (SurveyInstrumentLight instrument in AvailableSurveyInstruments)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)instrument.MetaInfo.ID)">@instrument.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect Label="Survey run type" T="SurveyRunType" Value="@surveyRun.SurveyRunType" ValueChanged="@(value => surveyRun.SurveyRunType = value)" ShrinkLabel Required="true">
                        @foreach (SurveyRunType surveyRunType in SurveyRunTypes)
                        {
                            <MudSelectItem T="SurveyRunType" Value="@surveyRunType">@surveyRunType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect Label="Parent survey run" T="Guid?" Value="@selectedParentSurveyRunId_" ValueChanged="OnEditorParentSurveyRunChanged" ShrinkLabel Clearable="true" Disabled="@(!IsParentSurveyRunRequired)">
                        @foreach (SurveyRun parentSurveyRun in AvailableParentSurveyRuns)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)parentSurveyRun.MetaInfo.ID)">@parentSurveyRun.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mt-2">
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="Acquisition start UTC" Value="@FormatUtcInput(surveyRun.AcquisitionStartUtc)" ValueChanged="value => SetAcquisitionStart(value)" Placeholder="yyyy-MM-ddTHH:mm:ssZ" ShrinkLabel />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="Acquisition end UTC" Value="@FormatUtcInput(surveyRun.AcquisitionEndUtc)" ValueChanged="value => SetAcquisitionEnd(value)" Placeholder="yyyy-MM-ddTHH:mm:ssZ" ShrinkLabel />
                </MudItem>
            </MudGrid>

            <IdentityFeatureAssignments IdentityAssignments="surveyRun.SurveyRunIdentityAssignments"
                                        FeatureAssignments="surveyRun.SurveyRunFeatureAssignments" />

            <MudExpansionPanels Class="mt-4">
                <MudExpansionPanel Text="Import survey stations">
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <InputFile OnChange="OnSurveyImportFileChanged" />
                            <MudText Typo="Typo.caption">@surveyImportFileName_</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" Label="File format" @bind-Value="selectedSurveyImportFormat_" ShrinkLabel>
                                @foreach (string format in SurveyImportFormats_)
                                {
                                    <MudSelectItem T="string" Value="@format">@format</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (IsDelimitedImportFormat)
                        {
                            <MudItem xs="12" md="3">
                                <MudSelect T="string" Label="Column separator" @bind-Value="selectedSurveyImportSeparator_" ShrinkLabel>
                                    @foreach (string separator in SurveyImportSeparators_)
                                    {
                                        <MudSelectItem T="string" Value="@separator">@separator</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" Label="Decimal marker" @bind-Value="selectedSurveyImportDecimalMarker_" ShrinkLabel>
                                @foreach (string marker in SurveyImportDecimalMarkers_)
                                {
                                    <MudSelectItem T="string" Value="@marker">@marker</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (IsDelimitedImportFormat)
                        {
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="MD column" @bind-Value="surveyImportMDColumn_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Incl column" @bind-Value="surveyImportInclinationColumn_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Az column" @bind-Value="surveyImportAzimuthColumn_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="UTC time column (0 = none)" @bind-Value="surveyImportTimeColumn_" Min="0" Immediate="true" />
                            </MudItem>
                        }
                        else
                        {
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="MD start" @bind-Value="surveyImportMDStart_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="MD width" @bind-Value="surveyImportMDWidth_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Incl start" @bind-Value="surveyImportInclinationStart_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Incl width" @bind-Value="surveyImportInclinationWidth_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Az start" @bind-Value="surveyImportAzimuthStart_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="Az width" @bind-Value="surveyImportAzimuthWidth_" Min="1" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="UTC time start (0 = none)" @bind-Value="surveyImportTimeStart_" Min="0" Immediate="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="int" Label="UTC time width" @bind-Value="surveyImportTimeWidth_" Min="1" Immediate="true" />
                            </MudItem>
                        }
                        <MudItem xs="12" md="2">
                            <MudSelect T="string" Label="MD unit" @bind-Value="selectedSurveyImportMDUnit_" ShrinkLabel>
                                @foreach (string unit in AvailableSurveyImportDepthUnits)
                                {
                                    <MudSelectItem T="string" Value="@unit">@unit</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudSelect T="string" Label="Incl unit" @bind-Value="selectedSurveyImportInclinationUnit_" ShrinkLabel>
                                @foreach (string unit in AvailableSurveyImportAngleUnits)
                                {
                                    <MudSelectItem T="string" Value="@unit">@unit</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudSelect T="string" Label="Az unit" @bind-Value="selectedSurveyImportAzimuthUnit_" ShrinkLabel>
                                @foreach (string unit in AvailableSurveyImportAngleUnits)
                                {
                                    <MudSelectItem T="string" Value="@unit">@unit</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3" Class="d-flex align-center">
                            <MudButton OnClick="ImportSurveyStationsAsync" Color="Color.Primary" Variant="Variant.Filled">Import</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudToolBar Class="mt-4">
                <MudText Typo="Typo.h6">Survey measurements</MudText>
            </MudToolBar>
            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Survey measurement settings</MudText>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudSelect T="TrajectoryCalculationType" Label="Calculation method" Value="@surveyRun.CalculationType" ValueChanged="OnCalculationTypeChanged" ShrinkLabel>
                            @foreach (TrajectoryCalculationType method in TrajectoryCalculationTypes)
                            {
                                <MudSelectItem T="TrajectoryCalculationType" Value="@method">@GetCalculationMethodLabel(method)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="SurveyInclinationReference" Label="Observed inclination reference" Value="@surveyRun.DefaultInclinationReference" ValueChanged="OnDefaultInclinationReferenceChanged" ShrinkLabel>
                            @foreach (SurveyInclinationReference value in Enum.GetValues<SurveyInclinationReference>().Where(value => value != SurveyInclinationReference.InheritRun))
                            {
                                <MudSelectItem T="SurveyInclinationReference" Value="@value">@GetInclinationReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="SurveyAzimuthReference" Label="Observed azimuth reference" Value="@surveyRun.DefaultAzimuthReference" ValueChanged="OnDefaultAzimuthReferenceChanged" ShrinkLabel>
                            @foreach (SurveyAzimuthReference value in Enum.GetValues<SurveyAzimuthReference>().Where(value => value != SurveyAzimuthReference.InheritRun))
                            {
                                <MudSelectItem T="SurveyAzimuthReference" Value="@value">@GetAzimuthReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="SurveyGeomagneticModel" Label="Geomagnetic model" Value="@surveyRun.GeomagneticModel" ValueChanged="OnGeomagneticModelChanged" ShrinkLabel>
                            @foreach (SurveyGeomagneticModel value in Enum.GetValues<SurveyGeomagneticModel>())
                            {
                                <MudSelectItem T="SurveyGeomagneticModel" Value="@value">@value</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSwitch T="bool" Value="@HasBitExtrapolation" ValueChanged="OnBitExtrapolationEnabledChanged"
                                   Color="Color.Primary" Label="Add terminal bit extrapolation" />
                    </MudItem>
                    @if (surveyRun.BitExtrapolation is { } bitExtrapolation)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="SurveyRunBitExtrapolationMode" Label="Bit-station source"
                                       Value="@bitExtrapolation.Mode" ValueChanged="OnBitExtrapolationModeChanged" ShrinkLabel>
                                <MudSelectItem T="SurveyRunBitExtrapolationMode" Value="SurveyRunBitExtrapolationMode.CalculateFromLastMeasurement">Calculate from last measurement</MudSelectItem>
                                <MudSelectItem T="SurveyRunBitExtrapolationMode" Value="SurveyRunBitExtrapolationMode.LastStationAlreadyExtrapolated">Last row is already extrapolated</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudInputWithUnit QuantityName="DepthDrilling"
                                              SIValueNullable="@((double?)bitExtrapolation.MeasurementToolToBitDistance)"
                                              SIValueNullableChanged="OnMeasurementToolToBitDistanceChanged"
                                              QuantityLabel="Measurement tool to bit distance" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">
                                The survey run calculation method continues the last measured curve;
                                a survey run with one measured station uses a straight extension. The extrapolated bit station is not a new instrument measurement.
                            </MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Apply to all survey measurements</MudText>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudSelect T="SurveyInclinationReference" Label="Inclination reference for all" @bind-Value="bulkInclinationReference_" Dense="true" ShrinkLabel>
                            @foreach (SurveyInclinationReference value in Enum.GetValues<SurveyInclinationReference>())
                            {
                                <MudSelectItem T="SurveyInclinationReference" Value="@value">@GetInclinationReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-end">
                        <MudButton OnClick="ApplyInclinationReferenceToAll" Color="Color.Primary" Variant="Variant.Outlined"
                                   Disabled="@(!SurveyMeasurements.Any())">Apply all</MudButton>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="SurveyAzimuthReference" Label="Azimuth reference for all" @bind-Value="bulkAzimuthReference_" Dense="true" ShrinkLabel>
                            @foreach (SurveyAzimuthReference value in Enum.GetValues<SurveyAzimuthReference>())
                            {
                                <MudSelectItem T="SurveyAzimuthReference" Value="@value">@GetAzimuthReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-end">
                        <MudButton OnClick="ApplyAzimuthReferenceToAll" Color="Color.Primary" Variant="Variant.Outlined"
                                   Disabled="@(!SurveyMeasurements.Any())">Apply all</MudButton>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Measurement time UTC for all" @bind-Value="bulkMeasurementTimeUtc_"
                                      Placeholder="yyyy-MM-ddTHH:mm:ssZ" ShrinkLabel />
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-end">
                        <MudButton OnClick="ApplyMeasurementTimeToAll" Color="Color.Primary" Variant="Variant.Outlined"
                                   Disabled="@(!SurveyMeasurements.Any())">Apply all</MudButton>
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption">An empty measurement time clears the time on every station. Individual rows remain editable after applying a bulk value.</MudText>
            </MudPaper>
            <MudToolBar Dense="true" Class="mb-1">
                <MudSpacer />
                <MudButton OnClick="SaveSurveyRunAsync" Color="Color.Success" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Calculate" Class="add-item-btn">Calculate</MudButton>
                <MudButton OnClick="ExportSurveyStationsAsync" Color="@Color.Primary" Variant="Variant.Outlined" Class="add-item-btn">Export</MudButton>
                <MudButton OnClick="@AddSurveyStation" Color="@Color.Success" Class="add-item-btn">Add</MudButton>
                <MudButton OnClick="@DeleteSurveyStations" Color="@Color.Error" Class="add-item-btn"
                           Disabled="@(!selectedSurveyStations_.Any())">Delete</MudButton>
            </MudToolBar>
            <MudTable Items="@SurveyMeasurements" MultiSelection="true" T="SurveyMeasurement"
                      @key="MeasurementReferenceRenderKey"
                      @bind-SelectedItems="selectedSurveyStations_"
                      Height="400px" FixedHeader="true"
                      Elevation="1" CustomHeader="true" Hover="true" Dense="true" Bordered="true" HorizontalScrollbar="true">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>Origin</MudTh>
                    <MudTh>MD [@DepthUnitLabel]</MudTh>
                    <MudTh>Observed inclination [@AngleUnitLabel]</MudTh>
                    <MudTh>Inclination reference</MudTh>
                    <MudTh>Inclination correction [@AngleUnitLabel]</MudTh>
                    <MudTh>Geodetic inclination [@AngleUnitLabel]</MudTh>
                    <MudTh>Observed azimuth [@AngleUnitLabel]</MudTh>
                    <MudTh>Azimuth reference</MudTh>
                    <MudTh>Azimuth correction [@AngleUnitLabel]</MudTh>
                    <MudTh>True-north azimuth [@AngleUnitLabel]</MudTh>
                    <MudTh>Measurement time UTC</MudTh>
                    <MudTh>Correction status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Origin">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@(context.Origin == SurveyMeasurementOrigin.Extrapolated ? Color.Warning : Color.Default)">
                            @context.Origin
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Measured Depth">
                        <MudInputWithUnit QuantityName="DepthDrilling" @key="MeasurementReferenceRenderKey"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                          SIValueNullable="@context.MD"
                                          SIValueNullableChanged="@(val => OnSurveyStationMdChanged(context, val))" />
                    </MudTd>
                    <MudTd DataLabel="Observed inclination">
                        <MudInputWithUnit QuantityName="PlaneAngleDrilling"
                                          SIValueNullable="@GetObservedInclination(context)"
                                          SIValueNullableChanged="@(val => OnObservedInclinationChanged(context, val))" />
                    </MudTd>
                    <MudTd DataLabel="Inclination reference">
                        <MudSelect T="SurveyInclinationReference?" Value="@context.InclinationReference" ValueChanged="@(val => OnInclinationReferenceChanged(context, val))" Clearable="true" Dense="true" Disabled="@IsExtrapolated(context)">
                            @foreach (SurveyInclinationReference value in Enum.GetValues<SurveyInclinationReference>().Where(value => value != SurveyInclinationReference.InheritRun))
                            {
                                <MudSelectItem T="SurveyInclinationReference?" Value="@((SurveyInclinationReference?)value)">@GetInclinationReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Inclination correction">
                        @if (IsExtrapolated(context))
                        {
                            @FormatAngleValue(context.Correction?.AppliedInclinationCorrection)
                        }
                        else
                        {
                            <MudInputWithUnit QuantityName="PlaneAngleDrilling" SIValueNullable="@context.Correction?.AppliedInclinationCorrection"
                                              SIValueNullableChanged="@(val => OnInclinationCorrectionChanged(context, val))" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Geodetic inclination">@FormatAngleValue(context.Inclination)</MudTd>
                    <MudTd DataLabel="Observed azimuth">
                        <MudInputWithUnit QuantityName="PlaneAngleDrilling" SIValueNullable="@GetObservedAzimuth(context)"
                                          SIValueNullableChanged="@(val => OnObservedAzimuthChanged(context, val))" />
                    </MudTd>
                    <MudTd DataLabel="Azimuth reference">
                        <MudSelect T="SurveyAzimuthReference?" Value="@context.AzimuthReference" ValueChanged="@(val => OnAzimuthReferenceChanged(context, val))" Clearable="true" Dense="true" Disabled="@IsExtrapolated(context)">
                            @foreach (SurveyAzimuthReference value in Enum.GetValues<SurveyAzimuthReference>().Where(value => value != SurveyAzimuthReference.InheritRun))
                            {
                                <MudSelectItem T="SurveyAzimuthReference?" Value="@((SurveyAzimuthReference?)value)">@GetAzimuthReferenceLabel(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Azimuth correction">
                        @if (IsExtrapolated(context))
                        {
                            @FormatAngleValue(context.Correction?.AppliedAzimuthCorrection)
                        }
                        else
                        {
                            <MudInputWithUnit QuantityName="PlaneAngleDrilling" SIValueNullable="@context.Correction?.AppliedAzimuthCorrection"
                                              SIValueNullableChanged="@(val => OnAzimuthCorrectionChanged(context, val))" />
                        }
                    </MudTd>
                    <MudTd DataLabel="True-north azimuth">@FormatAngleValue(context.Azimuth)</MudTd>
                    <MudTd DataLabel="Measurement time UTC">
                        <MudTextField T="string" Value="@FormatUtcInput(context.MeasurementTimeUtc)" ValueChanged="value => SetMeasurementTime(context, value)" Placeholder="yyyy-MM-ddTHH:mm:ssZ" Disabled="@IsExtrapolated(context)" />
                    </MudTd>
                    <MudTd DataLabel="Correction status">@(IsExtrapolated(context) ? "Not a measurement" : context.Correction?.Status.ToString() ?? "Pending")</MudTd>
                    <MudTd><MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(() => DeleteSurveyStation(context))" /></MudTd>
                </RowTemplate>
            </MudTable>

            <MudExpansionPanels Class="mt-4">
                <MudExpansionPanel Text="Calculated survey run" ExpandedChanged="@OnCalculatedStationsPanelExpandedChanged">
                    <MudToolBar>
                        <MudText Typo="Typo.h6">Calculated survey run</MudText>
                        <MudSpacer />
                        <MudButton OnClick="ExportCalculatedSurveyRunAsync" Color="@Color.Primary" Variant="Variant.Outlined" Disabled="@isLoadingCalculatedStations_">Export</MudButton>
                    </MudToolBar>
                    @if (surveyRun.TieInPoint is { } tieInPoint)
                    {
                        <MudGrid Class="mb-4">
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle1">Tie in point</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText>Measured Depth: @FormatDepthValue(tieInPoint.MD)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText>Inclination: @FormatAngleValue(tieInPoint.Inclination)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText>Azimuth: @FormatAzimuthValue(tieInPoint.Azimuth)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText>Vertical Depth: @FormatDepthValue(tieInPoint.TVD)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
