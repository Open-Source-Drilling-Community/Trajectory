                    else if (surveyRun.SurveyStationList is { Count: > 0 } calculatedList)
                    {
                        <SurveyStationEllipseTable SurveyStationList="@calculatedList"
                                                   SurveyInstrumentID="@surveyRun.SurveyInstrumentID"
                                                   SourceSurveyRunID="@surveyRun.MetaInfo?.ID"
                                                   CalculationName="@($"{surveyRun.Name} uncertainty ellipses")"
                                                   EllipseResultsChanged="OnEllipseResultsChanged"
                                                   CalculationChanged="OnEllipseCalculationChanged" />
                    }
                </MudExpansionPanel>
                <MudExpansionPanel Text="Plot survey run" Style="overflow: visible;" ExpandedChanged="@OnCalculatedStationsPanelExpandedChanged">
                    @if (isLoadingCalculatedStations_)
                    {
                        <MudPaper Class="pa-4" Outlined="true">
                            <MudText Typo="Typo.body2">@CalculatedStationLoadingText</MudText>
                            <MudProgressLinear Value="@CalculatedStationLoadingProgressPercent" Color="Color.Info" Class="mt-2" />
                        </MudPaper>
                    }
                    else if (surveyRun.SurveyStationList is { Count: > 0 })
                    {
                        <MudToolBar>
                            <MudText Typo="Typo.h6">Plot</MudText>
                        </MudToolBar>
                        <MudGrid Justify="Justify.Center">
                            <MudItem xs="12">
                                <Scatter3DPlot NameList="@ThreeDNameList" ModeFlagList="@ThreeDModeFlagList" ColorList="@ThreeDColorList"
                                               ShowLegendList="@ThreeDShowLegendList"
                                               XValuesList="@ThreeDNorthValuesList" YValuesList="@ThreeDEastValuesList" ZValuesList="@ThreeDTvdValuesList"
                                               YAxisReversed="@true" ZAxisReversed="@true"
                                               PlotTitle="" XAxisTitle="@NorthCoordinateLabel" YAxisTitle="@EastCoordinateLabel" ZAxisTitle="TVD"
                                               XUnit="PositionDrilling" YUnit="PositionDrilling" ZUnit="DepthDrilling"
                                               XAxisUsesPositionReference="@true"
                                               YAxisUsesPositionReference="@true"
                                               ZAxisUsesDepthReference="@true"
                                               XAxisPositionDirection="@PositionDirectionType.North"
                                               YAxisPositionDirection="@PositionDirectionType.East">
                                </Scatter3DPlot>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <ScatterPlot NameList="@HorizontalNameList" ModeFlagList="@HorizontalModeFlagList" ColorList="@HorizontalColorList"
                                             ShowLegendList="@HorizontalShowLegendList"
                                             XValuesList="@HorizontalEastValuesList" YValuesList="@HorizontalNorthValuesList"
                                             PlotTitle="" XAxisTitle="@EastCoordinateLabel" YAxisTitle="@NorthCoordinateLabel"
                                             XUnit="PositionDrilling" YUnit="PositionDrilling"
                                             XAxisUsesPositionReference="@true"
                                             YAxisUsesPositionReference="@true"
                                             XAxisPositionDirection="@PositionDirectionType.East"
                                             YAxisPositionDirection="@PositionDirectionType.North"
                                             AspectRatio="1">
                                </ScatterPlot>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <ScatterPlot NameList="@VerticalNameList" ModeFlagList="@VerticalModeFlagList" ColorList="@VerticalColorList"
                                             ShowLegendList="@VerticalShowLegendList"
                                             XValuesList="@VerticalSectionValuesList" YValuesList="@VerticalTvdValuesList"
                                             PlotTitle="" XAxisTitle="Vertical Section" YAxisTitle="TVD"
                                             XUnit="DepthDrilling" YUnit="DepthDrilling"
                                             XAxisStartsAtZero="@true"
                                             YAxisUsesDepthReference="@true"
                                             YAxisReversed="@true"
                                             AspectRatio="1">
                                </ScatterPlot>
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudText>No calculated survey run</MudText>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
    else if (surveyRunList_ == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (isReferenceDataLoading_)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-1" />
            <MudText Typo="Typo.caption" Class="mb-2">
                Loading fields, clusters, wells, wellbores, rigs, and survey instruments…
                @if (pendingSurveyRunId_ != null)
                {
                    <span> The selected Survey Run will open when loading finishes.</span>
                }
            </MudText>
        }
        <TrajectoryResourceFilter Class="mb-4" Fields="@(fieldList_ ?? [])" Clusters="@(clusterList_ ?? [])"
                                  Wells="@(wellList_ ?? [])" WellBores="@(wellBoreList_ ?? [])"
                                  FieldId="@listSelectedFieldId_" FieldIdChanged="OnListFieldChanged"
                                  ClusterId="@listSelectedClusterId_" ClusterIdChanged="OnListClusterChanged"
                                  WellId="@listSelectedWellId_" WellIdChanged="OnListWellChanged"
                                  WellBoreId="@listSelectedWellBoreId_" WellBoreIdChanged="OnListWellBoreChanged"
                                  Disabled="@(!referenceDataAvailable_)" />

        <MudDataGrid T="SurveyRunLight" @key="gridKey_"
                     MultiSelection="true" Items="@surveyRunList_" SelectedItemsChanged="@SelectedItemsChanged"
                     Hover="true" RowClick="@RowClicked"
                     SortMode="SortMode.Multiple" QuickFilter="@SurveyRunFilter" Filterable="false"
                     ReadOnly="true" ColumnResizeMode="ResizeMode.Column" Elevation="0">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Survey Run</MudText>
                <MudButton OnClick="@AddSurveyRun" Color="@Color.Success" Class="add-item-btn" Disabled="@(!referenceDataAvailable_)">Add</MudButton>
                <MudButton OnClick="@DeleteSelectedSurveyRunsAsync" Color="@Color.Error" Class="add-item-btn"
                           Disabled="@(selectedSurveyRunList_.Count == 0)">Delete</MudButton>
                <MudSpacer />
                <MudTextField @bind-Value="searchString_" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <Columns>
                <SelectColumn T="SurveyRunLight" />
                <PropertyColumn Property="x => x.Name" Title="Survey Run" CellStyle="width: 25%;" Sortable="true" Editable="false" />
                <PropertyColumn Property="x => x.Description" Title="Description" CellStyle="width: 30%;" Sortable="true" Editable="false" />
                <PropertyColumn Property="x => GetWellBoreNameFromID(x.WellBoreID)" Title="WellBore" Sortable="true" />
                <PropertyColumn Property="x => GetSurveyInstrumentNameFromID(x.SurveyInstrumentID)" Title="Survey Instrument" Sortable="true" />
                <PropertyColumn Property="x => x.SurveyRunType" Title="Type" Sortable="true" />
                <TemplateColumn Title="Calculation" Sortable="true">
                    <CellTemplate>
                        @CalculationStatusContent(context.Item)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="(() => DeleteSurveyRunAsync(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="SurveyRunLight" />
            </PagerContent>
        </MudDataGrid>
    }
</MudUnitAndReferenceChoiceTag>

@code {
    [CascadingParameter]
    private MudUnitAndReferenceChoiceTag? Parent { get; set; }

    private MudUnitAndReferenceChoiceTag? unitReferenceTag_;
    private List<SurveyRunLight>? allSurveyRunList_;
    private List<SurveyRun>? allSurveyRunHeavyList_;
    private List<SurveyRunLight>? surveyRunList_;
    private List<SurveyRunLight> selectedSurveyRunList_ = [];
    private SurveyRun? currentSurveyRun_;
    private static readonly SurveyRunType[] SurveyRunTypes = Enum.GetValues<SurveyRunType>();
    private static readonly TrajectoryCalculationType[] TrajectoryCalculationTypes = Enum.GetValues<TrajectoryCalculationType>();

    private List<Field>? fieldList_;
    private List<Cluster>? clusterList_;
    private List<Well>? wellList_;
    private List<WellBore>? wellBoreList_;
    private List<Rig>? rigList_;
    private List<SurveyInstrumentLight>? surveyInstrumentList_;

    private bool isEditing_;
    private bool isReferenceDataLoading_ = true;
    private bool referenceDataAvailable_;
    private Guid? pendingSurveyRunId_;
    private bool isNavigationConfirmationOpen_;
    private bool hasRenderedUnitReference_;
    private string? cleanSurveyRunSnapshot_;
    private Guid? surveyRunIdBeingEdited_;
    private Guid? selectedFieldId_;
    private Guid? selectedClusterId_;
    private Guid? selectedWellId_;
    private Guid? selectedWellBoreId_;
    private Guid? selectedRigJobId_;
    private Guid? selectedSurveyInstrumentId_;
    private Guid? selectedParentSurveyRunId_;
    private Guid? listSelectedFieldId_;
    private Guid? listSelectedClusterId_;
    private Guid? listSelectedWellId_;
    private Guid? listSelectedWellBoreId_;
    private string? searchString_;
    private int gridKey_;
    private CancellationTokenSource? calculationPollingCancellation_;
    private int measurementReferenceRenderVersion_;
    private bool isLoadingCalculatedStations_;
    private bool calculatedStationLoadComplete_;
    private int calculatedStationChunkCount_;
    private int calculatedStationChunksLoaded_;
    private int calculatedStationsLoaded_;
    private HashSet<SurveyMeasurement> selectedSurveyStations_ = [];
    private SurveyInclinationReference bulkInclinationReference_ = SurveyInclinationReference.InheritRun;
    private SurveyAzimuthReference bulkAzimuthReference_ = SurveyAzimuthReference.InheritRun;
    private string? bulkMeasurementTimeUtc_;
    private const int SurveyMeasurementChunkSize = 5000;
    private const string SidetrackTieInAnnotation = "Sidetrack tie-in";

    private readonly List<string> nameList = [];
    private readonly List<int> modeFlagList = [];
    private readonly List<string> colorList = [];
    private readonly List<List<object>> northValuesList = [];
    private readonly List<List<object>> eastValuesList = [];
    private readonly List<List<object>> tvdValuesList = [];
    private readonly List<List<object>> verticalSectionValuesList = [];
    private readonly EllipsePlotData ellipsePlotData = new();
    private List<SurveyStationEllipseResult> ellipseResults = [];
    private SurveyStationEllipseCalculation? ellipseCalculation;

    private List<string> HorizontalNameList => Combine(nameList, ellipsePlotData.HorizontalNameList);
    private List<int> HorizontalModeFlagList => Combine(modeFlagList, ellipsePlotData.HorizontalModeFlagList);
    private List<string> HorizontalColorList => Combine(colorList, ellipsePlotData.HorizontalColorList);
    private List<bool> HorizontalShowLegendList => CombineLegendFlags(nameList.Count, ellipsePlotData.HorizontalShowLegendList);
    private List<List<object>> HorizontalEastValuesList => Combine(eastValuesList, ellipsePlotData.HorizontalEastValuesList);
    private List<List<object>> HorizontalNorthValuesList => Combine(northValuesList, ellipsePlotData.HorizontalNorthValuesList);

    private List<string> VerticalNameList => Combine(nameList, ellipsePlotData.VerticalNameList);
    private List<int> VerticalModeFlagList => Combine(modeFlagList, ellipsePlotData.VerticalModeFlagList);
    private List<string> VerticalColorList => Combine(colorList, ellipsePlotData.VerticalColorList);
    private List<bool> VerticalShowLegendList => CombineLegendFlags(nameList.Count, ellipsePlotData.VerticalShowLegendList);
    private List<List<object>> VerticalSectionValuesList => Combine(verticalSectionValuesList, ellipsePlotData.VerticalSectionValuesList);
    private List<List<object>> VerticalTvdValuesList => Combine(tvdValuesList, ellipsePlotData.VerticalTvdValuesList);

    private List<string> ThreeDNameList => Combine(nameList, ellipsePlotData.PerpendicularNameList);
    private List<int> ThreeDModeFlagList => Combine(modeFlagList, ellipsePlotData.PerpendicularModeFlagList);
    private List<string> ThreeDColorList => Combine(colorList, ellipsePlotData.PerpendicularColorList);
    private List<bool> ThreeDShowLegendList => CombineLegendFlags(nameList.Count, ellipsePlotData.PerpendicularShowLegendList);
    private List<List<object>> ThreeDNorthValuesList => Combine(northValuesList, ellipsePlotData.PerpendicularNorthValuesList);
    private List<List<object>> ThreeDEastValuesList => Combine(eastValuesList, ellipsePlotData.PerpendicularEastValuesList);
    private List<List<object>> ThreeDTvdValuesList => Combine(tvdValuesList, ellipsePlotData.PerpendicularTvdValuesList);

    private static List<T> Combine<T>(IEnumerable<T> first, IEnumerable<T> second) => first.Concat(second).ToList();
    private static List<bool> CombineLegendFlags(int baseTraceCount, IEnumerable<bool> ellipseFlags) =>
        Enumerable.Repeat(true, baseTraceCount).Concat(ellipseFlags).ToList();
    private double CalculatedStationLoadingProgressPercent =>
        calculatedStationChunkCount_ <= 0 ? 0.0 : 100.0 * calculatedStationChunksLoaded_ / calculatedStationChunkCount_;
    private string CalculatedStationLoadingText =>
        calculatedStationChunkCount_ <= 0
            ? "Loading calculated survey run chunks..."
            : $"Loading calculated survey run chunks {calculatedStationChunksLoaded_}/{calculatedStationChunkCount_} ({calculatedStationsLoaded_:N0} stations)";

    private IBrowserFile? surveyImportFile_;
    private string surveyImportFileName_ = "No file selected";
    private string selectedSurveyImportFormat_ = "Separated";
    private static readonly string[] SurveyImportFormats_ = ["Separated", "Fixed width"];
    private string selectedSurveyImportSeparator_ = "Semicolon (;)";
    private static readonly string[] SurveyImportSeparators_ = ["Semicolon (;)", "Tab", "Space"];
    private string selectedSurveyImportDecimalMarker_ = "Auto";
    private static readonly string[] SurveyImportDecimalMarkers_ = ["Auto", "Dot (.)", "Comma (,)"];
    private string selectedSurveyImportMDUnit_ = DepthDrillingQuantity.Instance.GetUnitChoice(DepthDrillingQuantity.UnitChoicesEnum.Metre).UnitName;
    private string selectedSurveyImportInclinationUnit_ = PlaneAngleDrillingQuantity.Instance.GetUnitChoice(PlaneAngleDrillingQuantity.UnitChoicesEnum.Degree).UnitName;
    private string selectedSurveyImportAzimuthUnit_ = PlaneAngleDrillingQuantity.Instance.GetUnitChoice(PlaneAngleDrillingQuantity.UnitChoicesEnum.Degree).UnitName;
    private int surveyImportMDColumn_ = 1;
    private int surveyImportInclinationColumn_ = 2;
    private int surveyImportAzimuthColumn_ = 3;
    private int surveyImportTimeColumn_;
    private int surveyImportMDStart_ = 1;
    private int surveyImportMDWidth_ = 12;
    private int surveyImportInclinationStart_ = 13;
    private int surveyImportInclinationWidth_ = 12;
    private int surveyImportAzimuthStart_ = 25;
    private int surveyImportAzimuthWidth_ = 12;
    private int surveyImportTimeStart_;
    private int surveyImportTimeWidth_ = 25;
    private static readonly JsonSerializerOptions SurveyRunDirtySnapshotJsonOptions = new()
    {
        WriteIndented = false
    };

    private IEnumerable<SurveyMeasurement> SurveyMeasurements => currentSurveyRun_?.SurveyMeasurementList ?? [];
    private IEnumerable<SurveyMeasurement> MeasuredSurveyMeasurements =>
        SurveyMeasurements.Where(measurement => measurement.Origin == SurveyMeasurementOrigin.Measured);
    private bool HasBitExtrapolation => currentSurveyRun_?.BitExtrapolation != null;

    private string MeasurementReferenceRenderKey =>
        $"{DataUtils.UnitAndReferenceParameters.UnitSystemName}|{DataUtils.UnitAndReferenceParameters.DepthReferenceName}|{DataUtils.UnitAndReferenceParameters.AzimuthReferenceName}|{measurementReferenceRenderVersion_}";

    private MudUnitAndReferenceChoiceTag? UnitReference => unitReferenceTag_ ?? Parent;
    private string DepthUnitLabel => UnitReference?.GetDepthUnitLabel("DepthDrilling") ?? string.Empty;
    private string LengthUnitLabel => UnitReference?.GetUnitLabel("DepthDrilling") ?? string.Empty;
    private string AngleUnitLabel => UnitReference?.GetUnitLabel("PlaneAngleDrilling") ?? string.Empty;
    private string AzimuthUnitLabel => UnitReference?.GetAzimuthUnitLabel("PlaneAngleDrilling") ?? string.Empty;
    private string PositionUnitLabel => UnitReference?.GetUnitLabel("PositionDrilling") ?? string.Empty;
    private string CurvatureUnitLabel => UnitReference?.GetUnitLabel("CurvatureDrilling") ?? string.Empty;

    private bool IsDelimitedImportFormat => selectedSurveyImportFormat_ == "Separated";

    private List<string> AvailableSurveyImportDepthUnits =>
        GetAvailableSurveyImportUnits(DepthDrillingQuantity.UnitChoiceDescriptions);

    private List<string> AvailableSurveyImportAngleUnits =>
        GetAvailableSurveyImportUnits(PlaneAngleDrillingQuantity.UnitChoiceDescriptions);

    private List<SurveyInstrumentLight> AvailableSurveyInstruments =>
        surveyInstrumentList_?
            .Where(instrument => instrument?.MetaInfo != null)
            .OrderBy(instrument => instrument.Name)
            .ToList() ?? [];

    private bool IsParentSurveyRunRequired =>
        currentSurveyRun_?.SurveyMeasurementList is { Count: > 0 } &&
        (IsSelectedWellBoreSidetrack() ||
        (GetFirstSurveyStationMd(currentSurveyRun_) is { } firstMd &&
        GetSelectedWellheadMd() is { } wellheadMd &&
        firstMd > wellheadMd));

    private List<SurveyRun> AvailableParentSurveyRuns =>
        allSurveyRunHeavyList_?
            .Where(surveyRun =>
                surveyRun?.MetaInfo?.ID is Guid surveyRunId &&
                surveyRunId != currentSurveyRun_?.MetaInfo?.ID &&
                IsParentSurveyRunCandidate(surveyRun))
            .OrderBy(surveyRun => surveyRun.Name)
            .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!hasRenderedUnitReference_ && unitReferenceTag_ != null)
        {
            hasRenderedUnitReference_ = true;
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isEditing_ = false;
            cleanSurveyRunSnapshot_ = null;
            surveyRunIdBeingEdited_ = null;
            selectedSurveyRunList_ = [];
            surveyRunList_ = [];
            isReferenceDataLoading_ = true;
            referenceDataAvailable_ = false;
            pendingSurveyRunId_ = null;

            Task<TrajectoryReferenceDataSnapshot> referenceDataTask = ReferenceData.GetSnapshotAsync();
            var surveyRunTask = Api.ClientTrajectory.GetAllSurveyRunLightAsync();

            // Do not hold the page behind reference catalogs. The Survey Run list is independently
            // useful and normally much faster, so render it as soon as its lightweight call finishes.
            allSurveyRunList_ = ((IEnumerable<SurveyRunLight>)await surveyRunTask)
                .Where(item => item != null)
                .OrderBy(item => item.Name)
                .ToList();
            allSurveyRunHeavyList_ = [];
            surveyRunList_ = ApplySurveyRunFilters();
            gridKey_++;
            StartCalculationPollingIfNeeded();
            await InvokeAsync(StateHasChanged);

            TrajectoryReferenceDataSnapshot referenceData = await referenceDataTask;
            fieldList_ = referenceData.Fields.ToList();
            clusterList_ = referenceData.Clusters.ToList();
            wellList_ = referenceData.Wells.ToList();
            wellBoreList_ = referenceData.WellBores.ToList();
            rigList_ = referenceData.Rigs.ToList();
            surveyInstrumentList_ = referenceData.SurveyInstruments.ToList();
            surveyRunList_ = ApplySurveyRunFilters();
            isReferenceDataLoading_ = false;
            referenceDataAvailable_ = true;
            if (pendingSurveyRunId_ is Guid pendingSurveyRunId)
            {
                pendingSurveyRunId_ = null;
                await EditSurveyRunAsync(pendingSurveyRunId);
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            isReferenceDataLoading_ = false;
            logger.LogError(ex, "Problem while loading Survey Run data");
            Snackbar.Add("Problem while loading Survey Run data: " + ex.Message, Severity.Error);
        }
    }

    private RenderFragment CalculationStatusContent(SurveyRunLight surveyRun) => @<div style="min-width: 140px;">
        @if (surveyRun.CalculationState == CalculationState.Running || surveyRun.CalculationState == CalculationState.Queued)
        {
            <MudText Typo="Typo.caption">@surveyRun.CalculationState</MudText>
            <MudProgressLinear Value="@(100.0 * surveyRun.CalculationProgress)" Color="Color.Info" Size="Size.Small" />
        }
        else if (surveyRun.CalculationState == CalculationState.Failed)
        {
            <MudText Typo="Typo.caption" Color="Color.Error">@surveyRun.CalculationState</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption">@surveyRun.CalculationState</MudText>
        }
    </div>;

    private void StartCalculationPollingIfNeeded()
    {
        if (surveyRunList_?.Any(IsCalculationActive) != true || calculationPollingCancellation_ != null)
        {
            return;
        }

        calculationPollingCancellation_ = new CancellationTokenSource();
        _ = PollCalculationProgressAsync(calculationPollingCancellation_.Token);
    }

    private async Task PollCalculationProgressAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
                allSurveyRunList_ = ((IEnumerable<SurveyRunLight>)await Api.ClientTrajectory.GetAllSurveyRunLightAsync()).OrderBy(item => item.Name).ToList();
                surveyRunList_ = ApplySurveyRunFilters();
                gridKey_++;
                await InvokeAsync(StateHasChanged);
                if (surveyRunList_?.Any(IsCalculationActive) != true)
                {
                    break;
                }
            }
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            calculationPollingCancellation_?.Dispose();
            calculationPollingCancellation_ = null;
        }
    }

    private static bool IsCalculationActive(SurveyRunLight surveyRun) =>
        surveyRun.CalculationState == CalculationState.Running ||
        surveyRun.CalculationState == CalculationState.Queued;

    private List<SurveyRunLight> ApplySurveyRunFilters()
    {
        IEnumerable<SurveyRunLight> query = allSurveyRunList_ ?? [];

        if (listSelectedFieldId_ is Guid fieldId)
        {
            query = query.Where(surveyRun => surveyRun.FieldID == fieldId);
        }
        if (listSelectedClusterId_ is Guid clusterId)
        {
            query = query.Where(surveyRun => surveyRun.ClusterID == clusterId);
        }
        if (listSelectedWellId_ is Guid wellId)
        {
            query = query.Where(surveyRun => surveyRun.WellID == wellId);
        }
        if (listSelectedWellBoreId_ is Guid wellBoreId)
        {
            query = query.Where(surveyRun => surveyRun.WellBoreID == wellBoreId);
        }

        return query.OrderBy(surveyRun => surveyRun.Name).ToList();
    }

