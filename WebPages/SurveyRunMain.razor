    private async Task DeleteSelectedSurveyRunsAsync()
    {
        List<SurveyRunLight> surveyRuns = selectedSurveyRunList_
            .Where(surveyRun => surveyRun?.MetaInfo?.ID is Guid id && id != Guid.Empty)
            .ToList();

        if (surveyRuns.Count == 0)
        {
            return;
        }

        try
        {
            bool confirmed = await ConfirmSurveyRunDeletionAsync(
                surveyRuns.Count == 1
                    ? "Do you really want to delete this Survey Run?"
                    : "Do you really want to delete these Survey Runs?",
                surveyRuns.Select(GetSurveyRunDisplayName).ToList());

            if (!confirmed)
            {
                return;
            }

            foreach (SurveyRunLight surveyRun in surveyRuns)
            {
                await Api.ClientTrajectory.DeleteSurveyRunByIdAsync(surveyRun.MetaInfo.ID, ConcurrencyToken.Require(surveyRun.LastModificationDate));
            }

            Snackbar.Add(surveyRuns.Count == 1 ? "Survey Run deleted successfully" : $"{surveyRuns.Count} Survey Runs deleted successfully", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem while deleting selected Survey Runs");
            Snackbar.Add("Problem while deleting selected Survey Runs: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteSurveyRunAsync(SurveyRunLight surveyRun)
    {
        if (surveyRun?.MetaInfo?.ID is not Guid id || id == Guid.Empty)
        {
            return;
        }

        try
        {
            bool result = await ConfirmSurveyRunDeletionAsync(
                "Do you really want to delete this Survey Run?",
                [GetSurveyRunDisplayName(surveyRun)]);

            if (result)
            {
                await Api.ClientTrajectory.DeleteSurveyRunByIdAsync(id, ConcurrencyToken.Require(surveyRun.LastModificationDate));
                Snackbar.Add("Survey Run deleted successfully", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem while deleting Survey Run {SurveyRunId}", id);
            Snackbar.Add("Problem while deleting Survey Run: " + ex.Message, Severity.Error);
        }
    }

    private async Task<bool> ConfirmSurveyRunDeletionAsync(string message, List<string> surveyRunNames)
    {
        DialogParameters parameters = new()
        {
            { nameof(DialogDeleteTemplate.Message), message },
            { nameof(DialogDeleteTemplate.Items), surveyRunNames }
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogDeleteTemplate>(
            "DELETE",
            parameters,
            TrajectoryDialogOptions.Compact);
        DialogResult? result = await dialog.Result;
        return result != null && !result.Canceled;
    }

    private async Task<bool> ConfirmCloseWithoutSavingAsync()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Unsaved changes",
            "Some changes have not been saved. Close without saving?",
            yesText: "Close without saving",
            cancelText: "Stay",
            options: TrajectoryDialogOptions.Compact);

        return result == true;
    }

    private async Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (!HasUnsavedSurveyRunChanges())
        {
            return;
        }

        if (isNavigationConfirmationOpen_)
        {
            context.PreventNavigation();
            return;
        }

        isNavigationConfirmationOpen_ = true;
        try
        {
            if (!await ConfirmCloseWithoutSavingAsync())
            {
                context.PreventNavigation();
                return;
            }

            cleanSurveyRunSnapshot_ = null;
        }
        finally
        {
            isNavigationConfirmationOpen_ = false;
        }
    }

