    private async Task ExportSurveyStationsAsync()
    {
        if (currentSurveyRun_?.SurveyMeasurementList is not { Count: > 0 } surveyMeasurements)
        {
            Snackbar.Add("No survey measurements to export", Severity.Warning);
            return;
        }

        string[] headers =
        [
            "Measurement ID", "Origin", "Measured Depth [m]", "Observed Inclination [rad]", "Inclination Reference",
            "Applied Inclination Correction [rad]", "Geodetic Inclination [rad]", "Observed Azimuth [rad]",
            "Azimuth Reference", "Applied Azimuth Correction [rad]", "True Azimuth [rad]", "Measurement Time UTC",
            "Correction Source", "Correction Status", "Correction Message", "Magnetic Declination [rad]",
            "Evaluation Latitude [rad]", "Evaluation Longitude [rad]", "Evaluation Depth WGS84 [m]", "Evaluation Time UTC",
            "Gravity Model ID", "Gravity Model Version", "Gravity Coefficient SHA256", "Geomagnetic Model ID",
            "Geomagnetic Metadata SHA256", "Geomagnetic Coefficient SHA256", "Correction Algorithm Version"
        ];
        string content = BuildTabSeparatedContent(headers, surveyMeasurements.Select(measurement => new[]
        {
            measurement.MeasurementID.ToString(), measurement.Origin.ToString(), FormatExportNumber(measurement.MD),
            FormatExportNumber(measurement.ObservedInclination ?? measurement.Inclination), measurement.InclinationReference.ToString(),
            FormatExportNumber(measurement.Correction?.AppliedInclinationCorrection), FormatExportNumber(measurement.Inclination),
            FormatExportNumber(measurement.ObservedAzimuth ?? measurement.Azimuth), measurement.AzimuthReference.ToString(),
            FormatExportNumber(measurement.Correction?.AppliedAzimuthCorrection), FormatExportNumber(measurement.Azimuth),
            FormatUtcInput(measurement.MeasurementTimeUtc), measurement.Correction?.Source.ToString() ?? string.Empty,
            measurement.Correction?.Status.ToString() ?? string.Empty, measurement.Correction?.Message ?? string.Empty,
            FormatExportNumber(measurement.Correction?.MagneticDeclination), FormatExportNumber(measurement.Correction?.EvaluatedLatitude),
            FormatExportNumber(measurement.Correction?.EvaluatedLongitude), FormatExportNumber(measurement.Correction?.EvaluatedDepthWgs84),
            FormatUtcInput(measurement.Correction?.EvaluationTimeUtc), measurement.Correction?.GravityModelID ?? string.Empty,
            measurement.Correction?.GravityModelVersion ?? string.Empty, measurement.Correction?.GravityCoefficientSHA256 ?? string.Empty,
            measurement.Correction?.GeomagneticModelID ?? string.Empty, measurement.Correction?.GeomagneticMetadataSHA256 ?? string.Empty,
            measurement.Correction?.GeomagneticCoefficientSHA256 ?? string.Empty, measurement.Correction?.AlgorithmVersion ?? string.Empty
        }));
        try
        {
            string surveyRunName = string.IsNullOrWhiteSpace(currentSurveyRun_.Name) ? "survey-run" : currentSurveyRun_.Name;
            string fileName = $"{SanitizeFileName(surveyRunName)}-survey-measurements.tsv";
            string base64Content = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));

            await JSRuntime.InvokeVoidAsync("trajectoryDownloads.saveTextFileFromBase64", fileName, base64Content, "text/tab-separated-values;charset=utf-8");
            Snackbar.Add("Exported survey measurements", Severity.Success);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error exporting survey stations");
            Snackbar.Add("Error exporting survey stations: " + ex.Message, Severity.Warning);
        }
    }

    private async Task ExportCalculatedSurveyRunAsync()
    {
        if (currentSurveyRun_?.SurveyStationList is not { Count: > 0 } calculatedStations)
        {
            Snackbar.Add("No calculated survey run to export", Severity.Warning);
            return;
        }
        if (UnitReference == null)
        {
            Snackbar.Add("Unit and reference settings are not ready", Severity.Warning);
            return;
        }

        string content = SurveyStationAsciiExport.BuildTabSeparated(UnitReference, calculatedStations);

        try
        {
            string surveyRunName = string.IsNullOrWhiteSpace(currentSurveyRun_.Name) ? "survey-run" : currentSurveyRun_.Name;
            string fileName = $"{SanitizeFileName(surveyRunName)}-calculated-survey-run.tsv";
            string base64Content = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));

            await JSRuntime.InvokeVoidAsync("trajectoryDownloads.saveTextFileFromBase64", fileName, base64Content, "text/tab-separated-values;charset=utf-8");
            Snackbar.Add("Exported calculated survey run", Severity.Success);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error exporting calculated survey run");
            Snackbar.Add("Error exporting calculated survey run: " + ex.Message, Severity.Warning);
        }
    }

    private static string BuildTabSeparatedContent(IEnumerable<string> headers, IEnumerable<IEnumerable<string>> rows)
    {
        StringBuilder builder = new();
        builder.AppendLine(string.Join('\t', headers.Select(SanitizeExportField)));

        foreach (IEnumerable<string> row in rows)
        {
            builder.AppendLine(string.Join('\t', row.Select(SanitizeExportField)));
        }

        return builder.ToString();
    }

    private static string FormatExportNumber(double? value) =>
        value?.ToString("G17", CultureInfo.InvariantCulture) ?? string.Empty;

    private static string SanitizeExportField(string? value) =>
        (value ?? string.Empty).Replace('\t', ' ').ReplaceLineEndings(" ");

    private static string SanitizeFileName(string value)
    {
        char[] invalidCharacters = Path.GetInvalidFileNameChars();
        string sanitized = new(value.Select(ch => invalidCharacters.Contains(ch) ? '-' : ch).ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "survey-run" : sanitized;
    }

    private static string FormatDate(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? string.Empty;
}


