    private int TrimSidetrackSurveyMeasurements(List<SurveyMeasurement> measurements)
    {
        if (!IsSelectedWellBoreSidetrack() ||
            GetSelectedParentTieInMd() is not { } tieInMd ||
            measurements.Count == 0)
        {
            return 0;
        }

        List<SurveyMeasurement> sortedMeasurements = measurements
            .Where(measurement => measurement?.MD is { } md && double.IsFinite(md))
            .OrderBy(measurement => measurement.MD)
            .ToList();

        if (sortedMeasurements.Count == 0)
        {
            int invalidCount = measurements.Count;
            measurements.Clear();
            return invalidCount;
        }

        double firstMd = sortedMeasurements.First().MD!.Value;
        double lastMd = sortedMeasurements.Last().MD!.Value;
        if (firstMd >= tieInMd)
        {
            return 0;
        }

        int trimmedCount = sortedMeasurements.Count(measurement => measurement.MD < tieInMd);
        if (lastMd < tieInMd)
        {
            measurements.Clear();
            return trimmedCount;
        }

        List<SurveyMeasurement> keptMeasurements = [];
        if (TryInterpolateSurveyMeasurement(sortedMeasurements, tieInMd, out SurveyMeasurement? tieInMeasurement) &&
            tieInMeasurement != null)
        {
            tieInMeasurement.Annotation = SidetrackTieInAnnotation;
            keptMeasurements.Add(tieInMeasurement);
        }

        keptMeasurements.AddRange(sortedMeasurements.Where(measurement => measurement.MD > tieInMd));
        measurements.Clear();
        measurements.AddRange(keptMeasurements);
        return trimmedCount;
    }

    private static bool TryInterpolateSurveyMeasurement(List<SurveyMeasurement> sortedMeasurements, double md, out SurveyMeasurement? measurement)
    {
        measurement = null;
        for (int i = 1; i < sortedMeasurements.Count; i++)
        {
            SurveyMeasurement previous = sortedMeasurements[i - 1];
            SurveyMeasurement next = sortedMeasurements[i];
            if (previous.MD is not { } previousMd ||
                next.MD is not { } nextMd ||
                previousMd > md ||
                nextMd < md)
            {
                continue;
            }

            double interval = nextMd - previousMd;
            if (!double.IsFinite(interval) || Math.Abs(interval) < double.Epsilon)
            {
                return false;
            }

            double fraction = (md - previousMd) / interval;
            measurement = new SurveyMeasurement
            {
                MD = md,
                Inclination = InterpolateNullable(previous.Inclination, next.Inclination, fraction),
                Azimuth = InterpolateNullable(previous.Azimuth, next.Azimuth, fraction)
            };
            return true;
        }

        return false;
    }

    private static double? InterpolateNullable(double? start, double? end, double fraction) =>
        start.HasValue && end.HasValue
            ? start.Value + (end.Value - start.Value) * fraction
            : null;

    private async Task UpdateSelectedSurveyRunReferenceSourceAsync()
    {
        DataUtils.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference = 0;
        DataUtils.MeanSeaLevelDepthReferenceSource.MeanSeaLevelDepthReference = null;
        DataUtils.SeaWaterLevelDepthReferenceSource.SeaWaterLevelDepthReference = 0;
        DataUtils.RotaryTableDepthReferenceSource.RotaryTableDepthReference = 0;
        DataUtils.WellHeadPositionReferenceSource.WellHeadNorthPositionReference = 0;
        DataUtils.WellHeadPositionReferenceSource.WellHeadEastPositionReference = 0;
        DataUtils.ApplyFieldPositionReference(null);
        DataUtils.ClusterPositionReferenceSource.ClusterNorthPositionReference = 0;
        DataUtils.ClusterPositionReferenceSource.ClusterEastPositionReference = 0;

        if (selectedWellBoreId_ is not Guid wellBoreId)
        {
            measurementReferenceRenderVersion_++;
            return;
        }

        WellBore? wellBore = wellBoreList_?.FirstOrDefault(item => item?.MetaInfo?.ID == wellBoreId);
        Well? well = wellBore?.WellID is Guid wellId
            ? wellList_?.FirstOrDefault(item => item?.MetaInfo?.ID == wellId)
            : null;
        Cluster? cluster = well?.ClusterID is Guid clusterId
            ? clusterList_?.FirstOrDefault(item => item?.MetaInfo?.ID == clusterId)
            : null;
        Field? field = fieldList_?.FirstOrDefault(item => item?.MetaInfo?.ID == (currentSurveyRun_?.FieldID ?? cluster?.FieldID));
        if (cluster?.GroundMudLineDepth?.GaussianValue?.Mean is { } groundMudLineDepth)
        {
            DataUtils.ApplyGroundMudLineDepthWGS84(groundMudLineDepth);
        }
        if (cluster?.TopWaterDepth?.GaussianValue?.Mean is { } topWaterDepth)
        {
            DataUtils.ApplyTopWaterDepthWGS84(topWaterDepth);
        }
        DataUtils.ApplyRotaryTableDepthnWGS84(DataUtils.ResolveDrillFloorDepthWgs84(
            wellBore, cluster, rigList_, selectedRigJobId_, CurrentSurveyRunReferenceDate));
        TrajectoryReferenceDatumUtils.Apply(
            await TrajectoryReferenceDatumUtils.ResolveForWellBoreAsync(Api, wellBoreId, wellBoreList_, wellList_, clusterList_));

        DataUtils.ApplyFieldPositionReference(field);
        await CartographicPositionReferenceUtils.ApplyAsync(Api, field, logger);
        UpdateClusterPositionReference(cluster);
        UpdateWellheadPositionReference(well, cluster);
        measurementReferenceRenderVersion_++;
    }

