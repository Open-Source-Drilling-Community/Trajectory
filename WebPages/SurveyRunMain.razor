    private bool SurveyRunFilter(SurveyRunLight surveyRun)
    {
        if (string.IsNullOrWhiteSpace(searchString_))
        {
            return true;
        }

        return Contains(surveyRun.Name, searchString_) ||
               Contains(surveyRun.Description, searchString_) ||
               Contains(GetWellBoreNameFromID(surveyRun.WellBoreID), searchString_) ||
               Contains(GetSurveyInstrumentNameFromID(surveyRun.SurveyInstrumentID), searchString_) ||
               Contains(surveyRun.SurveyRunType.ToString(), searchString_);
    }

