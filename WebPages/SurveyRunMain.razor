    private void OnInclinationCorrectionChanged(SurveyMeasurement measurement, double? value)
    {
        measurement.Correction ??= SurveyMeasurement.CreatePendingCorrection();
        measurement.EnsureCorrectionContractDefaults();
        measurement.Correction.AppliedInclinationCorrection = value;
        measurement.Correction.Source = SurveyCorrectionSource.ManualOverride;
        measurement.Correction.Status = value.HasValue ? SurveyCorrectionStatus.Completed : SurveyCorrectionStatus.Pending;
        if (GetObservedInclination(measurement) is { } observed && value is { } correction)
            measurement.Inclination = observed + correction;
        ClearCalculatedSurveyRunData();
    }

    private void OnAzimuthCorrectionChanged(SurveyMeasurement measurement, double? value)
    {
        measurement.Correction ??= SurveyMeasurement.CreatePendingCorrection();
        measurement.EnsureCorrectionContractDefaults();
        measurement.Correction.AppliedAzimuthCorrection = value;
        measurement.Correction.Source = SurveyCorrectionSource.ManualOverride;
        measurement.Correction.Status = value.HasValue ? SurveyCorrectionStatus.Completed : SurveyCorrectionStatus.Pending;
        if (GetObservedAzimuth(measurement) is { } observed && value is { } correction)
            measurement.Azimuth = NormalizeAzimuth(observed + correction);
        ClearCalculatedSurveyRunData();
    }

    private static void MarkCorrectionPending(SurveyMeasurement measurement)
    {
        measurement.Correction = SurveyMeasurement.CreatePendingCorrection();
    }

    private static double NormalizeAzimuth(double value)
    {
        double normalized = value % (2.0 * Math.PI);
        return normalized < 0.0 ? normalized + 2.0 * Math.PI : normalized;
    }

    private static string FormatUtcInput(DateTimeOffset? value) => value?.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss'Z'", CultureInfo.InvariantCulture) ?? string.Empty;

    private void SetAcquisitionStart(string? value)
    {
        if (TryParseUtcInput(value, out DateTimeOffset? parsed))
        {
            currentSurveyRun_!.AcquisitionStartUtc = parsed;
            InvalidateReferenceCorrections(measurement =>
                (measurement.AzimuthReference == SurveyAzimuthReference.InheritRun
                    ? currentSurveyRun_.DefaultAzimuthReference
                    : measurement.AzimuthReference) == SurveyAzimuthReference.MagneticNorth);
        }
        else Snackbar.Add("Acquisition start must be a valid UTC date-time.", Severity.Warning);
    }

    private void SetAcquisitionEnd(string? value)
    {
        if (TryParseUtcInput(value, out DateTimeOffset? parsed))
        {
            currentSurveyRun_!.AcquisitionEndUtc = parsed;
            InvalidateReferenceCorrections(measurement =>
                (measurement.AzimuthReference == SurveyAzimuthReference.InheritRun
                    ? currentSurveyRun_.DefaultAzimuthReference
                    : measurement.AzimuthReference) == SurveyAzimuthReference.MagneticNorth);
        }
        else Snackbar.Add("Acquisition end must be a valid UTC date-time.", Severity.Warning);
    }

    private void SetMeasurementTime(SurveyMeasurement measurement, string? value)
    {
        if (TryParseUtcInput(value, out DateTimeOffset? parsed))
        {
            measurement.MeasurementTimeUtc = parsed;
            MarkCorrectionPending(measurement);
            ClearCalculatedSurveyRunData();
        }
        else Snackbar.Add("Measurement time must be a valid UTC date-time.", Severity.Warning);
    }

    private static bool TryParseUtcInput(string? value, out DateTimeOffset? parsed)
    {
        parsed = null;
        if (string.IsNullOrWhiteSpace(value)) return true;
        if (!DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out DateTimeOffset dateTime)) return false;
        parsed = dateTime.ToUniversalTime();
        return true;
    }
