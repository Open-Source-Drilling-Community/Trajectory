        double lastMD = currentSurveyRun_.SurveyMeasurementList
            .Select(measurement => measurement.MD ?? 0)
            .DefaultIfEmpty(0)
            .Max();
        currentSurveyRun_.SurveyMeasurementList.Add(new SurveyMeasurement { MeasurementID = Guid.NewGuid(), MD = lastMD + 10.0, Inclination = 0, Azimuth = 0, ObservedInclination = 0, ObservedAzimuth = 0, InclinationReference = SurveyInclinationReference.InheritRun, AzimuthReference = SurveyAzimuthReference.InheritRun });
        if (currentSurveyRun_.BitExtrapolation?.Mode == SurveyRunBitExtrapolationMode.LastStationAlreadyExtrapolated)
        {
            MarkLastRowAsExtrapolated();
            SetDistanceFromLastIntervalIfUnset();
        }
        ClearInvalidParentSurveyRunSelection();
        ClearCalculatedSurveyRunData();
        UpdatePlots();
    }

