    private void MarkLastRowAsExtrapolated()
    {
        if (currentSurveyRun_?.SurveyMeasurementList is not { Count: > 0 } measurements) return;
        foreach (SurveyMeasurement measurement in measurements)
            measurement.Origin = SurveyMeasurementOrigin.Measured;
        SurveyMeasurement extrapolated = measurements.OrderBy(measurement => measurement.MD ?? double.MaxValue).Last();
        extrapolated.Origin = SurveyMeasurementOrigin.Extrapolated;
        ClearExtrapolatedMeasurementMetadata(extrapolated);
    }

    private void SetDistanceFromLastIntervalIfUnset()
    {
        if (currentSurveyRun_?.BitExtrapolation is not { MeasurementToolToBitDistance: <= 0.0 } configuration ||
            currentSurveyRun_.SurveyMeasurementList is not { Count: >= 2 } measurements) return;
        List<SurveyMeasurement> ordered = measurements.OrderBy(measurement => measurement.MD ?? double.MaxValue).ToList();
        if (ordered[^2].MD is double measuredMd && ordered[^1].MD is double extrapolatedMd && extrapolatedMd > measuredMd)
            configuration.MeasurementToolToBitDistance = extrapolatedMd - measuredMd;
    }

    private static void ClearExtrapolatedMeasurementMetadata(SurveyMeasurement measurement)
    {
        measurement.ObservedInclination = null;
        measurement.ObservedAzimuth = null;
        measurement.MeasurementTimeUtc = null;
        measurement.InclinationReference = SurveyInclinationReference.InheritRun;
        measurement.AzimuthReference = SurveyAzimuthReference.InheritRun;
        measurement.Correction = null;
    }

    private bool ValidateBitExtrapolationForSave(SurveyRun surveyRun)
    {
        if (surveyRun.BitExtrapolation == null)
        {
            SetAllMeasurementOrigins(SurveyMeasurementOrigin.Measured);
            return true;
        }
        if (!double.IsFinite(surveyRun.BitExtrapolation.MeasurementToolToBitDistance) ||
            surveyRun.BitExtrapolation.MeasurementToolToBitDistance <= 0.0)
        {
            Snackbar.Add("Enter a positive measurement-tool-to-bit distance.", Severity.Warning);
            return false;
        }

        List<SurveyMeasurement> ordered = surveyRun.SurveyMeasurementList!
            .OrderBy(measurement => measurement.MD ?? double.MaxValue).ToList();
        if (surveyRun.BitExtrapolation.Mode == SurveyRunBitExtrapolationMode.CalculateFromLastMeasurement)
        {
            if (ordered.Any(measurement => measurement.Origin == SurveyMeasurementOrigin.Extrapolated))
            {
                Snackbar.Add("Calculated bit extrapolation accepts measured rows only.", Severity.Warning);
                return false;
            }
            return true;
        }

        if (ordered.Count < 2 || ordered.Count(measurement => measurement.Origin == SurveyMeasurementOrigin.Extrapolated) != 1 ||
            ordered[^1].Origin != SurveyMeasurementOrigin.Extrapolated)
        {
            Snackbar.Add("Exactly the final row must be marked as the extrapolated bit station.", Severity.Warning);
            return false;
        }
        if (ordered[^2].MD is not double measuredMd || ordered[^1].MD is not double extrapolatedMd)
        {
            Snackbar.Add("The last measured and extrapolated rows require measured depths.", Severity.Warning);
            return false;
        }
        double distance = surveyRun.BitExtrapolation.MeasurementToolToBitDistance;
        double tolerance = Math.Max(1e-6, distance * 1e-8);
        if (Math.Abs((extrapolatedMd - measuredMd) - distance) > tolerance)
        {
            Snackbar.Add("The final MD increment must equal the measurement-tool-to-bit distance.", Severity.Warning);
            return false;
        }
        ClearExtrapolatedMeasurementMetadata(ordered[^1]);
        return true;
    }

