@inject ITrajectoryAPIUtils Api

<MudExpansionPanels Class="mt-4">
    <MudExpansionPanel Text="Identities and features">
        <MudToolBar Class="ml-n4"><MudText Typo="Typo.h6">Identities</MudText><MudSpacer /><MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddIdentity">Add</MudButton></MudToolBar>
        <MudTable Items="IdentityAssignments" Dense="true">
            <HeaderContent><MudTh>Identity</MudTh><MudTh>Value</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><MudSelect T="Guid?" @bind-Value="context.IdentityID" Dense="true">@foreach (TrajectoryIdentity identity in identities) { <MudSelectItem T="Guid?" Value="@((Guid?)identity.MetaInfo.ID)">@identity.Name</MudSelectItem> }</MudSelect></MudTd>
                <MudTd><MudTextField @bind-Value="context.Value" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => IdentityAssignments.Remove(context))" /></MudTd>
            </RowTemplate>
        </MudTable>

        <MudToolBar Class="ml-n4 mt-4"><MudText Typo="Typo.h6">Features</MudText><MudSpacer /><MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddFeature">Add</MudButton></MudToolBar>
        <MudTable Items="FeatureAssignments" Dense="true">
            <HeaderContent><MudTh>Category</MudTh><MudTh>Option</MudTh><MudTh>From</MudTh><MudTh>To</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><MudSelect T="Guid?" Value="context.FeatureCategoryID" ValueChanged="@(value => SetCategory(context, value))" Dense="true">@foreach (TrajectoryFeatureCategory category in categories) { <MudSelectItem T="Guid?" Value="@((Guid?)category.MetaInfo.ID)">@category.Name</MudSelectItem> }</MudSelect></MudTd>
                <MudTd><MudSelect T="Guid?" @bind-Value="context.FeatureOptionID" Dense="true">@foreach (TrajectoryFeatureOption option in OptionsFor(context)) { <MudSelectItem T="Guid?" Value="@((Guid?)option.ID)">@option.Name</MudSelectItem> }</MudSelect></MudTd>
                <MudTd><MudDatePicker Date="@ToDateTime(context.FromDate)" DateChanged="@(value => context.FromDate = ToOffset(value))" Disabled="@(!HasValidity(context))" /></MudTd>
                <MudTd><MudDatePicker Date="@ToDateTime(context.ToDate)" DateChanged="@(value => context.ToDate = ToOffset(value))" Disabled="@(!HasValidity(context))" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => FeatureAssignments.Remove(context))" /></MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public ICollection<TrajectoryIdentityAssignment> IdentityAssignments { get; set; } = new List<TrajectoryIdentityAssignment>();
    [Parameter, EditorRequired] public ICollection<TrajectoryFeatureAssignment> FeatureAssignments { get; set; } = new List<TrajectoryFeatureAssignment>();
    private List<TrajectoryIdentity> identities = [];
    private List<TrajectoryFeatureCategory> categories = [];
    protected override async Task OnInitializedAsync()
    {
        identities = (await Api.ClientTrajectory.GetAllTrajectoryIdentityAsync()).ToList();
        categories = (await Api.ClientTrajectory.GetAllTrajectoryFeatureCategoryAsync()).ToList();
    }
    private void AddIdentity() => IdentityAssignments.Add(new() { ID = Guid.NewGuid() });
    private void AddFeature() => FeatureAssignments.Add(new() { ID = Guid.NewGuid() });
    private IEnumerable<TrajectoryFeatureOption> OptionsFor(TrajectoryFeatureAssignment assignment) => categories.FirstOrDefault(category => category.MetaInfo.ID == assignment.FeatureCategoryID)?.Options ?? [];
    private bool HasValidity(TrajectoryFeatureAssignment assignment) => categories.FirstOrDefault(category => category.MetaInfo.ID == assignment.FeatureCategoryID)?.HasValidityPeriod == true;
    private void SetCategory(TrajectoryFeatureAssignment assignment, Guid? categoryId) { assignment.FeatureCategoryID = categoryId; assignment.FeatureOptionID = null; if (!HasValidity(assignment)) { assignment.FromDate = null; assignment.ToDate = null; } }
    private static DateTime? ToDateTime(DateTimeOffset? value) => value?.UtcDateTime;
    private static DateTimeOffset? ToOffset(DateTime? value) => value.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)) : null;
}
