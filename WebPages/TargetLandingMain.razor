@page "/TargetLanding"
@inject ILogger<TargetLandingMain> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData

@if (editing)
{
    <MudUnitAndReferenceChoiceTag HttpHost="@Api.HostNameUnitConversion" HttpBasePath="@Api.HostBasePathUnitConversion"
                                  HttpController="UnitSystem/" UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                                  UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName" EnableDateTimeReference="true"
                                  DateReferenceName="@DataUtils.UnitAndReferenceParameters.DateReferenceName"
                                  DateReferenceNameChanged="@((string value) => DataUtils.UpdateDateReferenceName(value))" DepthReferenceName="@DataUtils.UnitAndReferenceParameters.DepthReferenceName"
                                  DepthReferenceNameChanged="@DataUtils.UpdateDepthReferenceName"
                                  GroundMudLineDepthReferenceSource="@DataUtils.GroundMudLineDepthReferenceSource"
                                  MeanSeaLevelDepthReferenceSource="@DataUtils.MeanSeaLevelDepthReferenceSource"
                                  SeaWaterLevelDepthReferenceSource="@DataUtils.SeaWaterLevelDepthReferenceSource"
                                  RotaryTableDepthReferenceSource="@DataUtils.RotaryTableDepthReferenceSource"
                                  PositionReferenceName="@DataUtils.UnitAndReferenceParameters.PositionReferenceName"
                                  PositionReferenceNameChanged="@DataUtils.UpdatePositionReferenceName"
                                  WellHeadPositionReferenceSource="@DataUtils.WellHeadPositionReferenceSource"
                                  CartographicGridPositionReferenceSource="@DataUtils.CartographicGridPositionReferenceSource"
                                  FieldPositionReferenceSource="@DataUtils.FieldPositionReferenceSource"
                                  ClusterPositionReferenceSource="@DataUtils.ClusterPositionReferenceSource"
                                  GeodeticReferenceName="@DataUtils.UnitAndReferenceParameters.GeodeticReferenceName"
                                  GeodeticReferenceNameChanged="@DataUtils.UpdateGeodeticReferenceName"
                                  CartographicProjectionDatumGeodeticReferenceSource="@DataUtils.CartographicProjectionDatumGeodeticReferenceSource"
                                  AzimuthReferenceName="@DataUtils.UnitAndReferenceParameters.AzimuthReferenceName"
                                  AzimuthReferenceNameChanged="@DataUtils.UpdateAzimuthReferenceName"
                                  GridConvergenceSource="@DataUtils.GridConvergenceSource"
                                  MagneticDeclinationSource="@DataUtils.MagneticDeclinationSource">
        <TargetLandingEdit CaseId="@caseId" ValueChanged="CloseEditorAsync" />
    </MudUnitAndReferenceChoiceTag>
}
else
{
    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-2" />
    }
    <MudDataGrid T="TargetLandingCaseLight" Items="@cases" Hover="true" RowClick="OpenRow" ReadOnly="true"
                 QuickFilter="Filter" SortMode="SortMode.Multiple" Elevation="0">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Target Landing</MudText>
                <MudButton Color="Color.Success" OnClick="Add">Add</MudButton>
                <MudSpacer />
                <MudTextField @bind-Value="search" Placeholder="Search" Immediate="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Case" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => SourceName(x.SourceTrajectoryID)" Title="Source trajectory" />
                <PropertyColumn Property="x => x.TargetType" Title="Target" />
                <PropertyColumn Property="x => x.CurveType" Title="Curve" />
                <TemplateColumn Title="Calculation"><CellTemplate>
                    <MudText Typo="Typo.caption" Color="@(context.Item.CalculationState == CalculationState.Failed ? Color.Error : Color.Default)">
                        @context.Item.CalculationState @(context.Item.IsStale ? "(stale)" : null) @context.Item.CalculationMessage
                    </MudText>
                    @if (Active(context.Item)) { <MudProgressLinear Value="@(100 * context.Item.CalculationProgress)" Size="Size.Small" /> }
                </CellTemplate></TemplateColumn>
                <TemplateColumn><CellTemplate><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context.Item))" /></CellTemplate></TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="TargetLandingCaseLight" /></PagerContent>
    </MudDataGrid>
}

@code {
    private List<TargetLandingCaseLight> cases = [];
    private List<TrajectoryLight> trajectories = [];
    private Guid? caseId;
    private bool editing;
    private bool loading;
    private bool sourceNamesLoading;
    private string? search;
    private CancellationTokenSource? polling;

    protected override async Task OnInitializedAsync()
    {
        trajectories = ReferenceData.Current.Trajectories.ToList();
        await LoadAsync();

        if (trajectories.Count == 0)
        {
            sourceNamesLoading = true;
            _ = LoadTrajectoryNamesAsync();
        }
    }

    private async Task LoadAsync()
    {
        editing = false; caseId = null; StopPolling();
        loading = true;
        try
        {
            cases = (await Api.ClientTrajectory.GetAllTargetLandingCaseLightAsync()).OrderBy(x => x.Name).ToList();
            StartPollingIfNeeded();
        }
        catch (Exception ex) { logger.LogError(ex, "Unable to load target landing cases"); Snackbar.Add("Unable to load target landing cases.", Severity.Error); }
        finally { loading = false; }
    }

    private async Task LoadTrajectoryNamesAsync()
    {
        try
        {
            trajectories = (await ReferenceData.GetTrajectoriesAsync()).ToList();
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to load source trajectory names for target landing cases");
        }
        finally
        {
            sourceNamesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private void Add() { StopPolling(); caseId = null; editing = true; }
    private Task OpenRow(DataGridRowClickEventArgs<TargetLandingCaseLight> args) { StopPolling(); caseId = args.Item.MetaInfo.ID; editing = true; return Task.CompletedTask; }
    private Task CloseEditorAsync(TargetLandingCaseLight? persisted)
    {
        editing = false;
        caseId = null;
        StopPolling();
        if (persisted?.MetaInfo?.ID is Guid id && id != Guid.Empty)
        {
            int index = cases.FindIndex(item => item.MetaInfo?.ID == id);
            if (index >= 0) cases[index] = persisted;
            else cases.Add(persisted);
            cases = cases.OrderBy(item => item.Name).ToList();
        }
        StartPollingIfNeeded();
        return Task.CompletedTask;
    }
    private void StartPollingIfNeeded()
    {
        if (!cases.Any(Active)) return;
        polling = new CancellationTokenSource();
        _ = PollAsync(polling.Token);
    }
    private void StopPolling()
    {
        polling?.Cancel();
        polling?.Dispose();
        polling = null;
    }
    private string SourceName(Guid id) => trajectories.FirstOrDefault(x => x.MetaInfo?.ID == id)?.Name ??
        (sourceNamesLoading ? "Loading…" : "Unknown trajectory");
    private Func<TargetLandingCaseLight, bool> Filter => item => string.IsNullOrWhiteSpace(search) ||
        $"{item.Name} {item.Description} {SourceName(item.SourceTrajectoryID)} {item.TargetType} {item.CurveType}".Contains(search, StringComparison.OrdinalIgnoreCase);
    private static bool Active(TargetLandingCaseLight item) => item.CalculationState is CalculationState.Queued or CalculationState.Running;
    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && cases.Any(Active))
            {
                await Task.Delay(1000, token);
                foreach (TargetLandingCaseLight item in cases.Where(Active).ToList())
                {
                    TargetLandingCaseLight status = await Api.ClientTrajectory.GetTargetLandingCaseStatusAsync(item.MetaInfo.ID, token);
                    int index = cases.FindIndex(candidate => candidate.MetaInfo?.ID == status.MetaInfo?.ID);
                    if (index >= 0) cases[index] = status;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }
    private async Task DeleteAsync(TargetLandingCaseLight item)
    {
        bool? yes = await DialogService.ShowMessageBoxAsync("Delete target landing case", $"Delete '{item.Name}'?", yesText: "Delete", cancelText: "Cancel", options: TrajectoryDialogOptions.Compact);
        if (yes != true) return;
        try { await Api.ClientTrajectory.DeleteTargetLandingCaseByIdAsync(item.MetaInfo.ID, ConcurrencyToken.Require(item.LastModificationDate)); await LoadAsync(); }
        catch (Exception ex) { logger.LogError(ex, "Unable to delete target landing case"); Snackbar.Add("Unable to delete the target landing case.", Severity.Error); }
    }
}
