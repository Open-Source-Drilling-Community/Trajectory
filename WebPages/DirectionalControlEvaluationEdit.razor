@inject ILogger<DirectionalControlEvaluationEdit> logger
@implements IDisposable
@implements IUnitAwareComponent
@inject ISnackbar Snackbar
@inject ITrajectoryAPIUtils Api
@inject ITrajectoryReferenceDataCache ReferenceData

<MudText Typo="Typo.h6" Class="mt-4 mb-3">Directional Control Evaluation</MudText>
<MudStack Row="true" Class="mb-4">
    <MudButton Color="Color.Success" Disabled="@busy" OnClick="SaveAsync">Save and calculate</MudButton>
    <MudButton Color="Color.Error" Disabled="@busy" OnClick="@(() => ValueChanged.InvokeAsync())">Close</MudButton>
</MudStack>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="value.Name" Label="Name" Required="true" /></MudItem>
        <MudItem xs="12" md="8"><MudTextField @bind-Value="value.Description" Label="Description" /></MudItem>
    </MudGrid>

    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Wellbore and trajectories</MudText>
    <TrajectoryResourceFilter Fields="@fields" Clusters="@clusters" Wells="@wells" WellBores="@wellBores"
                              ResourceKind="TrajectoryResourceFilterKind.None"
                              FieldId="@fieldId" FieldIdChanged="SetField"
                              ClusterId="@clusterId" ClusterIdChanged="SetCluster"
                              WellId="@wellId" WellIdChanged="SetWell"
                              WellBoreId="@wellBoreId" WellBoreIdChanged="SetWellBore" />
    <MudGrid Class="mt-1">
        <MudItem xs="12" md="6">
            <MudAutocomplete Label="Reference trajectory" T="Guid?" Value="@ReferenceTrajectoryId" ValueChanged="SetReferenceTrajectory"
                             SearchFunc="SearchTrajectoriesAsync" ToStringFunc="GetTrajectoryName"
                             Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" MinCharacters="0" ShrinkLabel
                             Required="true" Disabled="@(wellBoreId == null)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudAutocomplete Label="Actual trajectory" T="Guid?" Value="@ActualTrajectoryId" ValueChanged="SetActualTrajectory"
                             SearchFunc="SearchTrajectoriesAsync" ToStringFunc="GetTrajectoryName"
                             Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" MinCharacters="0" ShrinkLabel
                             Required="true" Disabled="@(wellBoreId == null)" />
        </MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Evaluation settings</MudText>
        <MudGrid>
            <MudItem xs="12" md="3"><MudSelect T="ExtrapolationCurveType" @bind-Value="value.CurveType" Label="Reconnect curve family">@foreach (ExtrapolationCurveType curve in Enum.GetValues<ExtrapolationCurveType>()) { <MudSelectItem Value="@curve">@curve</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Evaluation interval" QuantityName="DepthDrilling" SIValueNullable="@value.EvaluationInterval" SIValueNullableChanged="x => value.EvaluationInterval = x ?? 10.0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Start actual MD (optional)" QuantityName="DepthDrilling" SIValueNullable="@value.StartActualMD" SIValueNullableChanged="x => value.StartActualMD = x" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="End actual MD (optional)" QuantityName="DepthDrilling" SIValueNullable="@value.EndActualMD" SIValueNullableChanged="x => value.EndActualMD = x" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Correction length" QuantityName="DepthDrilling" SIValueNullable="@value.ReferenceMDAdvance" SIValueNullableChanged="x => value.ReferenceMDAdvance = x ?? 60.0" /></MudItem>
            @if (value.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn)
            {
                <MudItem xs="12" md="3"><MudNumericField T="double" @bind-Value="value.JunctionCurvatureRatio" Label="Junction curvature ratio" Min="0.001" /></MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Bundling settings</MudText>
        <MudGrid>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Hard invalid-gap limit" QuantityName="DepthDrilling" SIValueNullable="@value.MaximumInvalidGap" SIValueNullableChanged="x => value.MaximumInvalidGap = x ?? 100.0" /></MudItem>
            <MudItem xs="12" md="3"><MudInputWithUnitAdornment QuantityLabel="Minimum bundle length" QuantityName="DepthDrilling" SIValueNullable="@value.MinimumBundleLength" SIValueNullableChanged="x => value.MinimumBundleLength = x ?? 90.0" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="int" @bind-Value="value.MinimumBundleSampleCount" Label="Minimum sample count" Min="2" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField T="double" @bind-Value="value.BundlingPenalty" Label="Change-point penalty" Min="0.001" /></MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption">The penalty is experimental: larger values produce fewer, longer bundles.</MudText>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1">Calculation: @value.CalculationState @value.CalculationMessage</MudText>
        @if (IsActive) { <MudProgressLinear Value="@(100 * value.CalculationProgress)" Class="mt-2" /> }
        @if (value.IsStale) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">A selected trajectory has changed. Save to recalculate.</MudAlert> }
    </MudPaper>

    @if (loadingTrajectoryPlot)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-4" />
        <MudText Typo="Typo.caption">Loading reference and actual trajectories…</MudText>
    }
    else if (referenceTrajectoryStations.Count > 0 || actualTrajectoryStations.Count > 0)
    {
        TrajectoryComparisonPlotData trajectoryPlot = BuildTrajectoryComparisonPlot();
        <MudText Typo="Typo.h6" Class="mt-5 mb-2">Reference and actual trajectories</MudText>
        <MudText Typo="Typo.caption">The reference trajectory is blue and the actual trajectory is orange. Coordinates follow the selected position and depth references.</MudText>
        <Scatter3DPlot @key="@($"directional-trajectories-{value.ReferenceTrajectoryID}-{value.ActualTrajectoryID}-{referenceTrajectoryStations.Count}-{actualTrajectoryStations.Count}")"
                       ReferenceSourceVersion="@referenceSourceVersion"
                       NameList="@trajectoryPlot.Names" ModeFlagList="@trajectoryPlot.Modes" ColorList="@trajectoryPlot.Colors"
                       LineWidthList="@trajectoryPlot.LineWidths" ShowLegendList="@trajectoryPlot.ShowLegend"
                       XValuesList="@trajectoryPlot.North" YValuesList="@trajectoryPlot.East" ZValuesList="@trajectoryPlot.Tvd"
                       XUnit="PositionDrilling" YUnit="PositionDrilling" ZUnit="DepthDrilling"
                       XAxisUsesPositionReference="true" YAxisUsesPositionReference="true" ZAxisUsesDepthReference="true"
                       XAxisPositionDirection="PositionDirectionType.North" YAxisPositionDirection="PositionDirectionType.East"
                       XAxisTitle="North" YAxisTitle="East" ZAxisTitle="TVD" ZAxisReversed="true" PlotHeight="620" />
    }

    @if (plotSamples.Any(HasResidualPair))
    {
        ResidualPlotData residualPlot = BuildResidualPlot();
        <MudText Typo="Typo.h6" Class="mt-5 mb-2">Directional-control discrepancies</MudText>
        <MudText Typo="Typo.caption">Each point compares one valid actual interval with the first section of its double-arc correction. Colors identify the detected MD bundles.</MudText>
        <ScatterPlot @key="@($"directional-residual-{value.CurveType}-{plotSamples.Count}")"
                     NameList="@residualPlot.Names" ModeFlagList="@residualPlot.Modes" ColorList="@residualPlot.Colors"
                     MarkerSizeList="@residualPlot.MarkerSizes" ShowLegendList="@residualPlot.ShowLegend"
                     XValuesList="@residualPlot.X" YValuesList="@residualPlot.Y"
                     XUnit="@ResidualPlotXQuantity" YUnit="@ResidualPlotYQuantity"
                     XAxisTitle="@ResidualPlotXLabel" YAxisTitle="@ResidualPlotYLabel" PlotHeight="520" />
    }

    @if (value.BundleList is { Count: > 0 })
    {
        <MudText Typo="Typo.h6" Class="mt-5 mb-2">Detected response bundles</MudText>
        <MudTable T="DirectionalControlEvaluationBundle" Items="@value.BundleList" Dense="true" Bordered="true" Hover="true" FixedHeader="true" Height="360px" Style="overflow-x:auto">
            <HeaderContent>
                <MudTh>#</MudTh><MudTh>@DepthHeader("Start actual MD")</MudTh><MudTh>@DepthHeader("End actual MD")</MudTh>
                <MudTh>Valid / attempted</MudTh><MudTh>Coverage</MudTh>
                <MudTh>@ResidualHeader(FirstComponentLabel, FirstComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader(SecondComponentLabel, SecondComponentQuantity)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(context.BundleIndex + 1)</MudTd>
                <MudTd><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.StartActualMD" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.EndActualMD" /></MudTd>
                <MudTd>@context.ValidSampleCount / @context.AttemptedSampleCount</MudTd>
                <MudTd>@context.ValidCoverageRatio.ToString("P0")</MudTd>
                <MudTd>@SummaryCell(FirstSummary(context), FirstComponentQuantity)</MudTd>
                <MudTd>@SummaryCell(SecondSummary(context), SecondComponentQuantity)</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption">Each summary shows empirical P10 / P50 / P90. Toolface residuals use circular statistics.</MudText>
        <MudExpansionPanels Class="mt-2">
            @foreach (DirectionalControlEvaluationBundle bundle in value.BundleList)
            {
                <MudExpansionPanel Text="@($"Bundle {bundle.BundleIndex + 1} empirical distributions")">
                    @JointDistributionPanel(bundle)
                    <MudGrid>
                        <MudItem xs="12" md="6">@HistogramTable(FirstSummary(bundle), FirstComponentLabel, FirstComponentQuantity)</MudItem>
                        <MudItem xs="12" md="6">@HistogramTable(SecondSummary(bundle), SecondComponentLabel, SecondComponentQuantity)</MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    @if (sampleChunkCount > 0)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-5 mb-2">
            <MudText Typo="Typo.h6">Evaluation intervals</MudText><MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(sampleChunkIndex == 0)" OnClick="PreviousChunkAsync" />
            <MudText Typo="Typo.caption">Page @(sampleChunkIndex + 1) / @sampleChunkCount</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(sampleChunkIndex + 1 >= sampleChunkCount)" OnClick="NextChunkAsync" />
        </MudStack>
        <MudTable T="DirectionalControlEvaluationSample" Items="@samples" Dense="true" Bordered="true" Hover="true" FixedHeader="true" Height="480px" Style="overflow-x:auto">
            <HeaderContent>
                <MudTh>@DepthHeader("Actual MD")</MudTh><MudTh>State</MudTh>
                <MudTh>@ResidualHeader($"Expected {FirstComponentLabel}", FirstComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader($"Actual {FirstComponentLabel}", FirstComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader($"{FirstComponentLabel} residual", FirstComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader($"Expected {SecondComponentLabel}", SecondComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader($"Actual {SecondComponentLabel}", SecondComponentQuantity)</MudTh>
                <MudTh>@ResidualHeader($"{SecondComponentLabel} residual", SecondComponentQuantity)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="DrillingSignalReferenceType.Depth" SIValue="@context.ActualMD" /></MudTd>
                <MudTd>@(context.IsValid ? "Valid" : context.FailureCode)</MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@FirstComponentQuantity" SIValue="@FirstExpected(context)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@FirstComponentQuantity" SIValue="@FirstActual(context)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@FirstComponentQuantity" SIValue="@FirstResidual(context)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@SecondComponentQuantity" SIValue="@SecondExpected(context)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@SecondComponentQuantity" SIValue="@SecondActual(context)" /></MudTd>
                <MudTd><MudSpanWithUnit QuantityName="@SecondComponentQuantity" SIValue="@SecondResidual(context)" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [CascadingParameter] private MudUnitAndReferenceChoiceTag? Parent { get; set; }
    [Parameter] public Guid? CaseId { get; set; }
    [Parameter] public EventCallback ValueChanged { get; set; }
    private DirectionalControlEvaluationCase value = NewCase();
    private List<Field> fields = []; private List<Cluster> clusters = []; private List<Well> wells = []; private List<WellBore> wellBores = [];
    private List<Rig> rigs = []; private List<TrajectoryLight> trajectories = [];
    private Guid? fieldId, clusterId, wellId, wellBoreId;
    private bool loading = true, busy;
    private bool loadingTrajectoryPlot;
    private int sampleChunkCount, sampleChunkIndex;
    private int resultsLoadVersion;
    private int trajectoryPlotLoadVersion;
    private long referenceSourceVersion;
    private List<DirectionalControlEvaluationSample> samples = [];
    private List<DirectionalControlEvaluationSample> plotSamples = [];
    private List<SurveyStation> referenceTrajectoryStations = [];
    private List<SurveyStation> actualTrajectoryStations = [];
    private readonly CancellationTokenSource lifetime = new();
    private static readonly string[] BundleColors =
    [
        "#1565C0", "#2E7D32", "#C62828", "#6A1B9A", "#EF6C00", "#00838F",
        "#AD1457", "#4527A0", "#558B2F", "#283593", "#D84315", "#00695C"
    ];

    private Guid? ReferenceTrajectoryId => value.ReferenceTrajectoryID == Guid.Empty ? null : value.ReferenceTrajectoryID;
    private Guid? ActualTrajectoryId => value.ActualTrajectoryID == Guid.Empty ? null : value.ActualTrajectoryID;
    private IEnumerable<TrajectoryLight> TrajectoryChoices => trajectories
        .Where(item => item?.MetaInfo != null && wellBoreId != null && item.WellBoreID == wellBoreId &&
                       item.CalculationState == CalculationState.Completed)
        .OrderBy(item => item.Name);
    private bool IsActive => value.CalculationState is CalculationState.Queued or CalculationState.Running;
    private bool IsBuildTurn => value.CurveType == ExtrapolationCurveType.ConstantBuildAndTurn;
    private string FirstComponentLabel => IsBuildTurn ? "build rate" : "curvature";
    private string SecondComponentLabel => IsBuildTurn ? "turn rate" : "toolface";
    private string FirstComponentQuantity => "CurvatureDrilling";
    private string SecondComponentQuantity => IsBuildTurn ? "CurvatureDrilling" : "PlaneAngleDrilling";
    private string ResidualPlotXLabel => IsBuildTurn ? "Turn-rate residual" : "Curvature residual";
    private string ResidualPlotYLabel => IsBuildTurn ? "Build-rate residual" : "Toolface residual";
    private string ResidualPlotXQuantity => "CurvatureDrilling";
    private string ResidualPlotYQuantity => IsBuildTurn ? "CurvatureDrilling" : "PlaneAngleDrilling";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Parent?.Add(this);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Task<TrajectoryReferenceDataSnapshot> references = ReferenceData.GetSnapshotAsync();
            Task<DirectionalControlEvaluationCase>? caseTask = CaseId is Guid id
                ? Api.ClientTrajectory.GetDirectionalControlEvaluationCaseByIdAsync(id) : null;
            if (caseTask != null) value = await caseTask;
            TrajectoryReferenceDataSnapshot snapshot = await references;
            fields = snapshot.Fields.ToList(); clusters = snapshot.Clusters.ToList(); wells = snapshot.Wells.ToList();
            wellBores = snapshot.WellBores.ToList(); rigs = snapshot.Rigs.ToList();
            trajectories = snapshot.Trajectories.ToList();
            InitializeHierarchy(value.ReferenceTrajectoryID != Guid.Empty ? value.ReferenceTrajectoryID : value.ActualTrajectoryID);
            await RefreshTrajectoryContextAsync();
            if (value.CalculationState == CalculationState.Completed) await LoadResultsAsync();
            else if (IsActive) _ = MonitorAsync(value.MetaInfo.ID, lifetime.Token);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unable to initialize directional-control evaluation editor");
            Snackbar.Add("Unable to load the evaluation case.", Severity.Error);
        }
        finally { loading = false; }
    }

    private static DirectionalControlEvaluationCase NewCase() => new()
    {
        MetaInfo = PseudoConstructors.ConstructMetaInfo(), Name = "New directional-control evaluation",
        CurveType = ExtrapolationCurveType.CircularArc, CalculationState = CalculationState.NotCalculated,
        EvaluationInterval = 10.0, ReferenceMDAdvance = 60.0, JunctionCurvatureRatio = 1.0,
        MaximumInvalidGap = 100.0, MinimumBundleLength = 90.0, MinimumBundleSampleCount = 5,
        BundlingPenalty = 8.0, SampleList = [], BundleList = []
    };

    private async Task SaveAsync()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(value.Name) || value.ReferenceTrajectoryID == Guid.Empty || value.ActualTrajectoryID == Guid.Empty)
        { Snackbar.Add("Name, reference trajectory, and actual trajectory are required.", Severity.Warning); return; }
        busy = true;
        try
        {
            DirectionalControlEvaluationCase payload = ConfigurationPayload();
            resultsLoadVersion++; samples = []; plotSamples = []; sampleChunkCount = sampleChunkIndex = 0;
            value = value.CreationDate == null
                ? await Api.ClientTrajectory.PostDirectionalControlEvaluationCaseAsync(payload, lifetime.Token)
                : await Api.ClientTrajectory.PutDirectionalControlEvaluationCaseByIdAsync(value.MetaInfo.ID, ConcurrencyToken.Require(value.LastModificationDate), payload, lifetime.Token);
            Snackbar.Add("Directional-control evaluation queued.", Severity.Success);
            await MonitorAsync(value.MetaInfo.ID, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ApiException ex) when (ex.StatusCode == 409)
        { logger.LogWarning(ex, "Directional-control evaluation was changed concurrently"); Snackbar.Add("The case changed elsewhere. Reopen it before saving.", Severity.Warning); }
        catch (Exception ex)
        { logger.LogError(ex, "Unable to save directional-control evaluation"); Snackbar.Add("Unable to save the evaluation case.", Severity.Error); }
        finally { busy = false; }
    }

    private DirectionalControlEvaluationCase ConfigurationPayload() => new()
    {
        MetaInfo = value.MetaInfo, Name = value.Name, Description = value.Description,
        CreationDate = value.CreationDate, LastModificationDate = value.LastModificationDate,
        ReferenceTrajectoryID = value.ReferenceTrajectoryID, ActualTrajectoryID = value.ActualTrajectoryID,
        CurveType = value.CurveType, EvaluationInterval = value.EvaluationInterval,
        StartActualMD = value.StartActualMD, EndActualMD = value.EndActualMD,
        ReferenceMDAdvance = value.ReferenceMDAdvance,
        JunctionCurvatureRatio = value.JunctionCurvatureRatio, MaximumInvalidGap = value.MaximumInvalidGap,
        MinimumBundleLength = value.MinimumBundleLength, MinimumBundleSampleCount = value.MinimumBundleSampleCount,
        BundlingPenalty = value.BundlingPenalty, SampleList = [], BundleList = []
    };

    private async Task MonitorAsync(Guid id, CancellationToken token)
    {
        DirectionalControlEvaluationCaseLight status;
        do
        {
            status = await Api.ClientTrajectory.GetDirectionalControlEvaluationCaseStatusAsync(id, token);
            value.CalculationState = status.CalculationState; value.CalculationProgress = status.CalculationProgress;
            value.CalculationMessage = status.CalculationMessage; value.IsStale = status.IsStale;
            await InvokeAsync(StateHasChanged);
            if (IsActive) await Task.Delay(TimeSpan.FromSeconds(1), token);
        } while (IsActive);
        value = await Api.ClientTrajectory.GetDirectionalControlEvaluationCaseByIdAsync(id, token);
        if (value.CalculationState == CalculationState.Completed) await LoadResultsAsync();
        Snackbar.Add(value.CalculationState == CalculationState.Completed ? "Directional-control evaluation completed." : value.CalculationMessage ?? "Evaluation failed.",
            value.CalculationState == CalculationState.Completed ? Severity.Success : Severity.Error);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSamplesAsync(int chunkIndex)
    {
        if (value.MetaInfo?.ID is not Guid id || id == Guid.Empty) return;
        sampleChunkCount = await Api.ClientTrajectory.GetDirectionalControlEvaluationSampleChunkCountAsync(id, lifetime.Token);
        if (sampleChunkCount == 0) { samples = []; return; }
        sampleChunkIndex = Math.Clamp(chunkIndex, 0, sampleChunkCount - 1);
        DirectionalControlEvaluationSampleChunk chunk = await Api.ClientTrajectory.GetDirectionalControlEvaluationSampleChunkAsync(id, sampleChunkIndex, lifetime.Token);
        samples = chunk.SampleList ?? [];
    }
    private async Task LoadResultsAsync()
    {
        if (value.MetaInfo?.ID is not Guid id || id == Guid.Empty) return;
        int loadVersion = ++resultsLoadVersion;
        sampleChunkCount = await Api.ClientTrajectory.GetDirectionalControlEvaluationSampleChunkCountAsync(id, lifetime.Token);
        sampleChunkIndex = 0; samples = []; plotSamples = [];
        if (sampleChunkCount == 0) return;
        DirectionalControlEvaluationSampleChunk firstChunk = await Api.ClientTrajectory.GetDirectionalControlEvaluationSampleChunkAsync(id, 0, lifetime.Token);
        samples = firstChunk.SampleList ?? [];
        plotSamples.AddRange(samples.Where(sample => sample.IsValid));
        if (sampleChunkCount > 1)
            _ = LoadRemainingPlotSamplesAsync(id, loadVersion, lifetime.Token);
    }
    private async Task LoadRemainingPlotSamplesAsync(Guid id, int loadVersion, CancellationToken token)
    {
        try
        {
            for (int index = 1; index < sampleChunkCount && loadVersion == resultsLoadVersion; index++)
            {
                DirectionalControlEvaluationSampleChunk chunk = await Api.ClientTrajectory.GetDirectionalControlEvaluationSampleChunkAsync(id, index, token);
                if (loadVersion != resultsLoadVersion) return;
                plotSamples.AddRange((chunk.SampleList ?? []).Where(sample => sample.IsValid));
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { logger.LogWarning(ex, "Unable to load every directional-control sample for plotting"); }
    }
    private async Task PreviousChunkAsync() { await LoadSamplesAsync(sampleChunkIndex - 1); }
    private async Task NextChunkAsync() { await LoadSamplesAsync(sampleChunkIndex + 1); }

    private void InitializeHierarchy(Guid trajectoryId)
    {
        TrajectoryLight? trajectory = trajectories.FirstOrDefault(value => value.MetaInfo?.ID == trajectoryId);
        if (trajectory == null) return;
        fieldId = trajectory.FieldID; clusterId = trajectory.ClusterID; wellId = trajectory.WellID; wellBoreId = trajectory.WellBoreID;
    }
    private async Task SetField(Guid? id) { fieldId = id; clusterId = wellId = wellBoreId = null; ClearTrajectories(); await RefreshTrajectoryContextAsync(); }
    private async Task SetCluster(Guid? id) { clusterId = id; wellId = wellBoreId = null; ClearTrajectories(); await RefreshTrajectoryContextAsync(); }
    private async Task SetWell(Guid? id) { wellId = id; wellBoreId = null; ClearTrajectories(); await RefreshTrajectoryContextAsync(); }
    private async Task SetWellBore(Guid? id) { wellBoreId = id; ClearTrajectories(); await RefreshTrajectoryContextAsync(); }
    private async Task SetReferenceTrajectory(Guid? id) { value.ReferenceTrajectoryID = id ?? Guid.Empty; await RefreshTrajectoryContextAsync(); }
    private async Task SetActualTrajectory(Guid? id) { value.ActualTrajectoryID = id ?? Guid.Empty; await RefreshTrajectoryContextAsync(); }
    private void ClearTrajectories() { value.ReferenceTrajectoryID = Guid.Empty; value.ActualTrajectoryID = Guid.Empty; }
    private async Task RefreshTrajectoryContextAsync()
    {
        Guid contextId = value.ActualTrajectoryID != Guid.Empty
            ? value.ActualTrajectoryID
            : value.ReferenceTrajectoryID;
        DateTimeOffset? referenceDate = trajectories.FirstOrDefault(item => item.MetaInfo?.ID == contextId)?.LastModificationDate;
        DataUtils.ApplyTrajectoryReferenceValues(contextId == Guid.Empty ? null : contextId,
            trajectories, wellBores, wells, clusters, rigs, fields, referenceDate: referenceDate);
        try
        {
            await CartographicPositionReferenceUtils.ApplyForTrajectoryAsync(Api,
                contextId == Guid.Empty ? null : contextId, trajectories, clusters, fields, logger);
            TrajectoryReferenceDatumUtils.Apply(await TrajectoryReferenceDatumUtils.ResolveForTrajectoryAsync(Api,
                contextId == Guid.Empty ? null : contextId, trajectories, wellBores, wells, clusters));
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to resolve optional directional-control trajectory references");
            TrajectoryReferenceDatumUtils.Apply(new TrajectoryReferenceDatumValues(null, null, null));
        }
        referenceSourceVersion++;
        await LoadTrajectoryPlotsAsync();
    }
    private async Task LoadTrajectoryPlotsAsync()
    {
        int loadVersion = ++trajectoryPlotLoadVersion;
        referenceTrajectoryStations = [];
        actualTrajectoryStations = [];
        if (value.ReferenceTrajectoryID == Guid.Empty && value.ActualTrajectoryID == Guid.Empty) return;
        loadingTrajectoryPlot = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            Task<List<SurveyStation>> referenceTask = LoadTrajectoryStationsAsync(value.ReferenceTrajectoryID, lifetime.Token);
            Task<List<SurveyStation>> actualTask = LoadTrajectoryStationsAsync(value.ActualTrajectoryID, lifetime.Token);
            await Task.WhenAll(referenceTask, actualTask);
            if (loadVersion != trajectoryPlotLoadVersion) return;
            referenceTrajectoryStations = await referenceTask;
            actualTrajectoryStations = await actualTask;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to load directional-control trajectories for plotting");
            Snackbar.Add("The reference or actual trajectory could not be loaded for plotting.", Severity.Warning);
        }
        finally
        {
            if (loadVersion == trajectoryPlotLoadVersion)
            {
                loadingTrajectoryPlot = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    private async Task<List<SurveyStation>> LoadTrajectoryStationsAsync(Guid trajectoryId, CancellationToken token)
    {
        if (trajectoryId == Guid.Empty) return [];
        int chunkCount = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkCountAsync(trajectoryId, token);
        List<SurveyStation> result = [];
        for (int index = 0; index < chunkCount; index++)
        {
            SurveyStationChunk chunk = await Api.ClientTrajectory.GetTrajectorySurveyStationChunkAsync(trajectoryId, index, token);
            if (chunk.SurveyStationList is { Count: > 0 }) result.AddRange(chunk.SurveyStationList);
        }
        return result.OrderBy(station => station.MD ?? station.Abscissa).ToList();
    }
    private Task<IEnumerable<Guid?>> SearchTrajectoriesAsync(string? text, CancellationToken _)
    {
        string? term = text?.Trim();
        return Task.FromResult(TrajectoryChoices
            .Where(item => string.IsNullOrEmpty(term) || (item.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
            .Select(item => (Guid?)item.MetaInfo!.ID));
    }
    private string GetTrajectoryName(Guid? id)
    {
        if (id is not Guid value) return string.Empty;
        return trajectories.FirstOrDefault(item => item.MetaInfo?.ID == value)?.Name ?? "Unknown trajectory";
    }

