    private ResidualPlotData BuildResidualPlot()
    {
        ResidualPlotData result = new();
        IEnumerable<DirectionalControlEvaluationBundle> bundles = value.BundleList?.OrderBy(item => item.BundleIndex)
            ?? Enumerable.Empty<DirectionalControlEvaluationBundle>();
        foreach (DirectionalControlEvaluationBundle bundle in bundles)
        {
            List<DirectionalControlEvaluationSample> bundleSamples = plotSamples
                .Where(sample => HasResidualPair(sample) && sample.ActualMD >= bundle.StartActualMD - 1e-9 &&
                                 sample.ActualMD < bundle.EndActualMD - 1e-9)
                .ToList();
            if (bundleSamples.Count == 0) continue;
            result.Names.Add($"Bundle {bundle.BundleIndex + 1}: {FormatMd(bundle.StartActualMD)} – {FormatMd(bundle.EndActualMD)}");
            result.Modes.Add(2);
            result.Colors.Add(BundleColor(bundle.BundleIndex));
            result.MarkerSizes.Add(7);
            result.ShowLegend.Add(true);
            result.X.Add(bundleSamples.Select(sample => (object)(IsBuildTurn
                ? sample.TurnRateResidual!.Value : sample.CurvatureResidual!.Value)).ToList());
            double toolfaceCenter = bundle.ToolfaceResidual?.P50 ?? 0.0;
            result.Y.Add(bundleSamples.Select(sample => (object)(IsBuildTurn
                ? sample.BuildRateResidual!.Value
                : toolfaceCenter + WrapAngle(sample.ToolfaceResidual!.Value - toolfaceCenter))).ToList());
        }
        return result;
    }
    private ResidualPlotData BuildJointProbabilityPlot(DirectionalControlEvaluationBundle bundle)
    {
        ResidualPlotData result = new();
        List<DirectionalControlEvaluationSample> bundleSamples = plotSamples
            .Where(sample => HasResidualPair(sample) && sample.ActualMD >= bundle.StartActualMD - 1e-9 &&
                             sample.ActualMD < bundle.EndActualMD - 1e-9)
            .ToList();
        if (bundleSamples.Count == 0) return result;

        double toolfaceCenter = bundle.ToolfaceResidual?.P50 ?? 0.0;
        List<double> xValues = bundleSamples.Select(sample => IsBuildTurn
            ? sample.TurnRateResidual!.Value : sample.CurvatureResidual!.Value).ToList();
        List<double> yValues = bundleSamples.Select(sample => IsBuildTurn
            ? sample.BuildRateResidual!.Value
            : toolfaceCenter + WrapAngle(sample.ToolfaceResidual!.Value - toolfaceCenter)).ToList();
        int binCount = Math.Clamp((int)Math.Ceiling(Math.Pow(bundleSamples.Count, 1.0 / 3.0)), 2, 16);
        (double xMinimum, double xMaximum) = DistributionRange(xValues, false);
        (double yMinimum, double yMaximum) = DistributionRange(yValues, !IsBuildTurn);
        double xWidth = (xMaximum - xMinimum) / binCount;
        double yWidth = (yMaximum - yMinimum) / binCount;
        int[,] counts = new int[binCount, binCount];
        for (int index = 0; index < bundleSamples.Count; index++)
        {
            int xIndex = Math.Clamp((int)((xValues[index] - xMinimum) / xWidth), 0, binCount - 1);
            int yIndex = Math.Clamp((int)((yValues[index] - yMinimum) / yWidth), 0, binCount - 1);
            counts[xIndex, yIndex]++;
        }

        List<object> x = []; List<object> y = []; List<object> z = [];
        for (int xIndex = 0; xIndex < binCount; xIndex++)
            for (int yIndex = 0; yIndex < binCount; yIndex++)
            {
                if (counts[xIndex, yIndex] == 0) continue;
                x.Add(xMinimum + (xIndex + 0.5) * xWidth);
                y.Add(yMinimum + (yIndex + 0.5) * yWidth);
                z.Add(counts[xIndex, yIndex] / (double)bundleSamples.Count);
            }

        result.Names.Add($"Bundle {bundle.BundleIndex + 1}: {FormatMd(bundle.StartActualMD)} – {FormatMd(bundle.EndActualMD)}");
        result.Modes.Add(2);
        result.Colors.Add(BundleColor(bundle.BundleIndex));
        result.MarkerSizes.Add(8);
        result.ShowLegend.Add(false);
        result.X.Add(x); result.Y.Add(y); result.Z.Add(z);
        return result;
    }
    private static (double Minimum, double Maximum) DistributionRange(List<double> values, bool angle)
    {
        double minimum = values.Min();
        double maximum = values.Max();
        if (maximum - minimum > 1e-12) return (minimum, maximum);
        double halfWidth = angle ? Math.PI / 180.0 : Math.Max(Math.Abs(minimum) * 0.05, 1e-9);
        return (minimum - halfWidth, maximum + halfWidth);
    }
    private bool HasResidualPair(DirectionalControlEvaluationSample sample) => sample.IsValid &&
        (IsBuildTurn
            ? sample.BuildRateResidual.HasValue && sample.TurnRateResidual.HasValue
            : sample.CurvatureResidual.HasValue && sample.ToolfaceResidual.HasValue);
    private string BundleColor(int index) => BundleColors[Math.Abs(index) % BundleColors.Length];
    private static double WrapAngle(double angle) => Math.Atan2(Math.Sin(angle), Math.Cos(angle));
    private string FormatMd(double siValue)
    {
        string displayed = Parent?.FromWGS84DepthSI(siValue, "DepthDrilling", false) ?? siValue.ToString("G5");
        return $"{displayed} {Parent?.GetDepthUnitLabel("DepthDrilling")}";
    }
    private TrajectoryComparisonPlotData BuildTrajectoryComparisonPlot()
    {
        TrajectoryComparisonPlotData result = new();
        AddTrajectoryTrace(result, "Reference trajectory", "#1565C0", referenceTrajectoryStations);
        AddTrajectoryTrace(result, "Actual trajectory", "#EF6C00", actualTrajectoryStations);
        return result;
    }
    private static void AddTrajectoryTrace(
        TrajectoryComparisonPlotData result,
        string name,
        string color,
        IEnumerable<SurveyStation> stations)
    {
        List<SurveyStation> drawable = stations
            .Where(station => station.RiemannianNorth.HasValue && station.RiemannianEast.HasValue && station.TVD.HasValue)
            .ToList();
        if (drawable.Count == 0) return;
        result.Names.Add(name);
        result.Modes.Add(1);
        result.Colors.Add(color);
        result.LineWidths.Add(5);
        result.ShowLegend.Add(true);
        result.North.Add(drawable.Select(station => (object)station.RiemannianNorth!.Value).ToList());
        result.East.Add(drawable.Select(station => (object)station.RiemannianEast!.Value).ToList());
        result.Tvd.Add(drawable.Select(station => (object)station.TVD!.Value).ToList());
    }
    private double? FirstExpected(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.ExpectedBuildRate : sample.ExpectedCurvature;
    private double? FirstActual(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.ActualBuildRate : sample.ActualCurvature;
    private double? FirstResidual(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.BuildRateResidual : sample.CurvatureResidual;
    private double? SecondExpected(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.ExpectedTurnRate : sample.ExpectedToolface;
    private double? SecondActual(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.ActualTurnRate : sample.ActualToolface;
    private double? SecondResidual(DirectionalControlEvaluationSample sample) => IsBuildTurn ? sample.TurnRateResidual : sample.ToolfaceResidual;
