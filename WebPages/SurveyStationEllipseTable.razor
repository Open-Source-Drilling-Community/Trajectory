@inject ILogger<SurveyStationEllipseTable> logger
@inject ISnackbar Snackbar
@inject ITrajectoryAPIUtils Api
@using System.Linq

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudToolBar>
        <MudText Typo="Typo.h6">Uncertainty ellipses</MudText>
        <MudSpacer />
        <div style="width: 190px;">
            <MudInputWithUnitAdornment QuantityName="ProportionStandard" QuantityLabel="Confidence factor"
                                       SIValue="@confidenceFactor_" SIValueChanged="OnConfidenceFactorChanged"
                                       Immediate="true" />
        </div>
        <MudButton Class="ms-2" Color="Color.Primary" Variant="Variant.Outlined" OnClick="CalculateEllipsesAsync"
                   Disabled="@(!CanCalculate || isCalculating_)">Calculate</MudButton>
    </MudToolBar>
    @if (isCalculating_)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-2" />
    }
    @if (!IsConfidenceFactorValid)
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">
            The confidence factor must be greater than 0 and no greater than @MaximumConfidenceFactor.
        </MudText>
    }

    @if (ellipseResults_ is { Count: > 0 })
    {
        <MudTable Items="@ellipseResults_" T="SurveyStationEllipseResult" Height="400px" FixedHeader="true"
                          Virtualize="true" OverscanCount="3" ItemSize="38"
                          Elevation="1" CustomHeader="true" Hover="true" Dense="true" Bordered="true" ReadOnly="true">
            <HeaderContent>
                <MudTHeadRow>
                    <MudTh rowspan="2">Measured Depth [@Parent?.GetDepthUnitLabel("DepthDrilling")]</MudTh>
                    <MudTh colspan="3">Horizontal</MudTh>
                    <MudTh colspan="3">Vertical</MudTh>
                    <MudTh colspan="3">Perpendicular</MudTh>
                </MudTHeadRow>
                <MudTHeadRow>
                    <MudTh>Semi-long [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Semi-short [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Azimuth [@Parent?.GetAzimuthUnitLabel("PlaneAngleDrilling")]</MudTh>
                    <MudTh>Semi-long [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Semi-short [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Angle [@Parent?.GetUnitLabel("PlaneAngleDrilling")]</MudTh>
                    <MudTh>Semi-long [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Semi-short [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                    <MudTh>Angle [@Parent?.GetUnitLabel("PlaneAngleDrilling")]</MudTh>
                </MudTHeadRow>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Measured Depth">
                    <MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="@DrillingSignalReferenceType.Depth" SIValue="@context.MD" />
                </MudTd>
                @EllipseCells(context.HorizontalEllipse, isHorizontal: true)
                @EllipseCells(context.VerticalEllipse)
                @EllipseCells(context.PerpendicularEllipse)
            </RowTemplate>
        </MudTable>
    }
    @if (highestTvdPath_ is { Count: > 0 } || lowestTvdPath_ is { Count: > 0 })
    {
        <MudDivider Class="my-4" />
        <MudTabs Elevation="0" Rounded="false">
            <MudTabPanel Text="Highest TVD" Class="pt-2">
                @PathTable(highestTvdPath_)
            </MudTabPanel>
            <MudTabPanel Text="Lowest TVD" Class="pt-2">
                @PathTable(lowestTvdPath_)
            </MudTabPanel>
        </MudTabs>
    }
</MudPaper>

@code {
    [CascadingParameter] private MudUnitAndReferenceChoiceTag? Parent { get; set; }
    [Parameter] public ICollection<SurveyStation>? SurveyStationList { get; set; }
    [Parameter] public ICollection<SurveyStation>? UncertaintyPropagationHistory { get; set; }
    [Parameter] public Guid? SurveyInstrumentID { get; set; }
    [Parameter] public string? CalculationName { get; set; }
    [Parameter] public EventCallback<ICollection<SurveyStationEllipseResult>> EllipseResultsChanged { get; set; }
    [Parameter] public EventCallback<SurveyStationEllipseCalculation?> CalculationChanged { get; set; }

    private double confidenceFactor_ = 0.95;
    private const double MaximumConfidenceFactor = 0.999;
    private List<SurveyStationEllipseResult> ellipseResults_ = [];
    private List<SurveyPoint> highestTvdPath_ = [];
    private List<SurveyPoint> lowestTvdPath_ = [];
    private bool isCalculating_;

    private bool IsConfidenceFactorValid => double.IsFinite(confidenceFactor_) &&
        confidenceFactor_ > 0.0 && confidenceFactor_ <= MaximumConfidenceFactor;
    private bool CanCalculate => SurveyStationList is { Count: > 0 } && IsConfidenceFactorValid;

    private async Task OnConfidenceFactorChanged(double value)
    {
        confidenceFactor_ = value;
        ellipseResults_ = [];
        highestTvdPath_ = [];
        lowestTvdPath_ = [];
        await EllipseResultsChanged.InvokeAsync(ellipseResults_);
        await CalculationChanged.InvokeAsync(null);
    }

    private async Task CalculateEllipsesAsync()
    {
        if (!CanCalculate || SurveyStationList == null)
        {
            Snackbar.Add("No survey stations available for ellipse calculation", Severity.Warning);
            return;
        }

        try
        {
            isCalculating_ = true;
            List<SurveyStation> requestedStations = BuildRequestedStations();
            double? firstDisplayedMd = SurveyStationList
                .Select(station => station.MD ?? station.Abscissa)
                .Where(md => md.HasValue)
                .Select(md => md!.Value)
                .DefaultIfEmpty(double.NegativeInfinity)
                .Min();
            SurveyStationEllipseCalculation order = new()
            {
                MetaInfo = PseudoConstructors.ConstructMetaInfo(),
                Name = string.IsNullOrWhiteSpace(CalculationName) ? "Survey station ellipse calculation" : CalculationName,
                Description = string.Empty,
                CreationDate = DateTimeOffset.UtcNow,
                LastModificationDate = DateTimeOffset.UtcNow,
                ConfidenceFactor = confidenceFactor_,
                SurveyInstrumentID = SurveyInstrumentID,
                SurveyStationList = requestedStations
            };

            SurveyStationEllipseCalculation result = await Api.ClientTrajectory.PostSurveyStationEllipseCalculationAsync(order);
            ellipseResults_ = result.SurveyStationEllipseResultList?
                .Where(item => !firstDisplayedMd.HasValue || !item.MD.HasValue || item.MD.Value >= firstDisplayedMd.Value)
                .ToList() ?? [];
            highestTvdPath_ = FilterDisplayedPath(result.HighestTvdSurveyPointList, firstDisplayedMd);
            lowestTvdPath_ = FilterDisplayedPath(result.LowestTvdSurveyPointList, firstDisplayedMd);
            await EllipseResultsChanged.InvokeAsync(ellipseResults_);
            await CalculationChanged.InvokeAsync(result);
            if (ellipseResults_.Count == 0)
            {
                Snackbar.Add("No uncertainty ellipses could be calculated", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem while calculating uncertainty ellipses");
            Snackbar.Add("Problem while calculating uncertainty ellipses: " + ex.Message, Severity.Error);
        }
        finally
        {
            isCalculating_ = false;
        }
    }

    private List<SurveyStation> BuildRequestedStations()
    {
        List<SurveyStation> displayed = SurveyStationList?.ToList() ?? [];
        if (UncertaintyPropagationHistory is not { Count: > 0 } history || displayed.Count == 0)
        {
            return displayed;
        }

        double firstDisplayedMd = displayed
            .Select(station => station.MD ?? station.Abscissa ?? double.MaxValue)
            .Min();
        return history
            .Where(station => (station.MD ?? station.Abscissa) is double md && md < firstDisplayedMd)
            .Concat(displayed)
            .OrderBy(station => station.MD ?? station.Abscissa ?? double.MaxValue)
            .Select(CloneForUncertaintyReplay)
            .ToList();
    }

    // Wolff-de Wardt covariance must be replayed from the source history so its
    // non-persisted transfer matrix is continued instead of trusting stale results.
    private static SurveyStation CloneForUncertaintyReplay(SurveyStation station) => new()
    {
        Z = station.Z,
        Abscissa = station.Abscissa,
        Inclination = station.Inclination,
        Azimuth = station.Azimuth,
        MD = station.MD,
        X = station.X,
        Y = station.Y,
        TVD = station.TVD,
        RiemannianNorth = station.RiemannianNorth,
        RiemannianEast = station.RiemannianEast,
        Latitude = station.Latitude,
        Longitude = station.Longitude,
        Curvature = station.Curvature,
        Toolface = station.Toolface,
        BUR = station.BUR,
        TUR = station.TUR,
        VerticalSection = station.VerticalSection,
        Annotation = station.Annotation,
        SurveyTool = station.SurveyTool,
        BoreholeRadius = station.BoreholeRadius
    };

    private static List<SurveyPoint> FilterDisplayedPath(
        ICollection<SurveyPoint>? path,
        double? firstDisplayedMd) => path?
            .Where(point => !firstDisplayedMd.HasValue || !point.Abscissa.HasValue || point.Abscissa.Value >= firstDisplayedMd.Value)
            .ToList() ?? [];

    private RenderFragment EllipseCells(SurveyStationEllipse? ellipse, bool isHorizontal = false) => @<text>
        <MudTd>
            @if (ellipse?.SemiMajorAxis is double semiMajorAxis)
            {
                <MudSpanWithUnit QuantityName="PositionDrilling" SIValue="@semiMajorAxis" />
            }
        </MudTd>
        <MudTd>
            @if (ellipse?.SemiMinorAxis is double semiMinorAxis)
            {
                <MudSpanWithUnit QuantityName="PositionDrilling" SIValue="@semiMinorAxis" />
            }
        </MudTd>
        <MudTd>
            @if (ellipse?.OrientationAngle is double orientationAngle)
            {
                @if (isHorizontal)
                {
                    <MudSpanWithUnit QuantityName="PlaneAngleDrilling" DrillingSignalReference="DrillingSignalReferenceType.Azimuth" SIValue="@orientationAngle" />
                }
                else
                {
                    <MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@orientationAngle" />
                }
            }
        </MudTd>
    </text>;

    private RenderFragment PathTable(IReadOnlyCollection<SurveyPoint> path) => @<text>
        <MudTable Items="@path" T="SurveyPoint" Height="300px" FixedHeader="true"
                  Virtualize="true" OverscanCount="3" ItemSize="38"
                  Elevation="0" Hover="true" Dense="true" Bordered="true" ReadOnly="true">
            <HeaderContent>
                <MudTh>Measured Depth [@Parent?.GetDepthUnitLabel("DepthDrilling")]</MudTh>
                <MudTh>Inclination [@Parent?.GetUnitLabel("PlaneAngleDrilling")]</MudTh>
                <MudTh>Azimuth [@Parent?.GetAzimuthUnitLabel("PlaneAngleDrilling")]</MudTh>
                <MudTh>TVD [@Parent?.GetDepthUnitLabel("DepthDrilling")]</MudTh>
                <MudTh>North [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                <MudTh>East [@Parent?.GetUnitLabel("PositionDrilling")]</MudTh>
                <MudTh>Vertical Section [@Parent?.GetDepthUnitLabel("DepthDrilling")]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Measured Depth">
                    <MudSpanWithUnit QuantityName="DepthDrilling" DrillingSignalReference="@DrillingSignalReferenceType.Depth" SIValue="@context.Abscissa" />
                </MudTd>
                <MudTd DataLabel="Inclination">
                    <MudSpanWithUnit QuantityName="PlaneAngleDrilling" SIValue="@context.Inclination" />
                </MudTd>
                <MudTd DataLabel="Azimuth">
                    <MudSpanWithUnit QuantityName="PlaneAngleDrilling" DrillingSignalReference="@DrillingSignalReferenceType.Azimuth" SIValue="@context.Azimuth" />
                </MudTd>
                <MudTd DataLabel="TVD">
                    <MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.Z" />
                </MudTd>
                <MudTd DataLabel="North">
                    <MudSpanWithUnit QuantityName="PositionDrilling" SIValue="@context.X" />
                </MudTd>
                <MudTd DataLabel="East">
                    <MudSpanWithUnit QuantityName="PositionDrilling" SIValue="@context.Y" />
                </MudTd>
                <MudTd DataLabel="Vertical Section">
                    <MudSpanWithUnit QuantityName="DepthDrilling" SIValue="@context.VerticalSection" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </text>;
}


