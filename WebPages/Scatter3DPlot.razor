@implements IUnitAwareComponent
@implements IDisposable
@using System.Text
@inject IJSRuntime JSRuntime

<PlotlyChart Config="config" Layout="layout" Data="data" @ref="chart" />

@code {
    [CascadingParameter] private MudUnitAndReferenceChoiceTag Parent { get; set; }

    [Parameter] public string XUnit { get; set; }
    [Parameter] public string YUnit { get; set; }
    [Parameter] public string ZUnit { get; set; }

    [Parameter] public List<string> NameList { get; set; }
    [Parameter] public List<int> ModeFlagList { get; set; }   // 1=lines, 2=markers, 3=lines+markers
    [Parameter] public List<string> ColorList { get; set; }
    [Parameter] public List<int?>? MarkerSizeList { get; set; }
    [Parameter] public List<int?>? LineWidthList { get; set; }
    [Parameter] public List<bool>? ShowLegendList { get; set; }
    [Parameter] public bool ShowUnitCylinder { get; set; }
    [Parameter] public bool UseCubeAspect { get; set; }
    [Parameter] public double? CentralCurvatureMarker { get; set; }

    [Parameter] public List<List<object>> XValuesList { get; set; }
    [Parameter] public List<List<object>> YValuesList { get; set; }
    [Parameter] public List<List<object>> ZValuesList { get; set; }
    /// <summary>
    /// Fixed pixel height/width for the plot.
    /// Pass 0 (or omit) to let Plotly fill its container responsively.
    /// When Responsive=true in Config, a null height/width instructs Plotly to
    /// measure the parent element and use that height/width automatically.
    /// </summary>
    [Parameter] public int PlotHeight { get; set; }
    [Parameter] public int PlotWidth { get; set; }

    [Parameter] public string PlotTitle { get; set; }
    [Parameter] public string XAxisTitle { get; set; }
    [Parameter] public string YAxisTitle { get; set; }
    [Parameter] public string ZAxisTitle { get; set; }
    [Parameter] public bool ZAxisReversed { get; set; }
    [Parameter] public bool YAxisReversed { get; set; }
    [Parameter] public double? XAxisMinimum { get; set; }
    [Parameter] public double? XAxisMaximum { get; set; }
    [Parameter] public double? YAxisMinimum { get; set; }
    [Parameter] public double? YAxisMaximum { get; set; }
    [Parameter] public double? ZAxisMinimum { get; set; }
    [Parameter] public double? ZAxisMaximum { get; set; }
    [Parameter] public bool XAxisUsesPositionReference { get; set; }
    [Parameter] public bool YAxisUsesPositionReference { get; set; }
    [Parameter] public bool ZAxisUsesDepthReference { get; set; }
    [Parameter] public PositionDirectionType XAxisPositionDirection { get; set; } = PositionDirectionType.Independent;
    [Parameter] public PositionDirectionType YAxisPositionDirection { get; set; } = PositionDirectionType.Independent;
    [Parameter] public EventCallback<int> TraceClicked { get; set; }

    // ---- Helpers ----

    // Try to convert various numeric types to double for unit conversion and plotting, although common usage of ScatterPlot3D will pass double or double?
    static bool TryGetDouble(object v, out double d)
    {
        switch (v)
        {
            case double dd: d = dd; return double.IsFinite(d);
            case float ff: d = ff; return double.IsFinite(d);
            case decimal mm: d = (double)mm; return double.IsFinite(d);
            case int ii: d = ii; return true;
            default: d = default; return false; // case null when double? is passed, is handled here
        }
    }

    // Map from simple int mode flags to Plotly.Blazor's ModeFlag enum
    static Plotly.Blazor.Traces.Scatter3DLib.ModeFlag MapMode(int m) => m switch
    {
        1 => Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Lines,
        2 => Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Markers,
        3 => Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Lines | Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Markers,
        _ => Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Lines
    };

    // ---- State ----
    
    private PlotlyChart chart; // IMPORTANT: do not new() this chart as was the case in the pasr; @ref assigns it after render!
    private bool _plotlyReady;
    private bool _disposed;
    private readonly SemaphoreSlim _plotSemaphore = new(1, 1);
    private const string PlotlyUiRevision = "trajectory-scatter-3d-camera";
    private IJSObjectReference? _cameraPersistenceModule;
    private string? _cameraPersistenceChartId;
    private DotNetObjectReference<Scatter3DPlot>? _dotNetReference;
    private string? _lastPlotSignature;
    private bool _forceReplot = true;

    // Readonly properties for PlotlyChart. Traces are rebuilt in this list and applied with one React() call.
    private readonly IList<ITrace> data = new List<ITrace>(); // PlotlyChart uses this list; must be instantiated and not replaced to avoid breaking the reference from PlotlyChart.
    private readonly Config config = new() { Responsive = true };
    private readonly Layout layout = new()
    {
        Title = new Plotly.Blazor.LayoutLib.Title { Text = "" },
        Scene = new List<Scene>
        {
            new Scene
            {
                XAxis = new Plotly.Blazor.LayoutLib.SceneLib.XAxis
                {
                    Title = new Plotly.Blazor.LayoutLib.SceneLib.XAxisLib.Title { Text = "" }
                },
                YAxis = new Plotly.Blazor.LayoutLib.SceneLib.YAxis
                {
                    Title = new Plotly.Blazor.LayoutLib.SceneLib.YAxisLib.Title { Text = "" }
                },
                ZAxis = new Plotly.Blazor.LayoutLib.SceneLib.ZAxis
                {
                    Title = new Plotly.Blazor.LayoutLib.SceneLib.ZAxisLib.Title { Text = "" }
                }
            }
        }
    };

    
    // ---- Lifecycle ----

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Parent == null)
            throw new ArgumentNullException(nameof(Parent), "ScatterPlot3D must exist within a UnitAndReferenceChoiceTag");

        Parent.Add(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _plotlyReady = true;
            await PlotAsync(); // first safe render/update
            await EnsureCameraPersistenceAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Whenever parameters change, replot (but only after Plotly is ready)
        await PlotAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _ = DisposeCameraPersistenceAsync();
    }

    // ---- IUnitAwareComponent ----

    public void ManageUnits()
    {
        // Parent notifies unit changes; ensure we replot on UI thread
        _forceReplot = true;
        _ = InvokeAsync(async () => await PlotAsync());
    }

    // ---- Plot orchestration ----

    private async Task PlotAsync()
    {
        await _plotSemaphore.WaitAsync();
        try
        {
        if (_disposed) return;

        // Layout can be updated before ready; contrary to trace operations, which must wait for ready
        ManageLayout();

        if (!_plotlyReady || chart == null) return;

        string plotSignature = BuildPlotSignature();
        if (!_forceReplot && _lastPlotSignature == plotSignature) return;

        await ManageTracesAsync();

        // React() is usually the cleanest "apply everything" call if available in your Plotly.Blazor version.
        // If you do not have React(), remove this and keep Relayout/AddTrace usage.
        try
        {
            await chart.React();
        }
        catch
        {
            // Ignore if React() isn't available / throws during transient render states
        }
        await EnsureCameraPersistenceAsync();

        await InvokeAsync(StateHasChanged);
        _lastPlotSignature = plotSignature;
        _forceReplot = false;
        }
        finally
        {
            _plotSemaphore.Release();
        }
    }

    private async Task EnsureCameraPersistenceAsync()
    {
        if (_disposed || !_plotlyReady || chart?.Id == null)
        {
            return;
        }

        try
        {
            _cameraPersistenceModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/OSDC.Drilling.Trajectory.WebPages/scatter3dCameraPersistence.js?v=20260602-closest-approach");

            if (_cameraPersistenceChartId != chart.Id)
            {
                _cameraPersistenceChartId = chart.Id;
                _dotNetReference ??= DotNetObjectReference.Create(this);
                await _cameraPersistenceModule.InvokeVoidAsync("install", chart.Id, _dotNetReference);
            }
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task DisposeCameraPersistenceAsync()
    {
        if (_cameraPersistenceModule == null)
        {
            return;
        }

        try
        {
            if (!string.IsNullOrWhiteSpace(_cameraPersistenceChartId))
            {
                await _cameraPersistenceModule.InvokeVoidAsync("uninstall", _cameraPersistenceChartId);
            }

            await _cameraPersistenceModule.DisposeAsync();
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    [JSInvokable]
    public async Task OnPlotlyTraceClicked(int traceIndex)
    {
        if (_disposed || !TraceClicked.HasDelegate)
        {
            return;
        }

        await TraceClicked.InvokeAsync(traceIndex);
    }

    private Task ManageTracesAsync()
    {
        if (_disposed) return Task.CompletedTask;
        if (!_plotlyReady || chart == null) return Task.CompletedTask;

        if (XValuesList == null || YValuesList == null || ZValuesList == null) return Task.CompletedTask;
        if (!XValuesList.Any() || !YValuesList.Any() || !ZValuesList.Any()) return Task.CompletedTask;

        data.Clear();

        if (ShowUnitCylinder)
        {
            AddUnitCylinder();
        }

        int nTraces = new[] { XValuesList.Count, YValuesList.Count, ZValuesList.Count }.Min();

        for (int i = 0; i < nTraces; i++)
        {
            var xOut = new List<object>();
            var yOut = new List<object>();
            var zOut = new List<object>();

            foreach (var x in XValuesList[i])
                if (TryGetDouble(x, out var xd))
                {
                    double? X = XAxisUsesPositionReference
                        ? ConvertPositionForPlot(xd, XUnit, XAxisPositionDirection)
                        : Parent.FromSI((double?)xd, XUnit);
                    if (X is double converted && double.IsFinite(converted)) xOut.Add(converted);
                }

            foreach (var y in YValuesList[i])
                if (TryGetDouble(y, out var yd))
                {
                    double? Y = YAxisUsesPositionReference
                        ? ConvertPositionForPlot(yd, YUnit, YAxisPositionDirection)
                        : Parent.FromSI((double?)yd, YUnit);
                    if (Y is double converted && double.IsFinite(converted)) yOut.Add(converted);
                }

            foreach (var z in ZValuesList[i])
                if (TryGetDouble(z, out var zd))
                {
                    double? Z = ZAxisUsesDepthReference
                        ? ConvertDepthForPlot(zd, ZUnit)
                        : Parent.FromSI((double?)zd, ZUnit);
                    if (Z is double converted && double.IsFinite(converted)) zOut.Add(converted);
                }

            int n = xOut.Count;
            if (n == 0 || yOut.Count != n || zOut.Count != n) continue;

            string name = (NameList != null && i < NameList.Count) ? NameList[i] : $"trace_{i}";

            int modeInt = (ModeFlagList != null && i < ModeFlagList.Count) ? ModeFlagList[i] : 1;
            var mode = MapMode(modeInt);

            bool wantsMarkers = (mode & Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Markers) != 0;
            bool wantsLines = (mode & Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Lines) != 0;

            // Marker config only when markers requested
            Plotly.Blazor.Traces.Scatter3DLib.Marker? marker = null;
            if (wantsMarkers)
            {
                marker = (ColorList != null && i < ColorList.Count)
                    ? new Plotly.Blazor.Traces.Scatter3DLib.Marker { Color = ColorList[i] }
                    : new Plotly.Blazor.Traces.Scatter3DLib.Marker { AutoColorScale = true };
                if (MarkerSizeList != null && i < MarkerSizeList.Count && MarkerSizeList[i] is { } markerSize && markerSize > 0.0)
                {
                    marker.Size = (decimal)markerSize;
                }
            }

            // Line config only when lines requested
            Plotly.Blazor.Traces.Scatter3DLib.Line? line = null;
            if (wantsLines)
            {
                decimal lineWidth = LineWidthList != null && i < LineWidthList.Count && LineWidthList[i] is { } requestedWidth && requestedWidth > 0
                    ? requestedWidth
                    : 3;
                line = (ColorList != null && i < ColorList.Count)
                    ? new Plotly.Blazor.Traces.Scatter3DLib.Line { Color = ColorList[i], Width = lineWidth }
                    : new Plotly.Blazor.Traces.Scatter3DLib.Line { Width = lineWidth };
            }

            var trace = new Scatter3D
            {
                Name = name,
                Mode = mode,
                ShowLegend = ShowLegendList == null || i >= ShowLegendList.Count || ShowLegendList[i],
                X = xOut,
                Y = yOut,
                Z = zOut
            };

            if (wantsMarkers && marker != null) trace.Marker = marker;
            if (wantsLines && line != null) trace.Line = line;

            data.Add(trace);
        }

        return Task.CompletedTask;
    }

    private void AddUnitCylinder()
    {
        (double minimum, double maximum)? curvatureRange = UnitCylinderCurvatureRange();
        if (curvatureRange == null) return;
        (double minimum, double maximum) = curvatureRange.Value;

        const int angularSteps = 72;
        List<object> xRing = [];
        List<object> yRing = [];
        List<object> minimumRing = [];
        List<object> maximumRing = [];
        List<object> surfaceColor = [];
        for (int index = 0; index <= angularSteps; index++)
        {
            double toolface = 2.0 * Math.PI * index / angularSteps;
            xRing.Add(Math.Sin(toolface));
            yRing.Add(Math.Cos(toolface));
            minimumRing.Add(minimum);
            maximumRing.Add(maximum);
            surfaceColor.Add(0.0);
        }

        data.Add(new Surface
        {
            Name = "Normalized-length cylinder",
            ShowLegend = true,
            ShowScale = false,
            Opacity = 0.12m,
            ColorScale = "Greys",
            X = [xRing, xRing],
            Y = [yRing, yRing],
            Z = [minimumRing, maximumRing],
            SurfaceColor = [surfaceColor, surfaceColor]
        });

        data.Add(new Scatter3D
        {
            Name = "Curvature axis",
            Mode = Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Lines,
            ShowLegend = false,
            X = [(object)0.0, (object)0.0],
            Y = [(object)0.0, (object)0.0],
            Z = [(object)minimum, (object)maximum],
            Line = new Plotly.Blazor.Traces.Scatter3DLib.Line { Color = "#616161", Width = 4 }
        });

        double? displayedSourceCurvature = CentralCurvatureMarker is double sourceCurvature
            ? Parent.FromSI((double?)sourceCurvature, ZUnit)
            : null;
        if (displayedSourceCurvature is double markerCurvature && double.IsFinite(markerCurvature))
        {
            data.Add(new Scatter3D
            {
                Name = "Source terminal curvature",
                Mode = Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Markers,
                ShowLegend = true,
                X = [(object)0.0],
                Y = [(object)0.0],
                Z = [(object)markerCurvature],
                Marker = new Plotly.Blazor.Traces.Scatter3DLib.Marker { Color = "#212121", Size = 6 }
            });
        }

        string angleUnit = Parent.GetUnitLabel("PlaneAngleDrilling") ?? string.Empty;
        for (int index = 0; index < 4; index++)
        {
            double toolface = 0.5 * Math.PI * index;
            double displayed = Parent.FromSI((double?)toolface, "PlaneAngleDrilling") ?? toolface;
            string label = index == 0
                ? $"{displayed:G3}/{(Parent.FromSI((double?)(2.0 * Math.PI), "PlaneAngleDrilling") ?? 2.0 * Math.PI):G3} {angleUnit}"
                : $"{displayed:G3} {angleUnit}";
            data.Add(new Scatter3D
            {
                Name = "Toolface scale",
                Mode = Plotly.Blazor.Traces.Scatter3DLib.ModeFlag.Text,
                ShowLegend = false,
                Text = label,
                X = [(object)(1.08 * Math.Sin(toolface))],
                Y = [(object)(1.08 * Math.Cos(toolface))],
                Z = [(object)minimum]
            });
        }
    }

    private void ManageLayout()
    {
        if (layout == null || Parent == null) return;

        // Tighten the margins so the 3D scene fills the available canvas
        layout.Margin = new Plotly.Blazor.LayoutLib.Margin
        {
            L = 0,
            R = 0,
            T = 30,  // small top margin to leave room for the title
            B = 0
        };

        string xUnitLabel = XAxisUsesPositionReference ? Parent.GetPositionUnitLabel(XUnit) : Parent.GetUnitLabel(XUnit);
        string yUnitLabel = YAxisUsesPositionReference ? Parent.GetPositionUnitLabel(YUnit) : Parent.GetUnitLabel(YUnit);
        string zUnitLabel = ZAxisUsesDepthReference ? Parent.GetDepthUnitLabel(ZUnit) : Parent.GetUnitLabel(ZUnit);

        xUnitLabel = xUnitLabel != null ? $" ({xUnitLabel})" : "";
        yUnitLabel = yUnitLabel != null ? $" ({yUnitLabel})" : "";
        zUnitLabel = zUnitLabel != null ? $" ({zUnitLabel})" : "";

        // PlotWidth/Height == 0 means "fill container": pass null so that Plotly, combined
        // with Responsive=true, measures the parent element height/width at render time.
        // A non-zero value pins the chart to that exact pixel height/width.
        layout.Height = PlotHeight > 0 ? PlotHeight : null;
        layout.Width = PlotWidth > 0 ? PlotWidth : null;
        layout.Title.Text = PlotTitle ?? "";
        layout.UiRevision = PlotlyUiRevision;

        for (int i = 0; i < layout.Scene.Count; ++i)
        {
            var scene = layout.Scene[i];
            scene.UiRevision = PlotlyUiRevision;
            // setting the scene domain to cover the full canvas
            scene.Domain = new Plotly.Blazor.LayoutLib.SceneLib.Domain
            {
                X = new List<object> { 0, 1 },
                Y = new List<object> { 0, 1 }
            };
            // Curvature is numerically much smaller than the unit radius; use a cube so the
            // cylinder remains legible while axis labels retain the converted engineering values.
            scene.AspectMode = ShowUnitCylinder || UseCubeAspect
                ? Plotly.Blazor.LayoutLib.SceneLib.AspectModeEnum.Cube
                : Plotly.Blazor.LayoutLib.SceneLib.AspectModeEnum.Data;

            scene.XAxis.Title.Text = ShowUnitCylinder ? "" : (XAxisTitle ?? "") + xUnitLabel;
            ApplyXAxisRange(scene, ConvertXAxisBound(XAxisMinimum), ConvertXAxisBound(XAxisMaximum));
            scene.XAxis.RangeMode = Plotly.Blazor.LayoutLib.SceneLib.XAxisLib.RangeModeEnum.Normal;

            scene.YAxis.Title.Text = ShowUnitCylinder ? "" : (YAxisTitle ?? "") + yUnitLabel;
            scene.YAxis.RangeMode = Plotly.Blazor.LayoutLib.SceneLib.YAxisLib.RangeModeEnum.Normal;
            ApplyYAxisRange(scene, ConvertYAxisBound(YAxisMinimum), ConvertYAxisBound(YAxisMaximum));

            scene.ZAxis.Title.Text = (ZAxisTitle ?? "") + zUnitLabel;
            scene.ZAxis.RangeMode = Plotly.Blazor.LayoutLib.SceneLib.ZAxisLib.RangeModeEnum.Normal;
            (double minimum, double maximum)? cylinderRange = ShowUnitCylinder ? UnitCylinderCurvatureRange() : null;
            ApplyZAxisRange(scene,
                cylinderRange?.minimum ?? ConvertZAxisBound(ZAxisMinimum),
                cylinderRange?.maximum ?? ConvertZAxisBound(ZAxisMaximum));
        }
    }

    private (double minimum, double maximum)? UnitCylinderCurvatureRange()
    {
        List<double> convertedCurvatures = ZValuesList
            .SelectMany(values => values)
            .Select(value => TryGetDouble(value, out double siValue) ? Parent.FromSI((double?)siValue, ZUnit) : null)
            .OfType<double>()
            .Where(double.IsFinite)
            .ToList();
        if (CentralCurvatureMarker is double sourceCurvature &&
            Parent.FromSI((double?)sourceCurvature, ZUnit) is double displayedSourceCurvature &&
            double.IsFinite(displayedSourceCurvature))
            convertedCurvatures.Add(displayedSourceCurvature);
        if (convertedCurvatures.Count == 0) return null;

        double maximum = Math.Max(0.0, convertedCurvatures.Max()) * 1.2;
        return (0.0, Math.Max(maximum, 1e-6));
    }

    private void ApplyXAxisRange(Scene scene, double? minimum, double? maximum)
    {
        if (minimum.HasValue && maximum.HasValue && minimum.Value < maximum.Value)
        {
            scene.XAxis.AutoRange = Plotly.Blazor.LayoutLib.SceneLib.XAxisLib.AutoRangeEnum.False;
            scene.XAxis.Range = [minimum.Value, maximum.Value];
            return;
        }

        scene.XAxis.AutoRange = Plotly.Blazor.LayoutLib.SceneLib.XAxisLib.AutoRangeEnum.True;
        scene.XAxis.Range = null;
    }

    private void ApplyYAxisRange(Scene scene, double? minimum, double? maximum)
    {
        if (minimum.HasValue && maximum.HasValue && minimum.Value < maximum.Value)
        {
            scene.YAxis.AutoRange = Plotly.Blazor.LayoutLib.SceneLib.YAxisLib.AutoRangeEnum.False;
            scene.YAxis.Range = YAxisReversed ? [maximum.Value, minimum.Value] : [minimum.Value, maximum.Value];
            return;
        }

        scene.YAxis.AutoRange = YAxisReversed
            ? Plotly.Blazor.LayoutLib.SceneLib.YAxisLib.AutoRangeEnum.Reversed
            : Plotly.Blazor.LayoutLib.SceneLib.YAxisLib.AutoRangeEnum.True;
        scene.YAxis.Range = null;
    }

    private void ApplyZAxisRange(Scene scene, double? minimum, double? maximum)
    {
        if (minimum.HasValue && maximum.HasValue && minimum.Value < maximum.Value)
        {
            scene.ZAxis.AutoRange = Plotly.Blazor.LayoutLib.SceneLib.ZAxisLib.AutoRangeEnum.False;
            scene.ZAxis.Range = ZAxisReversed ? [maximum.Value, minimum.Value] : [minimum.Value, maximum.Value];
            return;
        }

        scene.ZAxis.AutoRange = ZAxisReversed
            ? Plotly.Blazor.LayoutLib.SceneLib.ZAxisLib.AutoRangeEnum.Reversed
            : Plotly.Blazor.LayoutLib.SceneLib.ZAxisLib.AutoRangeEnum.True;
        scene.ZAxis.Range = null;
    }

    private string BuildPlotSignature()
    {
        StringBuilder builder = new();
        builder.Append(XUnit).Append('|')
            .Append(YUnit).Append('|')
            .Append(ZUnit).Append('|')
            .Append(XAxisTitle).Append('|')
            .Append(YAxisTitle).Append('|')
            .Append(ZAxisTitle).Append('|')
            .Append(PlotTitle).Append('|')
            .Append(YAxisReversed).Append('|')
            .Append(ZAxisReversed).Append('|')
            .Append(XAxisMinimum).Append('|')
            .Append(XAxisMaximum).Append('|')
            .Append(YAxisMinimum).Append('|')
            .Append(YAxisMaximum).Append('|')
            .Append(ZAxisMinimum).Append('|')
            .Append(ZAxisMaximum).Append('|')
            .Append(XAxisUsesPositionReference).Append('|')
            .Append(YAxisUsesPositionReference).Append('|')
            .Append(ZAxisUsesDepthReference).Append('|')
            .Append(ShowUnitCylinder).Append('|')
            .Append(UseCubeAspect).Append('|')
            .Append(CentralCurvatureMarker).Append('|')
            .Append(XAxisPositionDirection).Append('|')
            .Append(YAxisPositionDirection).Append('|');

        AppendListSignature(builder, NameList);
        AppendListSignature(builder, ModeFlagList);
        AppendListSignature(builder, ColorList);
        AppendListSignature(builder, MarkerSizeList);
        AppendListSignature(builder, LineWidthList);
        AppendListSignature(builder, ShowLegendList);
        AppendNestedListSignature(builder, XValuesList);
        AppendNestedListSignature(builder, YValuesList);
        AppendNestedListSignature(builder, ZValuesList);

        return builder.ToString();
    }

    private static void AppendListSignature<T>(StringBuilder builder, List<T>? values)
    {
        if (values == null)
        {
            builder.Append("null|");
            return;
        }

        builder.Append(values.Count).Append('|');
        foreach (T? value in values)
        {
            builder.Append(value).Append(';');
        }
        builder.Append('|');
    }

    private static void AppendNestedListSignature(StringBuilder builder, List<List<object>>? values)
    {
        if (values == null)
        {
            builder.Append("null|");
            return;
        }

        builder.Append(values.Count).Append('|');
        foreach (List<object> list in values)
        {
            builder.Append(list.Count).Append(':');
            foreach (object? value in list)
            {
                builder.Append(value).Append(',');
            }
            builder.Append(';');
        }
        builder.Append('|');
    }

    private double? ConvertDepthForPlot(double value, string quantityName)
    {
        string? converted = Parent.FromWGS84DepthSI(value, quantityName, false);
        if (string.IsNullOrWhiteSpace(converted))
        {
            return null;
        }

        if (double.TryParse(converted, out double parsed))
        {
            return double.IsFinite(parsed) ? parsed : null;
        }

        if (double.TryParse(converted, System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowThousands, System.Globalization.CultureInfo.InvariantCulture, out parsed))
        {
            return double.IsFinite(parsed) ? parsed : null;
        }

        return null;
    }

    private double? ConvertPositionForPlot(double value, string quantityName, PositionDirectionType direction)
    {
        if (direction == PositionDirectionType.Independent)
        {
            return null;
        }

        double converted = Parent.FromWGS84PositionSI(value, quantityName, direction);
        return double.IsFinite(converted) ? converted : null;
    }

    private double? ConvertXAxisBound(double? value) => !value.HasValue
        ? null
        : XAxisUsesPositionReference
            ? ConvertPositionForPlot(value.Value, XUnit, XAxisPositionDirection)
            : FiniteOrNull(Parent.FromSI(value.Value, XUnit));

    private double? ConvertYAxisBound(double? value) => !value.HasValue
        ? null
        : YAxisUsesPositionReference
            ? ConvertPositionForPlot(value.Value, YUnit, YAxisPositionDirection)
            : FiniteOrNull(Parent.FromSI(value.Value, YUnit));

    private double? ConvertZAxisBound(double? value) => !value.HasValue
        ? null
        : ZAxisUsesDepthReference
            ? ConvertDepthForPlot(value.Value, ZUnit)
            : FiniteOrNull(Parent.FromSI(value.Value, ZUnit));

    private static double? FiniteOrNull(double? value) =>
        value is double number && double.IsFinite(number) ? number : null;
}
