{
  "openapi": "3.0.4",
  "info": {
    "title": "OSDC Earth Magnetic Field API",
    "description": "Stateless WMM2025 and IGRF14 evaluation using UTC, WGS84 SI coordinates, and north-east-down magnetic flux density in teslas.",
    "version": "v1"
  },
  "paths": {
    "/EarthMagneticField": {
      "get": {
        "tags": [
          "EarthMagneticField"
        ],
        "summary": "Returns installed model information and public conventions for service discovery.",
        "operationId": "GetEarthMagneticFieldEntry",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EarthMagneticFieldServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthMagneticField/Evaluate": {
      "post": {
        "tags": [
          "EarthMagneticField"
        ],
        "summary": "Synchronously evaluates WMM2025 or IGRF14 at a batch of WGS84 positions and UTC instants.",
        "description": "This operation is stateless. Latitude/longitude use SI radians, depth is metres positive downward from WGS84, UTC is mandatory, and results use north-east-down teslas with angles in radians. One invalid sample rejects the complete request.",
        "operationId": "EvaluateEarthMagneticField",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EvaluateEarthMagneticFieldRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EvaluateEarthMagneticFieldRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EvaluateEarthMagneticFieldRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EvaluateEarthMagneticFieldResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EarthMagneticFieldValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/EarthMagneticField/ModelInfo": {
      "get": {
        "tags": [
          "EarthMagneticField"
        ],
        "summary": "Returns WMM2025 and IGRF14 identities, validity bounds, conventions, and coefficient hashes.",
        "operationId": "GetEarthMagneticFieldModelInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.EarthMagneticFieldServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthMagneticFieldUsageStatistics": {
      "get": {
        "tags": [
          "EarthMagneticFieldUsageStatistics"
        ],
        "summary": "Returns cumulative usage counters persisted by this service. This operation is intentionally not exposed as an MCP tool.",
        "operationId": "GetEarthMagneticFieldUsageStatistics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthMagneticField.Model.UsageStatisticsEarthMagneticField"
                }
              }
            }
          }
        }
      }
    }
  },
